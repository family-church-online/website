{
	// Cloudflare config — only read when deploying to Cloudflare Pages/Workers;
	// other hosts ignore this file. `nodejs_compat` exposes `node:async_hooks`,
	// which the Tina visual-editing island route (AsyncLocalStorage) needs.
	"name": "family-church-website",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
	"vars": {
		"SESSION_SECRET": "",
		"PCO_CLIENT_ID": "",
		"PCO_REDIRECT_URI": "",
		"PCO_CLIENT_SECRET": "",
		"PCO_APP_TOKEN": "",
		"PCO_APP_SECRET": "",
		"PCO_TRACKED_LIST_IDS": ""
	},
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"redact_query_string": false,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}
