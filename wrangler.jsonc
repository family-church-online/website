{
	// Cloudflare config — only read when deploying to Cloudflare Pages/Workers;
	// other hosts ignore this file. `nodejs_compat` exposes `node:async_hooks`,
	// which the Tina visual-editing island route (AsyncLocalStorage) needs.
	"name": "tina-astro-starter",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"redact_query_string": false,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}
