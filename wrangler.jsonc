{
	// Cloudflare Pages config — used by `wrangler pages deploy`.
	// The site builds to static HTML (dist/); the functions/ directory provides
	// dynamic routes (auth, today redirect) and the _middleware.ts auth gate.
	"name": "family-church-website",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	"pages_build_output_dir": "dist"
}
