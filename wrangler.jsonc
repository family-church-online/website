{
	// Cloudflare config — only read when deploying to Cloudflare Pages/Workers;
	// other hosts ignore this file. `nodejs_compat` exposes `node:async_hooks`,
	// which the Tina visual-editing island route (AsyncLocalStorage) needs.
	"name": "family-church-website",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
	"keep_vars": true,
	"kv_namespaces": [
		{
			// Run: npx wrangler kv namespace create LESSON_PROGRESS
			// then paste the returned id here (and the preview_id for dev).
			"binding": "LESSON_PROGRESS",
			"id": "REPLACE_WITH_KV_NAMESPACE_ID"
		}
	],
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": false,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}
