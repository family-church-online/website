SITE_URL=https://example.com
PUBLIC_TINA_CLIENT_ID=*** #Grab from TinaCloud app.tina.io
TINA_TOKEN=*** #Grab from TinaCloud app.tina.io

# Planning Center OAuth (from api.planningcenteronline.com/oauth/applications)
# Redirect URI to register: {SITE_URL}/auth/callback
PC_CLIENT_ID=
PC_CLIENT_SECRET=

# Session signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional. Hosting platforms are auto-detected (Vercel, Cloudflare Pages, Netlify → Node).
# Set this only to force an adapter for a local/manual non-Pages deploy.
# DEPLOY_ADAPTER=cloudflare  # vercel | cloudflare | netlify | node
