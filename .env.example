SITE_URL=https://example.com
PUBLIC_TINA_CLIENT_ID=*** #Grab from TinaCloud app.tina.io
TINA_TOKEN=*** #Grab from TinaCloud app.tina.io

# Optional. Hosting platforms are auto-detected (Vercel, Cloudflare, Netlify → Node).
# Set this only to force an adapter for a local/manual deploy, e.g. `wrangler deploy`.
# DEPLOY_ADAPTER=cloudflare  # vercel | cloudflare | netlify | node

# ── Auth (Planning Center magic link) ─────────────────────────────────────────
# Personal Access Token — generated from your PCO account (admin level).
# Used server-side to look up people by email and check list membership.
# Generate at: https://api.planningcenteronline.com/oauth/applications (Personal Access Tokens tab)
PCO_APP_TOKEN=
PCO_APP_SECRET=

# Comma-separated PCO list IDs your site uses across all protected areas.
# At login, the server checks which of these lists the user belongs to and
# stores the result in their session. Add every list ID you reference in
# requireAuth() calls or course requiredListId fields.
PCO_TRACKED_LIST_IDS=

# 64-character random hex string — used to sign session cookies and magic link tokens.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Resend API key — used to send magic link emails.
# Create an account and API key at resend.com. Your SITE_URL domain must be verified there.
RESEND_API_KEY=

# ── Sermon Pipeline (Cloudflare Worker secrets) ────────────────────────────────
# Random secret shared between the local CLI and the Worker POST /api/sermon/jobs endpoint.
# Generate with: openssl rand -hex 32
SERMON_PIPELINE_SECRET=

# Email address to notify when a sermon is ready for review / after publish.
SERMON_NOTIFY_EMAIL=

# Anthropic API key — used by SermonProcessWorkflow for Claude calls.
ANTHROPIC_API_KEY=

# Voyage AI key — used for search embeddings (optional; skipped if not set).
VOYAGE_API_KEY=

# Neon connection string — used to store search embeddings (optional; skipped if not set).
DATABASE_URL=

# GitHub Personal Access Token — used by SermonPublishWorkflow to commit MDX files.
# Needs repo scope (read + write contents).
GITHUB_TOKEN=

# Google Service Account credentials JSON (single-line stringified) — used for
# Google Calendar (devotions) and Google Drive uploads.
# Create a service account in Google Cloud Console, download the JSON key, and
# share the target calendars/folders with the service account email.
GOOGLE_SERVICE_ACCOUNT=

# Sermon pipeline (local CLI only — NOT needed in the Worker):
VIMEO_TOKEN=
DEEPGRAM_API_KEY=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=family-church-sermons
R2_AUDIO_PUBLIC_URL=https://audio.familychurch.online
