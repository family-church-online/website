SITE_URL=https://example.com
PUBLIC_TINA_CLIENT_ID=*** #Grab from TinaCloud app.tina.io
TINA_TOKEN=*** #Grab from TinaCloud app.tina.io

# Optional. Hosting platforms are auto-detected (Vercel, Cloudflare, Netlify → Node).
# Set this only to force an adapter for a local/manual deploy, e.g. `wrangler deploy`.
# DEPLOY_ADAPTER=cloudflare  # vercel | cloudflare | netlify | node

# ── Auth (Planning Center OAuth) ──────────────────────────────────────────────
# Create an OAuth app at https://api.planningcenteronline.com/oauth/applications
PCO_CLIENT_ID=
PCO_CLIENT_SECRET=
# Full URL of the callback route — must match exactly what you registered in PCO
# Dev:  http://localhost:4321/api/auth/callback
# Prod: https://yourdomain.com/api/auth/callback
PCO_REDIRECT_URI=

# Personal Access Token — generated from your PCO account (admin level).
# Used server-side to check list membership. Never exposed to the browser.
# Generate at: https://api.planningcenteronline.com/oauth/applications (Personal Access Tokens tab)
PCO_APP_TOKEN=
PCO_APP_SECRET=

# Comma-separated PCO list IDs your site uses across all protected areas.
# At login, the server checks which of these lists the user belongs to and
# stores the result in their session. Add every list ID you reference in
# requireAuth() calls or course requiredListId fields.
PCO_TRACKED_LIST_IDS=

# 64-character random hex string — used to sign session cookies.
# Generate with: openssl rand -hex 32
SESSION_SECRET=
