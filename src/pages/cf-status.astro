					<p class="text-[10px] text-[var(--ink)]/30 dark:text-white/25">10M req/month · 30M CPU ms/month · 6k build min/month</p>
				</div>
			</div>

			{/* ── Workers KV ──────────────────────────────────────────────────── */}
