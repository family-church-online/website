---
export const prerender = false;

import Base from '../layouts/Base.astro';
import { requireAuth } from '../lib/auth';
import { getConfig } from '../lib/data';
import { env } from 'cloudflare:workers';

const siteConfig = await getConfig();
const adminListId = (siteConfig.data?.config?.auth as Record<string, unknown> | null | undefined)?.adminListId as string | undefined;
const auth = requireAuth(Astro, adminListId);
if (auth instanceof Response) return auth;

// ── CF API credentials ──────────────────────────────────────────────────────
// Add CF_ACCOUNT_ID and CF_API_TOKEN as Cloudflare dashboard Variables.
// Token needs Account Analytics → Read permission.
const cfAccountId = process.env['CF_ACCOUNT_ID'] ?? null;
const cfApiToken  = process.env['CF_API_TOKEN'] ?? null;
const hasApi = !!(cfAccountId && cfApiToken);

const KV_NS = {
	LESSON_PROGRESS: '56984b88d58641dbb252b1e40fd897da',
	SERMON_JOBS:     '11aeec1bb02e4e68add35e292ae0e3fb',
};

// ── KV helpers ──────────────────────────────────────────────────────────────

function getKV(binding: keyof CloudflareEnv): KVNamespace | null {
	try { return (env as unknown as CloudflareEnv)[binding] as KVNamespace ?? null; }
	catch { return null; }
}

async function countKVKeys(kv: KVNamespace | null): Promise<number | null> {
	if (!kv) return null;
	let count = 0, cursor: string | undefined;
	do {
		const result = await kv.list({ limit: 1000, ...(cursor ? { cursor } : {}) });
		count += result.keys.length;
		cursor = result.list_complete ? undefined : (result.cursor || undefined);
	} while (cursor);
	return count;
}

// ── GraphQL helper ───────────────────────────────────────────────────────────

async function gql<T>(query: string): Promise<T | null> {
	if (!hasApi) return null;
	try {
		const res = await fetch('https://api.cloudflare.com/client/v4/graphql', {
			method: 'POST',
			headers: { Authorization: `Bearer ${cfApiToken}`, 'Content-Type': 'application/json' },
			body: JSON.stringify({ query }),
		});
		if (!res.ok) return null;
		const json = await res.json() as { data?: T; errors?: unknown[] };
		if (json.errors?.length) return null;
		return (json.data ?? null) as T;
	} catch { return null; }
}

// ── Date ranges (calendar month, UTC) ────────────────────────────────────────

const now = new Date();
const monthStart = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), 1));
const mDT  = monthStart.toISOString();
const mD   = mDT.slice(0, 10);
const nowDT = now.toISOString();
const nowD  = nowDT.slice(0, 10);

// ── Query 1: Workers + KV ────────────────────────────────────────────────────

interface WRow { sum: { requests: number; errors: number }; quantiles: { cpuTimeP50: number; cpuTimeP99: number } }
interface KVRow { dimensions: { actionType: string; namespaceId: string }; sum: { requests: number } }

async function qWorkersKV() {
	type R = { viewer: { accounts: [{ workersInvocationsAdaptive: WRow[]; kvOperationsAdaptiveGroups: KVRow[] }] } };
	const d = await gql<R>(`{
    viewer {
      accounts(filter:{accountTag:"${cfAccountId}"}) {
        workersInvocationsAdaptive(limit:10000,filter:{
          datetime_geq:"${mDT}",datetime_leq:"${nowDT}"
        }) { sum{requests errors} quantiles{cpuTimeP50 cpuTimeP99} }
        kvOperationsAdaptiveGroups(limit:10000,filter:{
          date_geq:"${mD}",date_leq:"${nowD}"
        }) { dimensions{actionType namespaceId} sum{requests} }
      }
    }
  }`);
	if (!d) return { workers: null as null | { requests: number; errors: number; cpuP50ms: number; cpuP99ms: number }, kv: null as null | { reads: number; writes: number; lists: number; byNS: Record<string, { reads: number; writes: number; lists: number }> } };
	const acc = d.viewer.accounts[0];

	let req = 0, err = 0, cpuP50 = 0, cpuP99 = 0;
	for (const r of acc.workersInvocationsAdaptive ?? []) {
		req += r.sum.requests; err += r.sum.errors;
		cpuP50 = Math.max(cpuP50, r.quantiles.cpuTimeP50);
		cpuP99 = Math.max(cpuP99, r.quantiles.cpuTimeP99);
	}
	const workers = { requests: req, errors: err, cpuP50ms: cpuP50 / 1000, cpuP99ms: cpuP99 / 1000 };

	const kv = { reads: 0, writes: 0, lists: 0, byNS: {} as Record<string, { reads: number; writes: number; lists: number }> };
	for (const r of acc.kvOperationsAdaptiveGroups ?? []) {
		const { actionType: at, namespaceId: ns } = r.dimensions;
		const n = r.sum.requests;
		if (!kv.byNS[ns]) kv.byNS[ns] = { reads: 0, writes: 0, lists: 0 };
		if (at === 'read')       { kv.reads  += n; kv.byNS[ns].reads  += n; }
		else if (at === 'write') { kv.writes += n; kv.byNS[ns].writes += n; }
		else if (at === 'list')  { kv.lists  += n; kv.byNS[ns].lists  += n; }
	}
	return { workers, kv };
}

// ── Query 2: R2 ──────────────────────────────────────────────────────────────

const CLASS_B_OPS = new Set(['GetObject', 'HeadObject', 'HeadBucket']);

async function qR2() {
	type R = { viewer: { accounts: [{ r2StorageAdaptiveGroups: Array<{ max: { payloadSize: number } }>; r2OperationsAdaptiveGroups: Array<{ dimensions: { actionType: string }; sum: { requests: number } }> }] } };
	const d = await gql<R>(`{
    viewer {
      accounts(filter:{accountTag:"${cfAccountId}"}) {
        r2StorageAdaptiveGroups(limit:1,orderBy:[date_DESC],filter:{
          date_geq:"${mD}",date_leq:"${nowD}"
        }) { max{payloadSize} }
        r2OperationsAdaptiveGroups(limit:10000,filter:{
          date_geq:"${mD}",date_leq:"${nowD}"
        }) { dimensions{actionType} sum{requests} }
      }
    }
  }`);
	if (!d) return null;
	const acc = d.viewer.accounts[0];
	const storageBytes = acc.r2StorageAdaptiveGroups?.[0]?.max?.payloadSize ?? null;
	let classA = 0, classB = 0;
	for (const r of acc.r2OperationsAdaptiveGroups ?? []) {
		if (CLASS_B_OPS.has(r.dimensions.actionType)) classB += r.sum.requests;
		else classA += r.sum.requests;
	}
	return { storageBytes, classAOps: classA, classBOps: classB };
}

// ── Query 3: DO + D1 (known-good field names from CF docs) ───────────────────

async function qDOD1() {
	type R = { viewer: { accounts: [{
		durableObjectsInvocationsAdaptiveGroups: Array<{ sum: { requests: number } }>;
		durableObjectsPeriodicGroups:           Array<{ sum: { cpuTime: number } }>;
		durableObjectsStorageGroups:            Array<{ max: { storedBytes: number } }>;
		d1AnalyticsAdaptiveGroups:              Array<{ sum: { rowsRead: number; rowsWritten: number } }>;
	}] } };
	const d = await gql<R>(`{
    viewer {
      accounts(filter:{accountTag:"${cfAccountId}"}) {
        durableObjectsInvocationsAdaptiveGroups(limit:10000,filter:{
          date_geq:"${mD}",date_leq:"${nowD}"
        }) { sum{requests} }
        durableObjectsPeriodicGroups(limit:10000,filter:{
          date_geq:"${mD}",date_leq:"${nowD}"
        }) { sum{cpuTime} }
        durableObjectsStorageGroups(limit:1,orderBy:[date_DESC],filter:{
          date_geq:"${mD}",date_leq:"${nowD}"
        }) { max{storedBytes} }
        d1AnalyticsAdaptiveGroups(limit:10000,filter:{
          date_geq:"${mD}",date_leq:"${nowD}"
        }) { sum{rowsRead rowsWritten} }
      }
    }
  }`);
	if (!d) return { doReqs: null as number | null, doCpuTimeUs: null as number | null, doStorageBytes: null as number | null, d1Reads: null as number | null };
	const acc = d.viewer.accounts[0];
	const doReqs        = (acc.durableObjectsInvocationsAdaptiveGroups ?? []).reduce((s, r) => s + r.sum.requests, 0);
	const doCpuTimeUs   = (acc.durableObjectsPeriodicGroups ?? []).reduce((s, r) => s + r.sum.cpuTime, 0);
	const doStorageBytes = acc.durableObjectsStorageGroups?.[0]?.max?.storedBytes ?? 0;
	const d1Reads       = (acc.d1AnalyticsAdaptiveGroups ?? []).reduce((s, r) => s + r.sum.rowsRead, 0);
	return { doReqs, doCpuTimeUs, doStorageBytes, d1Reads };
}

// ── Query 4: Build minutes (field name is a best guess — isolated) ────────────

async function qBuildMinutes() {
	type R = { viewer: { accounts: [{ workersBuildsBuildMinutesAdaptiveGroups: Array<{ sum: { buildMinutes: number } }> }] } };
	const d = await gql<R>(`{
    viewer {
      accounts(filter:{accountTag:"${cfAccountId}"}) {
        workersBuildsBuildMinutesAdaptiveGroups(limit:10000,filter:{
          date_geq:"${mD}",date_leq:"${nowD}"
        }) { sum{buildMinutes} }
      }
    }
  }`);
	if (!d) return null;
	return (d.viewer.accounts[0]?.workersBuildsBuildMinutesAdaptiveGroups ?? []).reduce((s, r) => s + r.sum.buildMinutes, 0);
}

// ── Query 5: Vectorize (field name is a best guess — isolated) ───────────────

async function qVectorize() {
	type R = { viewer: { accounts: [{ vectorizeV2StorageAdaptiveGroups: Array<{ max: { storedDimensions: number } }> }] } };
	const d = await gql<R>(`{
    viewer {
      accounts(filter:{accountTag:"${cfAccountId}"}) {
        vectorizeV2StorageAdaptiveGroups(limit:1,orderBy:[date_DESC],filter:{
          date_geq:"${mD}",date_leq:"${nowD}"
        }) { max{storedDimensions} }
      }
    }
  }`);
	if (!d) return null;
	return d.viewer.accounts[0]?.vectorizeV2StorageAdaptiveGroups?.[0]?.max?.storedDimensions ?? 0;
}

// ── Fetch everything in parallel ─────────────────────────────────────────────

const [wkvData, r2Data, dod1Data, buildMins, vectorizeDims, lessonKeys, sermonJobKeys] = await Promise.all([
	qWorkersKV(),
	qR2(),
	qDOD1(),
	qBuildMinutes(),
	qVectorize(),
	countKVKeys(getKV('LESSON_PROGRESS')),
	countKVKeys(getKV('SERMON_JOBS')),
]);

const workersStats   = wkvData.workers;
const kvStats        = wkvData.kv;
const r2Stats        = r2Data;
const doReqs         = dod1Data.doReqs;
// DO compute duration: cpuTime in µs × 0.128 GB (128 MB per DO) = GB·S
const doGBSeconds    = dod1Data.doCpuTimeUs != null ? (dod1Data.doCpuTimeUs / 1_000_000) * 0.128 : null;
const doStorageBytes = dod1Data.doStorageBytes;
const d1Reads        = dod1Data.d1Reads;

// ── Display helpers ───────────────────────────────────────────────────────────

function pct(used: number | null | undefined, limit: number): number {
	if (used == null) return 0;
	return Math.min(100, (used / limit) * 100);
}

function barColor(used: number | null | undefined, limit: number): string {
	const p = used == null ? -1 : (used / limit) * 100;
	if (p < 0)   return 'bg-[var(--navy)]/15 dark:bg-white/10';
	if (p >= 90) return 'bg-[var(--red)]';
	if (p >= 70) return 'bg-yellow-400';
	return 'bg-[var(--green)]';
}

function statusDot(used: number | null | undefined, limit: number): string {
	if (used == null) return 'bg-[var(--navy)]/20 dark:bg-white/15';
	const p = (used / limit) * 100;
	if (p >= 90) return 'bg-[var(--red)]';
	if (p >= 70) return 'bg-yellow-400';
	return 'bg-[var(--green)]';
}

function fmt(n: number | null | undefined): string {
	if (n == null) return '—';
	if (n >= 1_000_000_000) return `${(n / 1_000_000_000).toFixed(2)}B`;
	if (n >= 1_000_000)     return `${(n / 1_000_000).toFixed(2)}M`;
	if (n >= 1_000)         return `${(n / 1_000).toFixed(1)}k`;
	return String(n);
}

function fmtGB(bytes: number | null | undefined): string {
	if (bytes == null) return '—';
	const gb = bytes / 1_073_741_824;
	if (gb >= 1) return `${gb.toFixed(2)} GB`;
	const mb = bytes / 1_048_576;
	if (mb >= 1) return `${mb.toFixed(0)} MB`;
	return `${(bytes / 1024).toFixed(0)} KB`;
}

function fmtMs(ms: number | null | undefined): string {
	if (ms == null) return '—';
	return `${ms.toFixed(2)} ms`;
}

const cfDash = 'https://dash.cloudflare.com';

const month = monthStart.toLocaleDateString('en-ZA', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const refreshed = now.toLocaleTimeString('en-ZA', {
	timeZone: 'Africa/Johannesburg',
	hour: '2-digit', minute: '2-digit', second: '2-digit',
});
---

<Base title="Cloudflare Status" description="Cloudflare service usage and free tier limits" noindex={true}>

	<div class="max-w-2xl mx-auto px-4 sm:px-6 pt-10 pb-24">

		<div class="flex items-start justify-between gap-4 mb-6">
			<div>
				<p class="text-xs font-semibold uppercase tracking-widest text-[var(--olive)] mb-1">Admin</p>
				<h1 class="font-display text-3xl font-semibold text-[var(--navy)] dark:text-white">Cloudflare Usage</h1>
				<p class="text-xs text-[var(--ink)]/45 dark:text-white/40 mt-1">{month} · account-wide</p>
			</div>
			<p class="text-xs text-[var(--ink)]/40 dark:text-white/30 mt-2 text-right">
				Refreshed<br />{refreshed}
			</p>
		</div>

		<div class="flex gap-3 mb-6">
			<a href="/course-admin" class="text-xs font-semibold text-[var(--navy)] dark:text-white bg-[var(--navy)]/6 dark:bg-white/8 hover:bg-[var(--navy)]/12 dark:hover:bg-white/12 rounded-lg px-3 py-1.5 transition-colors">
				Course Admin →
			</a>
			<a href="/stream-dashboard" class="text-xs font-semibold text-[var(--navy)] dark:text-white bg-[var(--navy)]/6 dark:bg-white/8 hover:bg-[var(--navy)]/12 dark:hover:bg-white/12 rounded-lg px-3 py-1.5 transition-colors">
				Stream Dashboard →
			</a>
			<a href={cfDash} target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-[var(--navy)] dark:text-white bg-[var(--navy)]/6 dark:bg-white/8 hover:bg-[var(--navy)]/12 dark:hover:bg-white/12 rounded-lg px-3 py-1.5 transition-colors">
				Billing →
			</a>
		</div>

		{!hasApi && (
			<div class="mb-6 rounded-xl bg-[var(--red)]/8 border border-[var(--red)]/20 px-4 py-3">
				<p class="text-sm font-semibold text-[var(--red)] mb-1">CF API not connected — usage data unavailable</p>
				<p class="text-xs text-[var(--ink)]/65 dark:text-white/55">
					Add <code class="bg-[var(--navy)]/8 dark:bg-white/10 rounded px-1 py-0.5">CF_ACCOUNT_ID</code> and <code class="bg-[var(--navy)]/8 dark:bg-white/10 rounded px-1 py-0.5">CF_API_TOKEN</code> as Cloudflare dashboard Variables.
					Token needs <em>Account Analytics → Read</em>.
				</p>
			</div>
		)}

		<div class="space-y-4">

			{/* ── Workers ─────────────────────────────────────────────────────── */}
			<div class="bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 overflow-hidden">
				<div class="flex items-center justify-between px-5 py-4 border-b border-[var(--navy)]/6 dark:border-white/6">
					<div class="flex items-center gap-2.5">
						<span class={`w-2 h-2 rounded-full shrink-0 ${statusDot(workersStats?.requests, 10_000_000)}`} />
						<div>
							<p class="font-semibold text-[var(--navy)] dark:text-white">Workers</p>
							<p class="text-xs text-[var(--ink)]/45 dark:text-white/40">Account-wide · {month}</p>
						</div>
					</div>
					<a href={cfDash} target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-[var(--green)] hover:underline shrink-0">Dashboard →</a>
				</div>

				<div class="px-5 py-4 space-y-4">
					{/* Requests */}
					<div>
						<div class="flex justify-between items-baseline mb-1.5">
							<span class="text-xs font-semibold text-[var(--ink)]/60 dark:text-white/50">Standard requests</span>
							<span class="text-sm font-semibold tabular-nums text-[var(--navy)] dark:text-white">
								{fmt(workersStats?.requests)} <span class="text-xs font-normal text-[var(--ink)]/40 dark:text-white/30">/ 10M</span>
							</span>
						</div>
						<div class="h-2 bg-[var(--navy)]/8 dark:bg-white/8 rounded-full overflow-hidden">
							<div class={`h-full rounded-full ${barColor(workersStats?.requests, 10_000_000)}`} style={`width:${pct(workersStats?.requests, 10_000_000)}%`} />
						</div>
					</div>

					{/* Build minutes */}
					<div>
						<div class="flex justify-between items-baseline mb-1.5">
							<span class="text-xs font-semibold text-[var(--ink)]/60 dark:text-white/50">Build minutes</span>
							<span class="text-sm font-semibold tabular-nums text-[var(--navy)] dark:text-white">
								{fmt(buildMins)} <span class="text-xs font-normal text-[var(--ink)]/40 dark:text-white/30">/ 6,000</span>
							</span>
						</div>
						<div class="h-2 bg-[var(--navy)]/8 dark:bg-white/8 rounded-full overflow-hidden">
							<div class={`h-full rounded-full ${barColor(buildMins, 6_000)}`} style={`width:${pct(buildMins, 6_000)}%`} />
						</div>
					</div>

					{/* CPU stats */}
					<div class="grid grid-cols-3 gap-2 text-sm">
						<div class="bg-[var(--navy)]/4 dark:bg-white/5 rounded-xl px-3 py-2">
							<p class="text-[10px] font-bold uppercase tracking-widest text-[var(--olive)] mb-0.5">Errors</p>
							<p class="font-semibold tabular-nums text-[var(--navy)] dark:text-white">{fmt(workersStats?.errors)}</p>
						</div>
						<div class="bg-[var(--navy)]/4 dark:bg-white/5 rounded-xl px-3 py-2">
							<p class="text-[10px] font-bold uppercase tracking-widest text-[var(--olive)] mb-0.5">CPU p50</p>
							<p class="font-semibold tabular-nums text-[var(--navy)] dark:text-white">{fmtMs(workersStats?.cpuP50ms)}</p>
						</div>
						<div class={`rounded-xl px-3 py-2 ${workersStats && workersStats.cpuP99ms > 9 ? 'bg-[var(--red)]/10' : 'bg-[var(--navy)]/4 dark:bg-white/5'}`}>
							<p class="text-[10px] font-bold uppercase tracking-widest text-[var(--olive)] mb-0.5">CPU p99 <span class="font-normal normal-case tracking-normal opacity-60">/ 10ms</span></p>
							<p class={`font-semibold tabular-nums ${workersStats && workersStats.cpuP99ms > 9 ? 'text-[var(--red)]' : 'text-[var(--navy)] dark:text-white'}`}>{fmtMs(workersStats?.cpuP99ms)}</p>
						</div>
					</div>

					<p class="text-[10px] text-[var(--ink)]/30 dark:text-white/25">10M req/month · 30M CPU ms/month · 6k build min/month · resets 1st UTC</p>
				</div>
			</div>

			{/* ── Workers KV ──────────────────────────────────────────────────── */}
			<div class="bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 overflow-hidden">
				<div class="flex items-center justify-between px-5 py-4 border-b border-[var(--navy)]/6 dark:border-white/6">
					<div class="flex items-center gap-2.5">
						<span class={`w-2 h-2 rounded-full shrink-0 ${statusDot(kvStats?.writes, 1_000_000)}`} />
						<div>
							<p class="font-semibold text-[var(--navy)] dark:text-white">Workers KV</p>
							<p class="text-xs text-[var(--ink)]/45 dark:text-white/40">Account-wide · {month}</p>
						</div>
					</div>
					<a href={cfDash} target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-[var(--green)] hover:underline shrink-0">Dashboard →</a>
				</div>

				<div class="px-5 py-4 space-y-4">
					{/* Read ops */}
					<div>
						<div class="flex justify-between items-baseline mb-1.5">
							<span class="text-xs font-semibold text-[var(--ink)]/60 dark:text-white/50">Read operations</span>
							<span class="text-sm font-semibold tabular-nums text-[var(--navy)] dark:text-white">
								{fmt(kvStats?.reads)} <span class="text-xs font-normal text-[var(--ink)]/40 dark:text-white/30">/ 10M</span>
							</span>
						</div>
						<div class="h-2 bg-[var(--navy)]/8 dark:bg-white/8 rounded-full overflow-hidden">
							<div class={`h-full rounded-full ${barColor(kvStats?.reads, 10_000_000)}`} style={`width:${pct(kvStats?.reads, 10_000_000)}%`} />
						</div>
					</div>

					{/* Write ops */}
					<div>
						<div class="flex justify-between items-baseline mb-1.5">
							<span class="text-xs font-semibold text-[var(--ink)]/60 dark:text-white/50">Write operations</span>
							<span class="text-sm font-semibold tabular-nums text-[var(--navy)] dark:text-white">
								{fmt(kvStats?.writes)} <span class="text-xs font-normal text-[var(--ink)]/40 dark:text-white/30">/ 1M</span>
							</span>
						</div>
						<div class="h-2 bg-[var(--navy)]/8 dark:bg-white/8 rounded-full overflow-hidden">
							<div class={`h-full rounded-full ${barColor(kvStats?.writes, 1_000_000)}`} style={`width:${pct(kvStats?.writes, 1_000_000)}%`} />
						</div>
					</div>

					{/* List ops */}
					<div>
						<div class="flex justify-between items-baseline mb-1.5">
							<span class="text-xs font-semibold text-[var(--ink)]/60 dark:text-white/50">List operations</span>
							<span class="text-sm font-semibold tabular-nums text-[var(--navy)] dark:text-white">
								{fmt(kvStats?.lists)} <span class="text-xs font-normal text-[var(--ink)]/40 dark:text-white/30">/ 1M</span>
							</span>
						</div>
						<div class="h-2 bg-[var(--navy)]/8 dark:bg-white/8 rounded-full overflow-hidden">
							<div class={`h-full rounded-full ${barColor(kvStats?.lists, 1_000_000)}`} style={`width:${pct(kvStats?.lists, 1_000_000)}%`} />
						</div>
					</div>

					{/* Per-namespace breakdown */}
					<div class="grid grid-cols-2 gap-2">
						{Object.entries(KV_NS).map(([name, id]) => {
							const ns = kvStats?.byNS[id];
							const storedKeys = name === 'LESSON_PROGRESS' ? lessonKeys : name === 'SERMON_JOBS' ? sermonJobKeys : null;
							return (
								<div class="bg-[var(--navy)]/4 dark:bg-white/5 rounded-xl px-3 py-2.5">
									<p class="text-[10px] font-bold uppercase tracking-widest text-[var(--olive)] mb-1.5">{name.replace(/_/g, ' ')}</p>
									<div class="flex gap-3 text-xs tabular-nums text-[var(--navy)]/70 dark:text-white/60">
										<span><span class="font-semibold text-[var(--navy)] dark:text-white">{fmt(ns?.reads ?? (hasApi ? 0 : null))}</span> reads</span>
										<span><span class="font-semibold text-[var(--navy)] dark:text-white">{fmt(ns?.writes ?? (hasApi ? 0 : null))}</span> writes</span>
									</div>
									{storedKeys !== null && (
