---
export const prerender = false;

import Base from '../layouts/Base.astro';
import { requireAuth } from '../lib/auth';
import { getConfig } from '../lib/data';
import { env } from 'cloudflare:workers';

const siteConfig = await getConfig();
const adminListId = (siteConfig.data?.config?.auth as Record<string, unknown> | null | undefined)?.adminListId as string | undefined;
const auth = requireAuth(Astro, adminListId);
if (auth instanceof Response) return auth;

// ── CF API credentials ──────────────────────────────────────────────────────
// Add CF_ACCOUNT_ID and CF_API_TOKEN as Cloudflare dashboard Variables.
// Token needs Account Analytics → Read permission.
const cfAccountId = process.env['CF_ACCOUNT_ID'] ?? null;
const cfApiToken  = process.env['CF_API_TOKEN'] ?? null;
const hasApi = !!(cfAccountId && cfApiToken);

const KV_NS = {
	LESSON_PROGRESS: '56984b88d58641dbb252b1e40fd897da',
	SERMON_JOBS:     '11aeec1bb02e4e68add35e292ae0e3fb',
};

// ── KV key count helpers ─────────────────────────────────────────────────────

function getKV(binding: keyof CloudflareEnv): KVNamespace | null {
	try { return (env as unknown as CloudflareEnv)[binding] as KVNamespace ?? null; }
	catch { return null; }
}

async function countKVKeys(kv: KVNamespace | null): Promise<number | null> {
	if (!kv) return null;
	let count = 0, cursor: string | undefined;
	do {
		const result = await kv.list({ limit: 1000, ...(cursor ? { cursor } : {}) });
		count += result.keys.length;
		cursor = result.list_complete ? undefined : (result.cursor || undefined);
	} while (cursor);
	return count;
}

// ── GraphQL helper ───────────────────────────────────────────────────────────

async function gql<T>(query: string): Promise<T | null> {
	if (!hasApi) return null;
	try {
		const res = await fetch('https://api.cloudflare.com/client/v4/graphql', {
			method: 'POST',
			headers: { Authorization: `Bearer ${cfApiToken}`, 'Content-Type': 'application/json' },
			body: JSON.stringify({ query }),
		});
		if (!res.ok) return null;
		const json = await res.json() as { data?: T; errors?: unknown[] };
		if (json.errors?.length) return null;
		return (json.data ?? null) as T;
	} catch { return null; }
}

// ── Date ranges (billing cycle: 23rd → 24th) ─────────────────────────────────

const now = new Date();
// Billing cycle runs from the 23rd of the previous month to the 24th of the current month.
const cycleStart = new Date(Date.UTC(
	now.getUTCDate() >= 23 ? now.getUTCFullYear() : (now.getUTCMonth() === 0 ? now.getUTCFullYear() - 1 : now.getUTCFullYear()),
	now.getUTCDate() >= 23 ? now.getUTCMonth() : (now.getUTCMonth() === 0 ? 11 : now.getUTCMonth() - 1),
	23
));
const cycleEnd = new Date(Date.UTC(
	now.getUTCDate() >= 23 ? (now.getUTCMonth() === 11 ? now.getUTCFullYear() + 1 : now.getUTCFullYear()) : now.getUTCFullYear(),
	now.getUTCDate() >= 23 ? (now.getUTCMonth() === 11 ? 0 : now.getUTCMonth() + 1) : now.getUTCMonth(),
	24
));
const mDT  = cycleStart.toISOString();
const mD   = mDT.slice(0, 10);
const nowDT = now.toISOString();
const nowD  = nowDT.slice(0, 10);

// ── Query 1: Workers + KV operations ────────────────────────────────────────

async function qWorkersKV() {
	type WRow = { sum: { requests: number; errors: number }; quantiles: { cpuTimeP50: number; cpuTimeP99: number } };
	type KVRow = { dimensions: { actionType: string; namespaceId: string }; sum: { requests: number } };
	type R = { viewer: { accounts: [{ workersInvocationsAdaptive: WRow[]; kvOperationsAdaptiveGroups: KVRow[] }] } };

	const d = await gql<R>(`{
    viewer {
      accounts(filter:{accountTag:"${cfAccountId}"}) {
        workersInvocationsAdaptive(limit:10000,filter:{
          datetime_geq:"${mDT}",datetime_leq:"${nowDT}"
        }) { sum{requests errors} quantiles{cpuTimeP50 cpuTimeP99} }
        kvOperationsAdaptiveGroups(limit:10000,filter:{
          date_geq:"${mD}",date_leq:"${nowD}"
        }) { dimensions{actionType namespaceId} sum{requests} }
      }
    }
  }`);

	if (!d) return { workers: null as null | { requests: number; errors: number; cpuP50ms: number; cpuP99ms: number }, kv: null as null | { reads: number; writes: number; lists: number; byNS: Record<string, { reads: number; writes: number; lists: number }> } };
	const acc = d.viewer.accounts[0];

	let req = 0, err = 0, cpuP50 = 0, cpuP99 = 0;
	for (const r of acc.workersInvocationsAdaptive ?? []) {
		req += r.sum.requests; err += r.sum.errors;
		cpuP50 = Math.max(cpuP50, r.quantiles.cpuTimeP50);
		cpuP99 = Math.max(cpuP99, r.quantiles.cpuTimeP99);
	}

	const kv = { reads: 0, writes: 0, lists: 0, byNS: {} as Record<string, { reads: number; writes: number; lists: number }> };
	for (const r of acc.kvOperationsAdaptiveGroups ?? []) {
		const { actionType: at, namespaceId: ns } = r.dimensions;
		const n = r.sum.requests;
		if (!kv.byNS[ns]) kv.byNS[ns] = { reads: 0, writes: 0, lists: 0 };
		if (at === 'read')       { kv.reads  += n; kv.byNS[ns].reads  += n; }
		else if (at === 'write') { kv.writes += n; kv.byNS[ns].writes += n; }
		else if (at === 'list')  { kv.lists  += n; kv.byNS[ns].lists  += n; }
	}

	return { workers: { requests: req, errors: err, cpuP50ms: cpuP50 / 1000, cpuP99ms: cpuP99 / 1000 }, kv };
}

// ── Query 2: R2 storage + operations ─────────────────────────────────────────
// Class B = GET/HEAD (reads). Class A = everything else (writes, list, delete).

const CLASS_B_OPS = new Set(['GetObject', 'HeadObject', 'HeadBucket']);

async function qR2() {
	type R = { viewer: { accounts: [{
		r2StorageAdaptiveGroups:    Array<{ max: { payloadSize: number; objectCount: number } }>;
		r2OperationsAdaptiveGroups: Array<{ dimensions: { actionType: string }; sum: { requests: number } }>;
	}] } };

	const d = await gql<R>(`{
    viewer {
      accounts(filter:{accountTag:"${cfAccountId}"}) {
        r2StorageAdaptiveGroups(limit:10000,filter:{
          date_geq:"${mD}",date_leq:"${nowD}"
        }) { max{payloadSize objectCount} }
        r2OperationsAdaptiveGroups(limit:10000,filter:{
          date_geq:"${mD}",date_leq:"${nowD}"
        }) { dimensions{actionType} sum{requests} }
      }
    }
  }`);

	if (!d) return null;
	const acc = d.viewer.accounts[0];
	const storageRow = acc.r2StorageAdaptiveGroups?.reduce((best, r) => r.max.payloadSize > (best?.max.payloadSize ?? 0) ? r : best, acc.r2StorageAdaptiveGroups[0]);
	const storageBytes = storageRow?.max?.payloadSize ?? null;
	let classA = 0, classB = 0;
	for (const r of acc.r2OperationsAdaptiveGroups ?? []) {
		if (CLASS_B_OPS.has(r.dimensions.actionType)) classB += r.sum.requests;
		else classA += r.sum.requests;
	}
	return { storageBytes, classAOps: classA, classBOps: classB };
}

// ── Query 3: DO + D1 ─────────────────────────────────────────────────────────
// Field names verified via GraphQL introspection against live account.

async function qDOD1() {
	type R = { viewer: { accounts: [{
		durableObjectsInvocationsAdaptiveGroups: Array<{ sum: { requests: number } }>;
		durableObjectsPeriodicGroups:            Array<{ sum: { activeTime: number; rowsRead: number; rowsWritten: number } }>;
		durableObjectsSqlStorageGroups:          Array<{ max: { storedBytes: number } }>;
		d1AnalyticsAdaptiveGroups:               Array<{ sum: { rowsRead: number; rowsWritten: number } }>;
	}] } };

	const d = await gql<R>(`{
    viewer {
      accounts(filter:{accountTag:"${cfAccountId}"}) {
        durableObjectsInvocationsAdaptiveGroups(limit:10000,filter:{
          date_geq:"${mD}",date_leq:"${nowD}"
        }) { sum{requests} }
        durableObjectsPeriodicGroups(limit:10000,filter:{
          date_geq:"${mD}",date_leq:"${nowD}"
        }) { sum{activeTime rowsRead rowsWritten} }
        durableObjectsSqlStorageGroups(limit:10000,filter:{
          date_geq:"${mD}",date_leq:"${nowD}"
        }) { max{storedBytes} }
        d1AnalyticsAdaptiveGroups(limit:10000,filter:{
          date_geq:"${mD}",date_leq:"${nowD}"
        }) { sum{rowsRead rowsWritten} }
      }
    }
  }`);

	if (!d) return { doReqs: null as number | null, doActiveTimeUs: null as number | null, doRowsRead: null as number | null, doRowsWritten: null as number | null, doSqlBytes: null as number | null, d1Reads: null as number | null };
	const acc = d.viewer.accounts[0];
	const doReqs        = (acc.durableObjectsInvocationsAdaptiveGroups ?? []).reduce((s, r) => s + r.sum.requests, 0);
	const doActiveTimeUs = (acc.durableObjectsPeriodicGroups ?? []).reduce((s, r) => s + r.sum.activeTime, 0);
	const doRowsRead    = (acc.durableObjectsPeriodicGroups ?? []).reduce((s, r) => s + r.sum.rowsRead, 0);
	const doRowsWritten = (acc.durableObjectsPeriodicGroups ?? []).reduce((s, r) => s + r.sum.rowsWritten, 0);
	const doSqlBytes    = (acc.durableObjectsSqlStorageGroups ?? []).reduce((max, r) => Math.max(max, r.max.storedBytes), 0);
	const d1Reads       = (acc.d1AnalyticsAdaptiveGroups ?? []).reduce((s, r) => s + r.sum.rowsRead, 0);
	return { doReqs, doActiveTimeUs, doRowsRead, doRowsWritten, doSqlBytes, d1Reads };
}

// ── Query 4: Build minutes + Vectorize + KV storage + Workers AI ─────────────
// Field names verified via GraphQL introspection against live account.

async function qExtras() {
	type R = { viewer: { accounts: [{
		workersBuildsBuildMinutesAdaptiveGroups: Array<{ sum: { buildMinutes: number } }>;
		vectorizeV2StorageAdaptiveGroups:        Array<{ max: { storedVectorDimensions: number; vectorCount: number } }>;
		kvStorageAdaptiveGroups:                 Array<{ max: { byteCount: number } }>;
		aiInferenceAdaptiveGroups:               Array<{ sum: { totalNeurons: number } }>;
	}] } };

	const d = await gql<R>(`{
    viewer {
      accounts(filter:{accountTag:"${cfAccountId}"}) {
        workersBuildsBuildMinutesAdaptiveGroups(limit:10000,filter:{
          date_geq:"${mD}",date_leq:"${nowD}"
        }) { sum{buildMinutes} }
        vectorizeV2StorageAdaptiveGroups(limit:10000,filter:{
          date_geq:"${mD}",date_leq:"${nowD}"
        }) { max{storedVectorDimensions vectorCount} }
        kvStorageAdaptiveGroups(limit:10000,filter:{
          date_geq:"${mD}",date_leq:"${nowD}"
        }) { max{byteCount} }
        aiInferenceAdaptiveGroups(limit:10000,filter:{
          date_geq:"${mD}",date_leq:"${nowD}"
        }) { sum{totalNeurons} }
      }
    }
  }`);

	if (!d) return { buildMins: null as number | null, vectorDims: null as number | null, vectorCount: null as number | null, kvBytes: null as number | null, aiNeurons: null as number | null };
	const acc = d.viewer.accounts[0];
	const buildMins   = (acc.workersBuildsBuildMinutesAdaptiveGroups ?? []).reduce((s, r) => s + r.sum.buildMinutes, 0);
	const vectorRow   = acc.vectorizeV2StorageAdaptiveGroups?.reduce((best, r) => r.max.storedVectorDimensions > (best?.max.storedVectorDimensions ?? 0) ? r : best, acc.vectorizeV2StorageAdaptiveGroups[0]);
	const vectorDims  = vectorRow?.max?.storedVectorDimensions ?? 0;
	const vectorCount = vectorRow?.max?.vectorCount ?? 0;
	const kvBytes     = (acc.kvStorageAdaptiveGroups ?? []).reduce((max, r) => Math.max(max, r.max.byteCount), 0);
	const aiNeurons   = (acc.aiInferenceAdaptiveGroups ?? []).reduce((s, r) => s + r.sum.totalNeurons, 0);
	return { buildMins, vectorDims, vectorCount, kvBytes, aiNeurons };
}

// ── Fetch everything in parallel ─────────────────────────────────────────────

const [wkvData, r2Data, dod1Data, extrasData, lessonKeys, sermonJobKeys] = await Promise.all([
	qWorkersKV(),
	qR2(),
	qDOD1(),
	qExtras(),
	countKVKeys(getKV('LESSON_PROGRESS')),
	countKVKeys(getKV('SERMON_JOBS')),
]);

const workersStats   = wkvData.workers;
const kvStats        = wkvData.kv;
const r2Stats        = r2Data;
// DO compute duration: activeTime is wall-time µs. CF bills at 128MB per DO = 0.128 GB.
const doGBSeconds    = dod1Data.doActiveTimeUs != null ? (dod1Data.doActiveTimeUs / 1_000_000) * 0.128 : null;
const doReqs         = dod1Data.doReqs;
const doRowsRead     = dod1Data.doRowsRead;
const doRowsWritten  = dod1Data.doRowsWritten;
const doSqlBytes     = dod1Data.doSqlBytes;
const d1Reads        = dod1Data.d1Reads;
const buildMins      = extrasData.buildMins;
const vectorDims     = extrasData.vectorDims;
const vectorCount    = extrasData.vectorCount;
const kvBytes        = extrasData.kvBytes;
const aiNeurons      = extrasData.aiNeurons;
// Free tier: 10,000 neurons/day. Approximate cycle limit = 10,000 × 30 days.
const aiNeuronsLimit = 300_000;

// Vectorize: billing is dimension-months (prorated by fraction of cycle elapsed).
const cycleDaysTotal  = (cycleEnd.getTime() - cycleStart.getTime()) / 86_400_000;
const daysElapsed     = Math.min(cycleDaysTotal, (now.getTime() - cycleStart.getTime()) / 86_400_000);
const vectorDimsProrated = vectorDims != null ? Math.round(vectorDims * (daysElapsed / cycleDaysTotal)) : null;

// ── Display helpers ───────────────────────────────────────────────────────────

function pct(used: number | null | undefined, limit: number): number {
	if (used == null) return 0;
	return Math.min(100, (used / limit) * 100);
}

function barColor(used: number | null | undefined, limit: number): string {
	const p = used == null ? -1 : (used / limit) * 100;
	if (p < 0)   return 'bg-[var(--navy)]/15 dark:bg-white/10';
	if (p >= 90) return 'bg-[var(--red)]';
	if (p >= 70) return 'bg-yellow-400';
	return 'bg-[var(--green)]';
}

function statusDot(used: number | null | undefined, limit: number): string {
	if (used == null) return 'bg-[var(--navy)]/20 dark:bg-white/15';
	const p = (used / limit) * 100;
	if (p >= 90) return 'bg-[var(--red)]';
	if (p >= 70) return 'bg-yellow-400';
	return 'bg-[var(--green)]';
}

function fmt(n: number | null | undefined): string {
	if (n == null) return '—';
	if (n >= 1_000_000_000) return `${(n / 1_000_000_000).toFixed(2)}B`;
	if (n >= 1_000_000)     return `${(n / 1_000_000).toFixed(2)}M`;
	if (n >= 1_000)         return `${(n / 1_000).toFixed(1)}k`;
	return String(n);
}

function fmtGB(bytes: number | null | undefined): string {
	if (bytes == null) return '—';
	const gb = bytes / 1_073_741_824;
	if (gb >= 1) return `${gb.toFixed(2)} GB`;
	const mb = bytes / 1_048_576;
	if (mb >= 1) return `${mb.toFixed(0)} MB`;
	return `${(bytes / 1024).toFixed(0)} KB`;
}

function fmtMs(ms: number | null | undefined): string {
	if (ms == null) return '—';
	return `${ms.toFixed(2)} ms`;
}

const cfDash = 'https://dash.cloudflare.com';
const fmtDate = (d: Date) => d.toLocaleDateString('en-ZA', { day: 'numeric', month: 'short', timeZone: 'UTC' });
const month = `${fmtDate(cycleStart)} – ${fmtDate(cycleEnd)}`;
const refreshed = now.toLocaleTimeString('en-ZA', {
	timeZone: 'Africa/Johannesburg',
	hour: '2-digit', minute: '2-digit', second: '2-digit',
});
---

<Base title="Cloudflare Status" description="Cloudflare service usage and free tier limits" noindex={true}>

	<div class="max-w-2xl mx-auto px-4 sm:px-6 pt-10 pb-24">

		<div class="flex items-start justify-between gap-4 mb-6">
			<div>
				<p class="text-xs font-semibold uppercase tracking-widest text-[var(--olive)] mb-1">Admin</p>
