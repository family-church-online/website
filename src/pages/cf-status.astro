---
export const prerender = false;

import Base from '../layouts/Base.astro';
import { requireAuth } from '../lib/auth';
import { getConfig } from '../lib/data';
import { env } from 'cloudflare:workers';

const siteConfig = await getConfig();
const adminListId = (siteConfig.data?.config?.auth as Record<string, unknown> | null | undefined)?.adminListId as string | undefined;
const auth = requireAuth(Astro, adminListId);
if (auth instanceof Response) return auth;

// ── CF API credentials (optional — Workers analytics only) ────────────────────
// Add CF_ACCOUNT_ID and CF_API_TOKEN as Cloudflare dashboard Variables.
// Token needs: Account Analytics → Read permission.
const cfAccountId = process.env['CF_ACCOUNT_ID'] ?? null;
const cfApiToken  = process.env['CF_API_TOKEN'] ?? null;
const hasApi = !!(cfAccountId && cfApiToken);

// ── KV helpers ────────────────────────────────────────────────────────────────

function getKV(binding: keyof CloudflareEnv): KVNamespace | null {
	try {
		return (env as unknown as CloudflareEnv)[binding] as KVNamespace ?? null;
	} catch { return null; }
}

async function countKVKeys(kv: KVNamespace | null): Promise<number | null> {
	if (!kv) return null;
	let count = 0;
	let cursor: string | undefined;
	do {
		const result = await kv.list({ limit: 1000, ...(cursor ? { cursor } : {}) });
		count += result.keys.length;
		cursor = result.list_complete ? undefined : (result.cursor || undefined);
	} while (cursor);
	return count;
}

// ── Workers analytics (Cloudflare GraphQL Analytics API) ──────────────────────

interface WorkersStats {
	requests: number;
	errors: number;
	subrequests: number;
	cpuP50ms: number;
	cpuP99ms: number;
}

async function fetchWorkersStats(): Promise<WorkersStats | null> {
	if (!hasApi) return null;
	const now = new Date();
	const dayStart = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate())).toISOString();
	const dayEnd   = now.toISOString();

	const query = `{
    viewer {
      accounts(filter: { accountTag: "${cfAccountId}" }) {
        workersInvocationsAdaptive(limit: 10000, filter: {
          scriptName: "family-church-website",
          datetime_geq: "${dayStart}",
          datetime_leq: "${dayEnd}"
        }) {
          sum { requests errors subrequests }
          quantiles { cpuTimeP50 cpuTimeP99 }
        }
      }
    }
  }`;

	try {
		const res = await fetch('https://api.cloudflare.com/client/v4/graphql', {
			method: 'POST',
			headers: {
				Authorization: `Bearer ${cfApiToken}`,
				'Content-Type': 'application/json',
			},
			body: JSON.stringify({ query }),
		});
		if (!res.ok) return null;

		const json = await res.json() as {
			data?: {
				viewer?: {
					accounts?: Array<{
						workersInvocationsAdaptive?: Array<{
							sum: { requests: number; errors: number; subrequests: number };
							quantiles: { cpuTimeP50: number; cpuTimeP99: number };
						}>;
					}>;
				};
			};
		};

		const rows = json.data?.viewer?.accounts?.[0]?.workersInvocationsAdaptive ?? [];
		if (!rows.length) return { requests: 0, errors: 0, subrequests: 0, cpuP50ms: 0, cpuP99ms: 0 };

		let requests = 0, errors = 0, subrequests = 0, cpuP50 = 0, cpuP99 = 0;
		for (const row of rows) {
			requests    += row.sum.requests;
			errors      += row.sum.errors;
			subrequests += row.sum.subrequests;
			cpuP50 = Math.max(cpuP50, row.quantiles.cpuTimeP50);
			cpuP99 = Math.max(cpuP99, row.quantiles.cpuTimeP99);
		}
		// cpuTime values are in microseconds
		return { requests, errors, subrequests, cpuP50ms: cpuP50 / 1000, cpuP99ms: cpuP99 / 1000 };
	} catch {
		return null;
	}
}

// ── Fetch everything in parallel ──────────────────────────────────────────────

const [workersStats, lessonKeys, reportKeys] = await Promise.all([
	fetchWorkersStats(),
	countKVKeys(getKV('LESSON_PROGRESS')),
	countKVKeys(getKV('STREAM_REPORTS')),
]);

// ── Display helpers ────────────────────────────────────────────────────────────

function pct(used: number | null, limit: number): number | null {
	if (used === null) return null;
	return Math.min(100, (used / limit) * 100);
}

function barColor(p: number | null): string {
	if (p === null) return 'bg-[var(--navy)]/15 dark:bg-white/10';
	if (p >= 90) return 'bg-[var(--red)]';
	if (p >= 70) return 'bg-yellow-400';
	return 'bg-[var(--green)]';
}

function fmt(n: number | null): string {
	if (n === null) return '—';
	if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(2)}M`;
	if (n >= 1_000) return `${(n / 1_000).toFixed(1)}k`;
	return String(n);
}

function fmtMs(ms: number | null): string {
	if (ms === null) return '—';
	return `${ms.toFixed(2)} ms`;
}

const now = new Date();
const refreshed = now.toLocaleTimeString('en-ZA', {
	timeZone: 'Africa/Johannesburg',
	hour: '2-digit',
	minute: '2-digit',
	second: '2-digit',
});

const cfDash = 'https://dash.cloudflare.com';
---

<Base title="Cloudflare Status" description="Cloudflare service usage and free tier limits" noindex={true}>

	<div class="max-w-2xl mx-auto px-4 sm:px-6 pt-10 pb-24">

		<div class="flex items-start justify-between gap-4 mb-8">
			<div>
				<p class="text-xs font-semibold uppercase tracking-widest text-[var(--olive)] mb-1">Admin</p>
				<h1 class="font-display text-3xl font-semibold text-[var(--navy)] dark:text-white">Cloudflare Usage</h1>
			</div>
			<p class="text-xs text-[var(--ink)]/40 dark:text-white/30 mt-2 text-right">
				Refreshed<br />{refreshed}
			</p>
		</div>

		{!hasApi && (
			<div class="mb-6 rounded-xl bg-[var(--olive)]/10 border border-[var(--olive)]/20 px-4 py-3 text-sm text-[var(--ink)]/70 dark:text-white/60">
				<strong class="font-semibold">Workers analytics not connected.</strong>
				{' '}Add <code class="text-xs bg-[var(--navy)]/8 dark:bg-white/10 rounded px-1.5 py-0.5">CF_ACCOUNT_ID</code> and{' '}
				<code class="text-xs bg-[var(--navy)]/8 dark:bg-white/10 rounded px-1.5 py-0.5">CF_API_TOKEN</code> as Cloudflare dashboard Variables.
				The token needs <em>Account Analytics → Read</em> permission.
			</div>
		)}

		<div class="space-y-4">

			{/* ── Workers ───────────────────────────────────────────────────────── */}
			<div class="bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 overflow-hidden">
				<div class="flex items-center justify-between px-5 py-4 border-b border-[var(--navy)]/6 dark:border-white/6">
					<div>
						<p class="font-semibold text-[var(--navy)] dark:text-white">Workers</p>
						<p class="text-xs text-[var(--ink)]/45 dark:text-white/40">family-church-website · today (UTC)</p>
					</div>
					<a
						href={cfDash}
						target="_blank"
						rel="noopener noreferrer"
						class="text-xs font-semibold text-[var(--green)] hover:underline"
					>
						Dashboard →
					</a>
				</div>

				<div class="px-5 py-4 space-y-4">
					{/* Requests */}
					<div>
						<div class="flex justify-between items-baseline mb-1.5">
							<span class="text-xs font-semibold text-[var(--ink)]/60 dark:text-white/50">Requests</span>
							<span class="text-sm font-semibold tabular-nums text-[var(--navy)] dark:text-white">
								{fmt(workersStats?.requests ?? null)}
								<span class="text-xs font-normal text-[var(--ink)]/40 dark:text-white/30"> / 100k/day</span>
							</span>
						</div>
						<div class="h-1.5 bg-[var(--navy)]/8 dark:bg-white/8 rounded-full overflow-hidden">
							<div
								class={`h-full rounded-full transition-all ${barColor(pct(workersStats?.requests ?? null, 100_000))}`}
								style={`width: ${pct(workersStats?.requests ?? null, 100_000) ?? 0}%`}
							/>
						</div>
					</div>

					{/* Errors + subrequests */}
					<div class="grid grid-cols-2 gap-3 text-sm">
						<div class="bg-[var(--navy)]/4 dark:bg-white/5 rounded-xl px-3 py-2.5">
							<p class="text-[10px] font-bold uppercase tracking-widest text-[var(--olive)] mb-0.5">Errors</p>
							<p class="font-semibold tabular-nums text-[var(--navy)] dark:text-white">
								{fmt(workersStats?.errors ?? null)}
							</p>
						</div>
						<div class="bg-[var(--navy)]/4 dark:bg-white/5 rounded-xl px-3 py-2.5">
							<p class="text-[10px] font-bold uppercase tracking-widest text-[var(--olive)] mb-0.5">Subrequests</p>
							<p class="font-semibold tabular-nums text-[var(--navy)] dark:text-white">
								{fmt(workersStats?.subrequests ?? null)}
								<span class="text-xs font-normal text-[var(--ink)]/40 dark:text-white/30"> / 50 each</span>
							</p>
						</div>
					</div>

					{/* CPU time */}
					<div class="grid grid-cols-2 gap-3 text-sm">
						<div class="bg-[var(--navy)]/4 dark:bg-white/5 rounded-xl px-3 py-2.5">
							<p class="text-[10px] font-bold uppercase tracking-widest text-[var(--olive)] mb-0.5">CPU p50</p>
							<p class="font-semibold tabular-nums text-[var(--navy)] dark:text-white">
								{fmtMs(workersStats ? workersStats.cpuP50ms : null)}
							</p>
						</div>
						<div class={`rounded-xl px-3 py-2.5 ${workersStats && workersStats.cpuP99ms > 9 ? 'bg-[var(--red)]/10' : 'bg-[var(--navy)]/4 dark:bg-white/5'}`}>
							<p class="text-[10px] font-bold uppercase tracking-widest text-[var(--olive)] mb-0.5">
								CPU p99 <span class="text-[var(--ink)]/35 dark:text-white/25 font-normal normal-case tracking-normal">/ 10ms limit</span>
							</p>
							<p class={`font-semibold tabular-nums ${workersStats && workersStats.cpuP99ms > 9 ? 'text-[var(--red)]' : 'text-[var(--navy)] dark:text-white'}`}>
								{fmtMs(workersStats ? workersStats.cpuP99ms : null)}
							</p>
						</div>
					</div>

					<p class="text-[10px] text-[var(--ink)]/30 dark:text-white/25">
						Free: 100k req/day · 10ms CPU/req · 128MB RAM · 50 subreq/req
					</p>
				</div>
			</div>

			{/* ── KV: LESSON_PROGRESS ───────────────────────────────────────────── */}
			<div class="bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 overflow-hidden">
				<div class="flex items-center justify-between px-5 py-4 border-b border-[var(--navy)]/6 dark:border-white/6">
					<div>
						<p class="font-semibold text-[var(--navy)] dark:text-white">KV — LESSON_PROGRESS</p>
						<p class="text-xs text-[var(--ink)]/45 dark:text-white/40">Course completion records</p>
					</div>
					<a
						href={cfDash}
						target="_blank"
						rel="noopener noreferrer"
						class="text-xs font-semibold text-[var(--green)] hover:underline"
					>
						Dashboard →
					</a>
				</div>
				<div class="px-5 py-4 space-y-3">
					<div class="flex items-center justify-between">
						<span class="text-xs font-semibold text-[var(--ink)]/60 dark:text-white/50">Keys stored</span>
						<span class="text-lg font-semibold tabular-nums text-[var(--navy)] dark:text-white">
							{lessonKeys !== null ? lessonKeys.toLocaleString() : '—'}
						</span>
					</div>
					<p class="text-[10px] text-[var(--ink)]/30 dark:text-white/25">
						Free: 100k reads/day · 1k writes/day · 1 GB total storage
					</p>
				</div>
			</div>

			{/* ── KV: STREAM_REPORTS ────────────────────────────────────────────── */}
			<div class="bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 overflow-hidden">
				<div class="flex items-center justify-between px-5 py-4 border-b border-[var(--navy)]/6 dark:border-white/6">
					<div>
						<p class="font-semibold text-[var(--navy)] dark:text-white">KV — STREAM_REPORTS</p>
						<p class="text-xs text-[var(--ink)]/45 dark:text-white/40">Live stream problem reports · 7-day TTL</p>
					</div>
					<a
						href={cfDash}
						target="_blank"
						rel="noopener noreferrer"
						class="text-xs font-semibold text-[var(--green)] hover:underline"
					>
						Dashboard →
					</a>
				</div>
				<div class="px-5 py-4 space-y-3">
					<div class="flex items-center justify-between">
						<span class="text-xs font-semibold text-[var(--ink)]/60 dark:text-white/50">Active keys</span>
						<span class="text-lg font-semibold tabular-nums text-[var(--navy)] dark:text-white">
							{reportKeys !== null ? reportKeys.toLocaleString() : '—'}
						</span>
					</div>
					<p class="text-[10px] text-[var(--ink)]/30 dark:text-white/25">
						Shared limits with LESSON_PROGRESS · auto-expires after 7 days
					</p>
				</div>
			</div>

			{/* ── Durable Objects ───────────────────────────────────────────────── */}
			<div class="bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 overflow-hidden">
				<div class="flex items-center justify-between px-5 py-4 border-b border-[var(--navy)]/6 dark:border-white/6">
					<div>
						<p class="font-semibold text-[var(--navy)] dark:text-white">Durable Objects — StreamMonitor</p>
						<p class="text-xs text-[var(--ink)]/45 dark:text-white/40">WebSocket hub for live stream dashboard</p>
					</div>
					<a
						href={cfDash}
						target="_blank"
						rel="noopener noreferrer"
						class="text-xs font-semibold text-[var(--green)] hover:underline"
					>
						Dashboard →
					</a>
				</div>
				<div class="px-5 py-4">
					<p class="text-xs text-[var(--ink)]/50 dark:text-white/40 mb-2">
						Usage data requires CF Analytics API. Check the dashboard for request counts and compute duration.
					</p>
					<p class="text-[10px] text-[var(--ink)]/30 dark:text-white/25">
						Free: 5 GB SQLite storage · soft limit 1k req/s per object
					</p>
				</div>
			</div>

			{/* ── R2 ────────────────────────────────────────────────────────────── */}
			<div class="bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 overflow-hidden">
				<div class="flex items-center justify-between px-5 py-4 border-b border-[var(--navy)]/6 dark:border-white/6">
					<div>
						<p class="font-semibold text-[var(--navy)] dark:text-white">R2 — sermons</p>
						<p class="text-xs text-[var(--ink)]/45 dark:text-white/40">Sermon audio · audio.familychurch.online</p>
					</div>
					<a
						href={cfDash}
						target="_blank"
						rel="noopener noreferrer"
						class="text-xs font-semibold text-[var(--green)] hover:underline"
					>
						Dashboard →
					</a>
				</div>
				<div class="px-5 py-4">
					<p class="text-xs text-[var(--ink)]/50 dark:text-white/40 mb-2">
						No R2 binding — accessed via S3 API from import scripts only. Check the dashboard for storage and operation counts.
					</p>
					<p class="text-[10px] text-[var(--ink)]/30 dark:text-white/25">
						Free: 10 GB storage · 1M Class A ops/month · 10M Class B ops/month · no egress fees
					</p>
				</div>
			</div>

		</div>

		<p class="text-[10px] text-[var(--ink)]/25 dark:text-white/20 text-center mt-8">
			Workers limits reset at midnight UTC · KV limits reset daily · R2 limits reset monthly
		</p>

	</div>

</Base>
