---
export const prerender = false;

import Base from '../layouts/Base.astro';
import { requireAuth } from '../lib/auth';
import { getConfig } from '../lib/data';
import { env } from 'cloudflare:workers';

const siteConfig = await getConfig();
const adminListId = (siteConfig.data?.config?.auth as Record<string, unknown> | null | undefined)?.adminListId as string | undefined;
const auth = requireAuth(Astro, adminListId);
if (auth instanceof Response) return auth;

// ── CF API credentials ─────────────────────────────────────────────────────────
// Add CF_ACCOUNT_ID and CF_API_TOKEN as Cloudflare dashboard Variables.
// Token needs: Account Analytics → Read permission.
const cfAccountId = process.env['CF_ACCOUNT_ID'] ?? null;
const cfApiToken  = process.env['CF_API_TOKEN'] ?? null;
const hasApi = !!(cfAccountId && cfApiToken);

// KV namespace IDs (from wrangler.jsonc) — needed for per-namespace breakdown
const KV_NS = {
	LESSON_PROGRESS: '56984b88d58641dbb252b1e40fd897da',
	STREAM_REPORTS:  'aac02cbf9d654272a4a5321fddb472a5',
};

// ── KV helpers ────────────────────────────────────────────────────────────────

function getKV(binding: keyof CloudflareEnv): KVNamespace | null {
	try {
		return (env as unknown as CloudflareEnv)[binding] as KVNamespace ?? null;
	} catch { return null; }
}

async function countKVKeys(kv: KVNamespace | null): Promise<number | null> {
	if (!kv) return null;
	let count = 0;
	let cursor: string | undefined;
	do {
		const result = await kv.list({ limit: 1000, ...(cursor ? { cursor } : {}) });
		count += result.keys.length;
		cursor = result.list_complete ? undefined : (result.cursor || undefined);
	} while (cursor);
	return count;
}

// ── Cloudflare GraphQL Analytics (single combined request) ────────────────────

interface WorkersStats {
	requests: number;
	errors: number;
	subrequests: number;
	cpuP50ms: number;
	cpuP99ms: number;
}

interface KVOpCounts {
	read: number;
	write: number;
	delete: number;
	list: number;
}

interface KVStats {
	total: KVOpCounts;
	byNamespace: Record<string, KVOpCounts>;
}

async function fetchAnalytics(): Promise<{ workers: WorkersStats | null; kv: KVStats | null }> {
	if (!hasApi) return { workers: null, kv: null };

	const now = new Date();
	const dayStartDT = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate())).toISOString();
	const dayEndDT   = now.toISOString();
	// KV uses date-only filters
	const today = dayStartDT.slice(0, 10);

	const query = `{
    viewer {
      accounts(filter: { accountTag: "${cfAccountId}" }) {
        workersInvocationsAdaptive(limit: 10000, filter: {
          scriptName: "family-church-website",
          datetime_geq: "${dayStartDT}",
          datetime_leq: "${dayEndDT}"
        }) {
          sum { requests errors subrequests }
          quantiles { cpuTimeP50 cpuTimeP99 }
        }
        kvOperationsAdaptiveGroups(limit: 10000, filter: {
          date_geq: "${today}",
          date_leq: "${today}"
        }) {
          dimensions { actionType namespaceId }
          sum { requests }
        }
      }
    }
  }`;

	try {
		const res = await fetch('https://api.cloudflare.com/client/v4/graphql', {
			method: 'POST',
			headers: {
				Authorization: `Bearer ${cfApiToken}`,
				'Content-Type': 'application/json',
			},
			body: JSON.stringify({ query }),
		});
		if (!res.ok) return { workers: null, kv: null };

		const json = await res.json() as {
			data?: {
				viewer?: {
					accounts?: Array<{
						workersInvocationsAdaptive?: Array<{
							sum: { requests: number; errors: number; subrequests: number };
							quantiles: { cpuTimeP50: number; cpuTimeP99: number };
						}>;
						kvOperationsAdaptiveGroups?: Array<{
							dimensions: { actionType: string; namespaceId: string };
							sum: { requests: number };
						}>;
					}>;
				};
			};
		};

		const account = json.data?.viewer?.accounts?.[0];

		// Workers
		let workers: WorkersStats | null = null;
		const wRows = account?.workersInvocationsAdaptive ?? [];
		if (wRows.length > 0) {
			let requests = 0, errors = 0, subrequests = 0, cpuP50 = 0, cpuP99 = 0;
			for (const row of wRows) {
				requests    += row.sum.requests;
				errors      += row.sum.errors;
				subrequests += row.sum.subrequests;
				cpuP50 = Math.max(cpuP50, row.quantiles.cpuTimeP50);
				cpuP99 = Math.max(cpuP99, row.quantiles.cpuTimeP99);
			}
			workers = { requests, errors, subrequests, cpuP50ms: cpuP50 / 1000, cpuP99ms: cpuP99 / 1000 };
		} else {
			workers = { requests: 0, errors: 0, subrequests: 0, cpuP50ms: 0, cpuP99ms: 0 };
		}

		// KV
		const empty = (): KVOpCounts => ({ read: 0, write: 0, delete: 0, list: 0 });
		const total = empty();
		const byNamespace: Record<string, KVOpCounts> = {};

		for (const row of (account?.kvOperationsAdaptiveGroups ?? [])) {
			const { actionType, namespaceId } = row.dimensions;
			const n = row.sum.requests;
			const type = actionType as keyof KVOpCounts;
			if (type in total) total[type] += n;
			if (!byNamespace[namespaceId]) byNamespace[namespaceId] = empty();
			if (type in byNamespace[namespaceId]) byNamespace[namespaceId][type] += n;
		}

		return { workers, kv: { total, byNamespace } };
	} catch {
		return { workers: null, kv: null };
	}
}

// ── Fetch everything in parallel ──────────────────────────────────────────────

const [analytics, lessonKeys, reportKeys] = await Promise.all([
	fetchAnalytics(),
	countKVKeys(getKV('LESSON_PROGRESS')),
	countKVKeys(getKV('STREAM_REPORTS')),
]);

const { workers: workersStats, kv: kvStats } = analytics;

// ── Display helpers ────────────────────────────────────────────────────────────

function pct(used: number | null | undefined, limit: number): number {
	if (used == null) return 0;
	return Math.min(100, (used / limit) * 100);
}

function barColor(used: number | null | undefined, limit: number): string {
	const p = used == null ? -1 : (used / limit) * 100;
	if (p < 0)  return 'bg-[var(--navy)]/15 dark:bg-white/10';
	if (p >= 90) return 'bg-[var(--red)]';
	if (p >= 70) return 'bg-yellow-400';
	return 'bg-[var(--green)]';
}

function statusDot(used: number | null | undefined, limit: number): string {
	if (used == null) return 'bg-[var(--navy)]/20 dark:bg-white/15';
	const p = (used / limit) * 100;
	if (p >= 90) return 'bg-[var(--red)]';
	if (p >= 70) return 'bg-yellow-400';
	return 'bg-[var(--green)]';
}

function fmt(n: number | null | undefined): string {
	if (n == null) return '—';
	if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(2)}M`;
	if (n >= 1_000) return `${(n / 1_000).toFixed(1)}k`;
	return String(n);
}

function fmtMs(ms: number | null | undefined): string {
	if (ms == null) return '—';
	return `${ms.toFixed(2)} ms`;
}

const now = new Date();
const refreshed = now.toLocaleTimeString('en-ZA', {
	timeZone: 'Africa/Johannesburg',
	hour: '2-digit',
	minute: '2-digit',
	second: '2-digit',
});

const cfDash = 'https://dash.cloudflare.com';
---

<Base title="Cloudflare Status" description="Cloudflare service usage and free tier limits" noindex={true}>

	<div class="max-w-2xl mx-auto px-4 sm:px-6 pt-10 pb-24">

		<div class="flex items-start justify-between gap-4 mb-6">
			<div>
				<p class="text-xs font-semibold uppercase tracking-widest text-[var(--olive)] mb-1">Admin</p>
				<h1 class="font-display text-3xl font-semibold text-[var(--navy)] dark:text-white">Cloudflare Usage</h1>
			</div>
			<p class="text-xs text-[var(--ink)]/40 dark:text-white/30 mt-2 text-right">
				Refreshed<br />{refreshed}
			</p>
		</div>

		<div class="flex gap-3 mb-6">
			<a href="/course-admin" class="text-xs font-semibold text-[var(--navy)] dark:text-white bg-[var(--navy)]/6 dark:bg-white/8 hover:bg-[var(--navy)]/12 dark:hover:bg-white/12 rounded-lg px-3 py-1.5 transition-colors">
				Course Admin →
			</a>
			<a href="/stream-dashboard" class="text-xs font-semibold text-[var(--navy)] dark:text-white bg-[var(--navy)]/6 dark:bg-white/8 hover:bg-[var(--navy)]/12 dark:hover:bg-white/12 rounded-lg px-3 py-1.5 transition-colors">
				Stream Dashboard →
			</a>
		</div>

		{!hasApi && (
			<div class="mb-6 rounded-xl bg-[var(--red)]/8 border border-[var(--red)]/20 px-4 py-3">
				<p class="text-sm font-semibold text-[var(--red)] mb-1">CF API not connected — limit usage unknown</p>
				<p class="text-xs text-[var(--ink)]/65 dark:text-white/55">
					Add <code class="bg-[var(--navy)]/8 dark:bg-white/10 rounded px-1 py-0.5">CF_ACCOUNT_ID</code> and <code class="bg-[var(--navy)]/8 dark:bg-white/10 rounded px-1 py-0.5">CF_API_TOKEN</code> as Cloudflare dashboard Variables to see real usage vs limits.
					Token needs <em>Account Analytics → Read</em>.
				</p>
			</div>
		)}

		<div class="space-y-4">

			{/* ── Workers ───────────────────────────────────────────────────────── */}
			<div class="bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 overflow-hidden">
				<div class="flex items-center justify-between px-5 py-4 border-b border-[var(--navy)]/6 dark:border-white/6">
					<div class="flex items-center gap-2.5">
						<span class={`w-2 h-2 rounded-full shrink-0 ${statusDot(workersStats?.requests, 100_000)}`} />
						<div>
							<p class="font-semibold text-[var(--navy)] dark:text-white">Workers</p>
							<p class="text-xs text-[var(--ink)]/45 dark:text-white/40">family-church-website · today (UTC)</p>
						</div>
					</div>
					<a href={cfDash} target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-[var(--green)] hover:underline shrink-0">Dashboard →</a>
				</div>

				<div class="px-5 py-4 space-y-4">
					<div>
						<div class="flex justify-between items-baseline mb-1.5">
							<span class="text-xs font-semibold text-[var(--ink)]/60 dark:text-white/50">Requests today</span>
							<span class="text-sm font-semibold tabular-nums text-[var(--navy)] dark:text-white">
								{fmt(workersStats?.requests)} <span class="text-xs font-normal text-[var(--ink)]/40 dark:text-white/30">/ 100k</span>
							</span>
						</div>
						<div class="h-2 bg-[var(--navy)]/8 dark:bg-white/8 rounded-full overflow-hidden">
							<div class={`h-full rounded-full ${barColor(workersStats?.requests, 100_000)}`} style={`width:${pct(workersStats?.requests, 100_000)}%`} />
						</div>
					</div>

					<div class="grid grid-cols-3 gap-2 text-sm">
						<div class="bg-[var(--navy)]/4 dark:bg-white/5 rounded-xl px-3 py-2">
							<p class="text-[10px] font-bold uppercase tracking-widest text-[var(--olive)] mb-0.5">Errors</p>
							<p class="font-semibold tabular-nums text-[var(--navy)] dark:text-white">{fmt(workersStats?.errors)}</p>
						</div>
						<div class="bg-[var(--navy)]/4 dark:bg-white/5 rounded-xl px-3 py-2">
							<p class="text-[10px] font-bold uppercase tracking-widest text-[var(--olive)] mb-0.5">CPU p50</p>
							<p class="font-semibold tabular-nums text-[var(--navy)] dark:text-white">{fmtMs(workersStats?.cpuP50ms)}</p>
						</div>
						<div class={`rounded-xl px-3 py-2 ${workersStats && workersStats.cpuP99ms > 9 ? 'bg-[var(--red)]/10' : 'bg-[var(--navy)]/4 dark:bg-white/5'}`}>
							<p class="text-[10px] font-bold uppercase tracking-widest text-[var(--olive)] mb-0.5">CPU p99 <span class="font-normal normal-case tracking-normal opacity-60">/ 10ms</span></p>
							<p class={`font-semibold tabular-nums ${workersStats && workersStats.cpuP99ms > 9 ? 'text-[var(--red)]' : 'text-[var(--navy)] dark:text-white'}`}>{fmtMs(workersStats?.cpuP99ms)}</p>
						</div>
					</div>

					<p class="text-[10px] text-[var(--ink)]/30 dark:text-white/25">100k req/day · 10ms CPU/req · resets midnight UTC</p>
				</div>
			</div>

			{/* ── KV (combined) ─────────────────────────────────────────────────── */}
			<div class="bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 overflow-hidden">
				<div class="flex items-center justify-between px-5 py-4 border-b border-[var(--navy)]/6 dark:border-white/6">
					<div class="flex items-center gap-2.5">
						<span class={`w-2 h-2 rounded-full shrink-0 ${statusDot(kvStats?.total.write, 1_000)}`} />
						<div>
							<p class="font-semibold text-[var(--navy)] dark:text-white">Workers KV</p>
							<p class="text-xs text-[var(--ink)]/45 dark:text-white/40">LESSON_PROGRESS + STREAM_REPORTS · today</p>
						</div>
					</div>
					<a href={cfDash} target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-[var(--green)] hover:underline shrink-0">Dashboard →</a>
				</div>

				<div class="px-5 py-4 space-y-4">
					{/* Reads */}
					<div>
						<div class="flex justify-between items-baseline mb-1.5">
							<span class="text-xs font-semibold text-[var(--ink)]/60 dark:text-white/50">Reads today</span>
							<span class="text-sm font-semibold tabular-nums text-[var(--navy)] dark:text-white">
								{fmt(kvStats?.total.read)} <span class="text-xs font-normal text-[var(--ink)]/40 dark:text-white/30">/ 100k</span>
							</span>
						</div>
						<div class="h-2 bg-[var(--navy)]/8 dark:bg-white/8 rounded-full overflow-hidden">
							<div class={`h-full rounded-full ${barColor(kvStats?.total.read, 100_000)}`} style={`width:${pct(kvStats?.total.read, 100_000)}%`} />
						</div>
					</div>

					{/* Writes — tightest limit */}
					<div>
						<div class="flex justify-between items-baseline mb-1.5">
							<span class="text-xs font-semibold text-[var(--ink)]/60 dark:text-white/50">Writes today <span class="font-normal text-[var(--red)]/70">← tightest limit</span></span>
							<span class="text-sm font-semibold tabular-nums text-[var(--navy)] dark:text-white">
								{fmt(kvStats?.total.write)} <span class="text-xs font-normal text-[var(--ink)]/40 dark:text-white/30">/ 1k</span>
							</span>
						</div>
						<div class="h-2 bg-[var(--navy)]/8 dark:bg-white/8 rounded-full overflow-hidden">
							<div class={`h-full rounded-full ${barColor(kvStats?.total.write, 1_000)}`} style={`width:${pct(kvStats?.total.write, 1_000)}%`} />
						</div>
					</div>

					{/* Per-namespace breakdown */}
					<div class="grid grid-cols-2 gap-2">
						{Object.entries(KV_NS).map(([name, id]) => {
							const ns = kvStats?.byNamespace[id];
							return (
								<div class="bg-[var(--navy)]/4 dark:bg-white/5 rounded-xl px-3 py-2.5">
									<p class="text-[10px] font-bold uppercase tracking-widest text-[var(--olive)] mb-1.5">{name.replace('_', ' ')}</p>
									<div class="flex gap-3 text-xs tabular-nums text-[var(--navy)]/70 dark:text-white/60">
										<span><span class="font-semibold text-[var(--navy)] dark:text-white">{fmt(ns?.read ?? (hasApi ? 0 : null))}</span> reads</span>
										<span><span class="font-semibold text-[var(--navy)] dark:text-white">{fmt(ns?.write ?? (hasApi ? 0 : null))}</span> writes</span>
									</div>
									{name === 'LESSON_PROGRESS' && lessonKeys !== null && (
										<p class="text-[10px] text-[var(--ink)]/35 dark:text-white/25 mt-1">{lessonKeys.toLocaleString()} keys stored</p>
									)}
									{name === 'STREAM_REPORTS' && reportKeys !== null && (
										<p class="text-[10px] text-[var(--ink)]/35 dark:text-white/25 mt-1">{reportKeys.toLocaleString()} active keys · 7d TTL</p>
									)}
								</div>
							);
						})}
					</div>

					<p class="text-[10px] text-[var(--ink)]/30 dark:text-white/25">100k reads/day · 1k writes/day · 1 GB storage · limits are account-wide · reset midnight UTC</p>
				</div>
			</div>

			{/* ── Durable Objects ───────────────────────────────────────────────── */}
			<div class="bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 overflow-hidden">
				<div class="flex items-center justify-between px-5 py-4 border-b border-[var(--navy)]/6 dark:border-white/6">
					<div class="flex items-center gap-2.5">
						<span class="w-2 h-2 rounded-full shrink-0 bg-[var(--navy)]/20 dark:bg-white/15" />
						<div>
							<p class="font-semibold text-[var(--navy)] dark:text-white">Durable Objects — StreamMonitor</p>
							<p class="text-xs text-[var(--ink)]/45 dark:text-white/40">WebSocket hub for stream dashboard</p>
						</div>
					</div>
					<a href={cfDash} target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-[var(--green)] hover:underline shrink-0">Dashboard →</a>
				</div>
				<div class="px-5 py-4">
					<p class="text-xs text-[var(--ink)]/50 dark:text-white/40 mb-2">Only used during live streams. Check dashboard for request counts and compute duration.</p>
					<p class="text-[10px] text-[var(--ink)]/30 dark:text-white/25">Free: 5 GB SQLite storage · 1k req/s per object</p>
				</div>
			</div>

			{/* ── R2 ────────────────────────────────────────────────────────────── */}
			<div class="bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 overflow-hidden">
				<div class="flex items-center justify-between px-5 py-4 border-b border-[var(--navy)]/6 dark:border-white/6">
					<div class="flex items-center gap-2.5">
						<span class="w-2 h-2 rounded-full shrink-0 bg-[var(--navy)]/20 dark:bg-white/15" />
						<div>
							<p class="font-semibold text-[var(--navy)] dark:text-white">R2 — sermons</p>
							<p class="text-xs text-[var(--ink)]/45 dark:text-white/40">Sermon audio · audio.familychurch.online</p>
						</div>
					</div>
					<a href={cfDash} target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-[var(--green)] hover:underline shrink-0">Dashboard →</a>
				</div>
				<div class="px-5 py-4">
					<p class="text-xs text-[var(--ink)]/50 dark:text-white/40 mb-2">Accessed via S3 API from import scripts only — no Worker binding. Check the dashboard for storage and operation counts.</p>
					<p class="text-[10px] text-[var(--ink)]/30 dark:text-white/25">Free: 10 GB storage · 1M Class A ops/month · 10M Class B ops/month · no egress fees</p>
				</div>
			</div>

		</div>

		<p class="text-[10px] text-[var(--ink)]/25 dark:text-white/20 text-center mt-8">
			Workers + KV limits reset midnight UTC · R2 limits reset monthly
		</p>

	</div>

</Base>
