				<div class="flex items-center justify-between px-5 py-4 border-b border-[var(--navy)]/6 dark:border-white/6">
					<div class="flex items-center gap-2.5">
						<span class={`w-2 h-2 rounded-full shrink-0 ${statusDot(workersStats?.requests, 10_000_000)}`} />
						<div>
							<p class="font-semibold text-[var(--navy)] dark:text-white">Workers</p>
							<p class="text-xs text-[var(--ink)]/45 dark:text-white/40">Account-wide · {month}</p>
						</div>
					</div>
					<a href={cfDash} target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-[var(--green)] hover:underline shrink-0">Dashboard →</a>
				</div>
				<div class="px-5 py-4 space-y-4">
					<div>
						<div class="flex justify-between items-baseline mb-1.5">
							<span class="text-xs font-semibold text-[var(--ink)]/60 dark:text-white/50">Standard requests</span>
							<span class="text-sm font-semibold tabular-nums text-[var(--navy)] dark:text-white">{fmt(workersStats?.requests)} <span class="text-xs font-normal text-[var(--ink)]/40 dark:text-white/30">/ 10M</span></span>
						</div>
						<div class="h-2 bg-[var(--navy)]/8 dark:bg-white/8 rounded-full overflow-hidden">
							<div class={`h-full rounded-full ${barColor(workersStats?.requests, 10_000_000)}`} style={`width:${pct(workersStats?.requests, 10_000_000)}%`} />
						</div>
					</div>
					<div>
						<div class="flex justify-between items-baseline mb-1.5">
