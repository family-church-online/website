						<span class={`w-2 h-2 rounded-full shrink-0 ${statusDot(kvStats?.writes, 1_000_000)}`} />
						<div>
							<p class="font-semibold text-[var(--navy)] dark:text-white">Workers KV</p>
							<p class="text-xs text-[var(--ink)]/45 dark:text-white/40">Account-wide · {month}</p>
						</div>
					</div>
					<a href={cfDash} target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-[var(--green)] hover:underline shrink-0">Dashboard →</a>
				</div>
				<div class="px-5 py-4 space-y-4">
					<div>
						<div class="flex justify-between items-baseline mb-1.5">
							<span class="text-xs font-semibold text-[var(--ink)]/60 dark:text-white/50">Read operations</span>
							<span class="text-sm font-semibold tabular-nums text-[var(--navy)] dark:text-white">{fmt(kvStats?.reads)} <span class="text-xs font-normal text-[var(--ink)]/40 dark:text-white/30">/ 10M</span></span>
						</div>
						<div class="h-2 bg-[var(--navy)]/8 dark:bg-white/8 rounded-full overflow-hidden">
