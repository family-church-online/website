---
export const prerender = false;

// Only visible on Sundays (Africa/Johannesburg = UTC+2).
// Add ?preview to the URL to bypass on other days (for prep / testing).
const saDate = new Date(new Date().toLocaleString('en-US', { timeZone: 'Africa/Johannesburg' }));
const isSunday = saDate.getDay() === 0;
const isPreview = Astro.url.searchParams.has('preview');

if (!isSunday && !isPreview) {
	return new Response(null, { status: 404 });
}

interface Frontmatter {
	title?: string;
	date?: string;
	speaker?: string;
	series?: string;
	image?: string;
}

const mods = import.meta.glob<{ frontmatter: Frontmatter; default: any }>(
	'../content/sermon-notes/current.mdx',
	{ eager: true }
);
const mod = Object.values(mods)[0] ?? {};
const fm: Frontmatter = mod.frontmatter ?? {};
const Content: any = mod.default;

const dateStr = fm.date
	? new Date(fm.date).toLocaleDateString('en-ZA', {
			weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
	  })
	: saDate.toLocaleDateString('en-ZA', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });

---

<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{fm.title ?? 'Sermon Notes'} · Family Church</title>
	<meta name="robots" content="noindex, nofollow" />
	<style>
		*, *::before, *::after { box-sizing: border-box; }

		body {
			margin: 0;
			font-family: Georgia, 'Times New Roman', serif;
			background: #fff;
			color: #14202f;
			font-size: 16px;
			line-height: 1.7;
		}

		.page {
			max-width: 680px;
			margin: 0 auto;
			padding: 2rem 1.5rem 4rem;
		}

		/* ── Header ── */
		.church-name {
			font-family: system-ui, sans-serif;
			font-size: 0.7rem;
			font-weight: 700;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: #8f926b;
			margin: 0 0 2rem;
		}

		.sermon-image {
			width: 100%;
			max-height: 280px;
			object-fit: cover;
			border-radius: 0.75rem;
			margin-bottom: 1.5rem;
		}

		.series-label {
			font-family: system-ui, sans-serif;
			font-size: 0.7rem;
			font-weight: 700;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: #8f926b;
			margin: 0 0 0.5rem;
		}

		h1 {
			font-family: system-ui, sans-serif;
			font-size: 1.75rem;
			font-weight: 700;
			line-height: 1.2;
			margin: 0 0 0.75rem;
			color: #273f61;
		}

		.meta {
			font-family: system-ui, sans-serif;
			font-size: 0.85rem;
			color: #14202f99;
			margin-bottom: 2rem;
			display: flex;
			gap: 0.4rem;
			flex-wrap: wrap;
			align-items: center;
		}
		.meta .sep { color: #14202f40; }

		hr { border: none; border-top: 1px solid #e5e7eb; margin: 1.5rem 0 2rem; }

		/* ── Notes prose ── */
		.notes h1 { font-size: 1.3rem; margin: 1.5rem 0 0.5rem; color: #273f61; }
		.notes h2 { font-family: system-ui, sans-serif; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #8f926b; margin: 2rem 0 0.75rem; }
		.notes h3 { font-family: system-ui, sans-serif; font-size: 1rem; font-weight: 700; margin: 1.25rem 0 0.4rem; color: #273f61; }
		.notes p  { margin: 0 0 1rem; }
		.notes ul { margin: 0 0 1rem; padding-left: 1.5rem; }
		.notes li { margin-bottom: 0.3rem; }
		.notes strong { font-weight: 700; color: #273f61; }
		.notes em { font-style: italic; }
		.notes code { font-family: monospace; font-size: 0.9em; background: #f3f4f6; padding: 0.1em 0.3em; border-radius: 3px; }
		.notes-empty { color: #14202f60; font-style: italic; font-family: system-ui, sans-serif; font-size: 0.9rem; }

		/* ── Print button ── */
		.print-btn {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			font-family: system-ui, sans-serif;
			font-size: 0.8rem;
			font-weight: 600;
			background: #273f61;
			color: #fff;
			border: none;
			border-radius: 0.5rem;
			padding: 0.5rem 1rem;
			cursor: pointer;
		}
		.print-btn:hover { background: #92c423; }

		/* ── Action buttons ── */
		.action-btns {
			display: flex;
			gap: 0.75rem;
			flex-wrap: wrap;
			margin-top: 2.5rem;
		}

		.share-btn {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			font-family: system-ui, sans-serif;
			font-size: 0.8rem;
			font-weight: 600;
			background: #92c423;
			color: #fff;
			border: none;
			border-radius: 0.5rem;
			padding: 0.5rem 1rem;
			cursor: pointer;
		}
		.share-btn:hover { background: #7aab1a; }

		/* ── Toast ── */
		.toast {
			position: fixed;
			bottom: 1.5rem;
			left: 50%;
			transform: translateX(-50%) translateY(4rem);
			background: #273f61;
			color: #fff;
			font-family: system-ui, sans-serif;
			font-size: 0.85rem;
			font-weight: 600;
			padding: 0.6rem 1.25rem;
			border-radius: 2rem;
			opacity: 0;
			transition: opacity 0.2s, transform 0.2s;
			pointer-events: none;
		}
		.toast.show {
			opacity: 1;
			transform: translateX(-50%) translateY(0);
		}

		/* ── Print styles ── */
		@media print {
			.action-btns { display: none; }
			.page { padding: 0; max-width: 100%; }
			body { font-size: 14px; }
			h1 { font-size: 1.4rem; }
		}
	</style>
</head>
<body>
	<div class="page">
		<p class="church-name">Family Church</p>

		{fm.image && <img src={fm.image} alt={fm.title ?? ''} class="sermon-image" />}

		{fm.series && <p class="series-label">{fm.series}</p>}
		<h1>{fm.title ?? 'Sermon Notes'}</h1>

		<div class="meta">
			<span>{dateStr}</span>
			{fm.speaker && <><span class="sep">·</span><span>{fm.speaker}</span></>}
		</div>

		<hr />

		<div class="notes">
			{Content
				? <Content />
				: <p class="notes-empty">Notes will appear here before the service.</p>
			}
		</div>

		<div class="action-btns">
			<button class="print-btn" onclick="window.print()">
				Save as PDF / Print
			</button>
			<button class="share-btn" id="share-btn">
				Share / Copy
			</button>
		</div>
	</div>

	<div id="copy-toast" class="toast">Copied to clipboard</div>
</body>
<script>
function showToast() {
	const toast = document.getElementById('copy-toast');
	if (!toast) return;
	toast.classList.add('show');
	setTimeout(() => toast.classList.remove('show'), 2500);
}

function copyFallback(text: string) {
	const el = document.createElement('textarea');
	el.value = text;
	el.style.cssText = 'position:fixed;top:0;left:0;opacity:0;pointer-events:none';
	document.body.appendChild(el);
	el.focus();
	el.select();
	try { document.execCommand('copy'); showToast(); } catch {}
	document.body.removeChild(el);
}

const btn = document.getElementById('share-btn');
btn?.addEventListener('click', async () => {
	const title = document.querySelector('h1')?.textContent ?? 'Sermon Notes';
	const meta  = document.querySelector('.meta')?.textContent?.trim() ?? '';
	const notes = (document.querySelector('.notes') as HTMLElement)?.innerText?.trim() ?? '';
	const text  = `${title}\n${meta}\n\n${notes}`;

	if (navigator.share) {
		try { await navigator.share({ title, text }); return; } catch {}
	}
	try {
		await navigator.clipboard.writeText(text);
		showToast();
	} catch {
		copyFallback(text);
	}
});
</script>
</html>
