---
export const prerender = false;

// Only visible on Sundays (Africa/Johannesburg = UTC+2).
// Add ?preview to the URL to bypass on other days (for prep / testing).
const saDate    = new Date(new Date().toLocaleString('en-US', { timeZone: 'Africa/Johannesburg' }));
const isSunday  = saDate.getDay() === 0;
const isPreview = Astro.url.searchParams.has('preview');

interface Frontmatter { title?: string; date?: string; speaker?: string; series?: string; image?: string; }
const _mods = import.meta.glob<{ frontmatter: Frontmatter; default: any }>(
	'../content/sermon-notes/current.mdx',
	{ eager: true }
);
const _mod = Object.values(_mods)[0] ?? {};
const _fm: Frontmatter = _mod.frontmatter ?? {};

const nextSunday = new Date(saDate);
nextSunday.setDate(saDate.getDate() + ((7 - saDate.getDay()) % 7 || 7));
const nextSundayStr = nextSunday.toLocaleDateString('en-ZA', {
	weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Africa/Johannesburg',
});

if (!import.meta.env.DEV && !isSunday && !isPreview) {
	const html = `<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Sermon Notes · Family Church</title>
<meta name="robots" content="noindex, nofollow" />
<style>
*, *::before, *::after { box-sizing: border-box; }
body { margin: 0; font-family: system-ui, sans-serif; background: #fff; color: #14202f; display: flex; min-height: 100dvh; align-items: center; justify-content: center; padding: 2rem 1.5rem; }
.dark body { background: #111827; color: #d1d9e0; }
.wrap { max-width: 420px; text-align: center; }
.label { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #8f926b; margin: 0 0 1.5rem; }
.dark .label { color: #b4b87e; }
h1 { font-size: 1.5rem; font-weight: 700; color: #273f61; margin: 0 0 0.75rem; line-height: 1.2; }
.dark h1 { color: #93b4d8; }
p { font-size: 0.95rem; color: #14202f99; margin: 0 0 1.75rem; line-height: 1.6; }
.dark p { color: #8a9db5; }
.next { display: inline-block; font-size: 0.8rem; font-weight: 600; color: #8f926b; background: #f5f5ee; border-radius: 2rem; padding: 0.4rem 1rem; margin-bottom: 1.75rem; }
.dark .next { color: #b4b87e; background: #1e2a38; }
a { display: inline-block; font-size: 0.85rem; font-weight: 600; color: #fff; background: #273f61; border-radius: 0.5rem; padding: 0.55rem 1.25rem; text-decoration: none; }
a:hover { background: #92c423; }
.theme-btn { position: fixed; top: 1rem; right: 1rem; background: none; border: 1px solid #e5e7eb; border-radius: 0.5rem; padding: 0.4rem; cursor: pointer; color: #273f61; display: flex; }
.dark .theme-btn { border-color: #2a3344; color: #93b4d8; }
.theme-btn:hover { background: #f3f4f6; }
.dark .theme-btn:hover { background: #1e2a38; }
.theme-btn .icon-sun { display: none; }
.theme-btn .icon-moon { display: block; }
.dark .theme-btn .icon-sun { display: block; }
.dark .theme-btn .icon-moon { display: none; }
</style>
<script>
(function(){var t=localStorage.getItem('theme');if(t==='dark'||(!t&&window.matchMedia('(prefers-color-scheme: dark)').matches))document.documentElement.classList.add('dark');})();
</script>
</head>
<body>
<button class="theme-btn" id="theme-btn" aria-label="Toggle colour theme">
  <svg class="icon-sun" width="18" height="18" viewBox="0 0 256 256" fill="currentColor"><path d="M120,40V16a8,8,0,0,1,16,0V40a8,8,0,0,1-16,0Zm72,88a64,64,0,1,1-64-64A64.07,64.07,0,0,1,192,128Zm-16,0a48,48,0,1,0-48,48A48.05,48.05,0,0,0,176,128ZM58.34,69.66A8,8,0,0,0,69.66,58.34l-16-16A8,8,0,0,0,42.34,53.66Zm0,116.68-16,16a8,8,0,0,0,11.32,11.32l16-16a8,8,0,0,0-11.32-11.32ZM192,72a8,8,0,0,0,5.66-2.34l16-16a8,8,0,0,0-11.32-11.32l-16,16A8,8,0,0,0,192,72Zm5.66,114.34a8,8,0,0,0-11.32,11.32l16,16a8,8,0,0,0,11.32-11.32ZM48,128a8,8,0,0,0-8-8H16a8,8,0,0,0,0,16H40A8,8,0,0,0,48,128Zm80,80a8,8,0,0,0-8,8v24a8,8,0,0,0,16,0V216A8,8,0,0,0,128,208Zm112-88H216a8,8,0,0,0,0,16h24a8,8,0,0,0,0-16Z"/></svg>
  <svg class="icon-moon" width="18" height="18" viewBox="0 0 256 256" fill="currentColor"><path d="M233.54,142.23a8,8,0,0,0-8-2,88.08,88.08,0,0,1-109.8-109.8,8,8,0,0,0-10-10,104.84,104.84,0,0,0-52.91,37A104,104,0,0,0,136,224a103.09,103.09,0,0,0,62.52-20.88,104.84,104.84,0,0,0,37-52.91A8,8,0,0,0,233.54,142.23ZM188.9,190.34A88,88,0,0,1,65.66,67.11a89,89,0,0,1,31.4-26A106,106,0,0,0,96,56,104.11,104.11,0,0,0,200,160a106,106,0,0,0,14.92-1.06A89,89,0,0,1,188.9,190.34Z"/></svg>
</button>
<div class="wrap">
<p class="label">Family Church</p>
<h1>Sermon Notes</h1>
<p>Sermon notes are available on Sunday mornings during our live service.</p>
<p class="next">Next Sunday: ${nextSundayStr}</p><br/>
<a href="https://familychurch.online">Back to the website</a>
</div>
<script>
document.getElementById('theme-btn').addEventListener('click',function(){var d=document.documentElement.classList.toggle('dark');localStorage.setItem('theme',d?'dark':'light');});
</script>
</body>
</html>`;
	return new Response(html, { status: 200, headers: { 'Content-Type': 'text/html; charset=utf-8' } });
}

const fm = _fm;
const Content: any = _mod.default;

// TinaCMS datetime fields are auto-parsed to Date objects by Astro's YAML parser.
// Pass directly to new Date() and format in SA timezone — never call .slice() on the value.
const dateStr = fm.date
	? new Date(fm.date as string).toLocaleDateString('en-ZA', {
			weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Africa/Johannesburg',
	  })
	: saDate.toLocaleDateString('en-ZA', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });

---

<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{fm.title ?? 'Sermon Notes'} · Family Church</title>
	<meta name="robots" content="noindex, nofollow" />
	<script is:inline>
		(function(){var t=localStorage.getItem('theme');if(t==='dark'||(!t&&window.matchMedia('(prefers-color-scheme: dark)').matches))document.documentElement.classList.add('dark');})();
	</script>
	<style>
		*, *::before, *::after { box-sizing: border-box; }

		body {
			margin: 0;
			font-family: Georgia, 'Times New Roman', serif;
			background: #fff;
			color: #14202f;
			font-size: 16px;
			line-height: 1.7;
		}

		.page {
			max-width: 680px;
			margin: 0 auto;
			padding: 2rem 1.5rem 4rem;
		}

		/* ── Header ── */
		.church-name {
			font-family: system-ui, sans-serif;
			font-size: 0.7rem;
			font-weight: 700;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: #8f926b;
			margin: 0 0 2rem;
		}

		.sermon-image-wrap {
			border-radius: 0.75rem;
			overflow: hidden;
			max-height: 280px;
			margin-bottom: 1.5rem;
		}

		.sermon-image {
			width: 100%;
			height: 280px;
			object-fit: cover;
			display: block;
			transform: scale(1.06);
		}

		.series-label {
			font-family: system-ui, sans-serif;
			font-size: 0.7rem;
			font-weight: 700;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: #8f926b;
			margin: 0 0 0.5rem;
		}

		h1 {
			font-family: system-ui, sans-serif;
			font-size: 1.75rem;
			font-weight: 700;
			line-height: 1.2;
			margin: 0 0 0.75rem;
			color: #273f61;
		}

		.meta {
			font-family: system-ui, sans-serif;
			font-size: 0.85rem;
			color: #14202f99;
			margin-bottom: 2rem;
			display: flex;
			gap: 0.4rem;
			flex-wrap: wrap;
			align-items: center;
		}
		.meta .sep { color: #14202f40; }

		hr { border: none; border-top: 1px solid #e5e7eb; margin: 1.5rem 0 2rem; }

		/* ── Notes prose ── */
		.notes h1 { font-size: 1.3rem; margin: 1.5rem 0 0.5rem; color: #273f61; }
		.notes h2 { font-family: system-ui, sans-serif; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #8f926b; margin: 2rem 0 0.75rem; }
		.notes h3 { font-family: system-ui, sans-serif; font-size: 1rem; font-weight: 700; margin: 1.25rem 0 0.4rem; color: #273f61; }
		.notes p  { margin: 0 0 1rem; }
		.notes ul { margin: 0 0 1rem; padding-left: 1.5rem; }
		.notes li { margin-bottom: 0.3rem; }
		.notes strong { font-weight: 700; color: #273f61; }
		.notes em { font-style: italic; }
		.notes code { font-family: monospace; font-size: 0.9em; background: #f3f4f6; padding: 0.1em 0.3em; border-radius: 3px; }
		.notes-empty { color: #14202f60; font-style: italic; font-family: system-ui, sans-serif; font-size: 0.9rem; }

		/* ── Print button ── */
		.print-btn {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			font-family: system-ui, sans-serif;
			font-size: 0.8rem;
			font-weight: 600;
			background: #273f61;
			color: #fff;
			border: none;
			border-radius: 0.5rem;
			padding: 0.5rem 1rem;
			cursor: pointer;
		}
		.print-btn:hover { background: #92c423; }

		/* ── Action buttons ── */
		.action-btns {
			display: flex;
			gap: 0.75rem;
			flex-wrap: wrap;
			margin-top: 2.5rem;
		}

		.share-btn {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			font-family: system-ui, sans-serif;
			font-size: 0.8rem;
			font-weight: 600;
			background: #92c423;
			color: #fff;
			border: none;
			border-radius: 0.5rem;
			padding: 0.5rem 1rem;
			cursor: pointer;
		}
		.share-btn:hover { background: #7aab1a; }

		/* ── Toast ── */
		.toast {
			position: fixed;
			bottom: 1.5rem;
			left: 50%;
			transform: translateX(-50%) translateY(4rem);
			background: #273f61;
			color: #fff;
			font-family: system-ui, sans-serif;
			font-size: 0.85rem;
			font-weight: 600;
			padding: 0.6rem 1.25rem;
			border-radius: 2rem;
			opacity: 0;
			transition: opacity 0.2s, transform 0.2s;
			pointer-events: none;
		}
		.toast.show {
			opacity: 1;
			transform: translateX(-50%) translateY(0);
		}

		/* ── Print styles ── */
		@media print {
			.action-btns { display: none; }
			.page { padding: 0; max-width: 100%; }
			body { font-size: 14px; }
			h1 { font-size: 1.4rem; }
			.theme-toggle { display: none; }
		}

		/* ── Dark mode ── */
		html.dark body { background: #111827; color: #d1d9e0; }
		html.dark .church-name { color: #b4b87e; }
		html.dark .series-label { color: #b4b87e; }
		html.dark h1 { color: #93b4d8; }
		html.dark .meta { color: #8a9db5; }
		html.dark .meta .sep { color: #2a3344; }
		html.dark hr { border-color: #2a3344; }
		html.dark .notes h1 { color: #93b4d8; }
		html.dark .notes h2 { color: #b4b87e; }
		html.dark .notes h3 { color: #93b4d8; }
		html.dark .notes strong { color: #b8ceea; }
		html.dark .notes code { background: #1e2a38; color: #d1d9e0; }
		html.dark .notes-empty { color: #4a5a6a; }
		html.dark .print-btn { background: #1e3a5f; }
		html.dark .print-btn:hover { background: #92c423; }

		/* ── Theme toggle button ── */
		.theme-toggle {
			position: fixed;
			top: 1rem;
			right: 1rem;
			background: none;
			border: 1px solid #e5e7eb;
			border-radius: 0.5rem;
			padding: 0.4rem;
			cursor: pointer;
			color: #273f61;
			display: flex;
			line-height: 0;
		}
		html.dark .theme-toggle { border-color: #2a3344; color: #93b4d8; }
		.theme-toggle:hover { background: #f3f4f6; }
		html.dark .theme-toggle:hover { background: #1e2a38; }
		.theme-toggle .icon-sun { display: none; }
		.theme-toggle .icon-moon { display: block; }
		html.dark .theme-toggle .icon-sun { display: block; }
		html.dark .theme-toggle .icon-moon { display: none; }
	</style>
</head>
<body>
	<button class="theme-toggle" id="theme-toggle" aria-label="Toggle colour theme">
		<svg class="icon-sun" width="18" height="18" viewBox="0 0 256 256" fill="currentColor"><path d="M120,40V16a8,8,0,0,1,16,0V40a8,8,0,0,1-16,0Zm72,88a64,64,0,1,1-64-64A64.07,64.07,0,0,1,192,128Zm-16,0a48,48,0,1,0-48,48A48.05,48.05,0,0,0,176,128ZM58.34,69.66A8,8,0,0,0,69.66,58.34l-16-16A8,8,0,0,0,42.34,53.66Zm0,116.68-16,16a8,8,0,0,0,11.32,11.32l16-16a8,8,0,0,0-11.32-11.32ZM192,72a8,8,0,0,0,5.66-2.34l16-16a8,8,0,0,0-11.32-11.32l-16,16A8,8,0,0,0,192,72Zm5.66,114.34a8,8,0,0,0-11.32,11.32l16,16a8,8,0,0,0,11.32-11.32ZM48,128a8,8,0,0,0-8-8H16a8,8,0,0,0,0,16H40A8,8,0,0,0,48,128Zm80,80a8,8,0,0,0-8,8v24a8,8,0,0,0,16,0V216A8,8,0,0,0,128,208Zm112-88H216a8,8,0,0,0,0,16h24a8,8,0,0,0,0-16Z"/></svg>
		<svg class="icon-moon" width="18" height="18" viewBox="0 0 256 256" fill="currentColor"><path d="M233.54,142.23a8,8,0,0,0-8-2,88.08,88.08,0,0,1-109.8-109.8,8,8,0,0,0-10-10,104.84,104.84,0,0,0-52.91,37A104,104,0,0,0,136,224a103.09,103.09,0,0,0,62.52-20.88,104.84,104.84,0,0,0,37-52.91A8,8,0,0,0,233.54,142.23ZM188.9,190.34A88,88,0,0,1,65.66,67.11a89,89,0,0,1,31.4-26A106,106,0,0,0,96,56,104.11,104.11,0,0,0,200,160a106,106,0,0,0,14.92-1.06A89,89,0,0,1,188.9,190.34Z"/></svg>
	</button>

	<div class="page">
		<p class="church-name">Family Church</p>

		{fm.image && <div class="sermon-image-wrap"><img src={fm.image} alt={fm.title ?? ''} class="sermon-image" /></div>}

		{fm.series && <p class="series-label">{fm.series}</p>}
		<h1>{fm.title ?? 'Sermon Notes'}</h1>

		<div class="meta">
			<span>{dateStr}</span>
			{fm.speaker && <><span class="sep">·</span><span>{fm.speaker}</span></>}
		</div>

		<hr />

		<div class="notes">
			{Content
				? <Content />
				: <p class="notes-empty">Notes will appear here before the service.</p>
			}
		</div>

		<div class="action-btns">
			<button class="print-btn" onclick="window.print()">
				Save as PDF / Print
			</button>
			<button class="share-btn" id="share-btn">
				Share / Copy
			</button>
		</div>
	</div>

	<div id="copy-toast" class="toast">Copied to clipboard</div>
</body>
<script>
document.getElementById('theme-toggle')?.addEventListener('click', () => {
	const isDark = document.documentElement.classList.toggle('dark');
	localStorage.setItem('theme', isDark ? 'dark' : 'light');
});

function showToast() {
	const toast = document.getElementById('copy-toast');
	if (!toast) return;
	toast.classList.add('show');
	setTimeout(() => toast.classList.remove('show'), 2500);
}

function copyFallback(text: string) {
	const el = document.createElement('textarea');
	el.value = text;
	el.style.cssText = 'position:fixed;top:0;left:0;opacity:0;pointer-events:none';
	document.body.appendChild(el);
	el.focus();
	el.select();
	try { document.execCommand('copy'); showToast(); } catch {}
	document.body.removeChild(el);
}

const btn = document.getElementById('share-btn');
btn?.addEventListener('click', async () => {
	const title = document.querySelector('h1')?.textContent ?? 'Sermon Notes';
	const meta  = document.querySelector('.meta')?.textContent?.trim() ?? '';
	const notes = (document.querySelector('.notes') as HTMLElement)?.innerText?.trim() ?? '';
	const text  = `${title}\n${meta}\n\n${notes}`;

	if (navigator.share) {
		try { await navigator.share({ title, text }); return; } catch {}
	}
	try {
		await navigator.clipboard.writeText(text);
		showToast();
	} catch {
		copyFallback(text);
	}
});
</script>
</html>
