---
export const prerender = true;

import Base from '../../layouts/Base.astro';
import { getConfig } from '../../lib/data';

const config    = (await getConfig()).data?.config ?? null;
const siteTitle = config?.seo?.title ?? 'Family Church';

const groups = [
	{
		href: '/kids-church/pre-school',
		label: 'Pre-School',
		ages: 'Ages 3 – 5',
		color: 'var(--green)',
	},
	{
		href: '/kids-church/junior',
		label: 'Junior',
		ages: 'Ages 6 – 9',
		color: 'var(--navy)',
	},
	{
		href: '/kids-church/senior',
		label: 'Senior',
		ages: 'Ages 10 – 12',
		color: 'var(--olive)',
	},
];
---

<Base title={`Kids Church · ${siteTitle}`} description="Weekly lessons for children at Family Church — Pre-School, Junior, and Senior groups.">

	<div class="max-w-[var(--content-width)] mx-auto px-4 sm:px-6 pt-12 pb-4 text-center">
		<p class="text-xs font-semibold uppercase tracking-widest text-[var(--olive)] mb-2">Ministry</p>
		<h1 class="font-display text-4xl font-semibold mb-3">Kids Church</h1>
		<p class="text-[var(--ink)]/55 dark:text-white/50 text-sm max-w-sm mx-auto">
			Weekly lessons for children. Choose your age group below.
		</p>
	</div>

	<main class="max-w-[var(--content-width)] mx-auto px-4 sm:px-6 py-10">
		<div class="grid gap-4 sm:grid-cols-3">
			{groups.map(g => (
				<a
					href={g.href}
					class="group flex flex-col items-center justify-center gap-3 rounded-2xl px-6 py-10 bg-white dark:bg-[var(--card)] shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 hover:shadow-lg transition-all no-underline"
				>
					<div
						class="w-14 h-14 rounded-full flex items-center justify-center text-white text-xl font-bold shadow-sm"
						style={`background: ${g.color}`}
					>
						{g.label[0]}
					</div>
					<div class="text-center">
						<p class="font-display text-xl font-semibold text-[var(--navy)] dark:text-white group-hover:text-[var(--green)] transition-colors">
							{g.label}
						</p>
						<p class="text-xs text-[var(--ink)]/45 dark:text-white/40 mt-0.5">{g.ages}</p>
					</div>
					<svg class="w-4 h-4 text-[var(--navy)]/25 group-hover:text-[var(--green)] transition-colors mt-1" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
						<path d="M7 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
				</a>
			))}
		</div>
	</main>

</Base>
