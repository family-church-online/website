---
export const prerender = true;

import Base from '../../../layouts/Base.astro';
import LessonCard from '../../../components/ministry/LessonCard.astro';
import { getConfig } from '../../../lib/data';

interface Frontmatter { title?: string; date?: string; scripture?: string; }

const mods = import.meta.glob<{ frontmatter: Frontmatter }>(
	'../../../content/kids/senior/*.mdx',
	{ eager: true },
);

const lessons = Object.entries(mods)
	.map(([path, mod]) => ({
		...mod.frontmatter,
		date: path.replace('../../../content/kids/senior/', '').replace('.mdx', ''),
	}))
	.sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));

const config       = (await getConfig()).data?.config ?? null;
const siteTitle    = config?.seo?.title ?? 'Family Church';
const kc           = (config as any)?.kidsChurch ?? {};
const ministryName = kc.ministryName ?? 'Kids Church';
const groupLabel   = kc.seniorLabel ?? 'Senior';
const groupAges    = kc.seniorAges ?? '';
---

<Base title={`${ministryName} — ${groupLabel} · ${siteTitle}`} description={`Weekly lessons for ${groupLabel} children from Family Church.`}>
	<div class="reveal max-w-[var(--content-width)] mx-auto px-4 sm:px-6 pt-10 pb-4 text-center">
		<p class="text-xs font-semibold uppercase tracking-widest text-[var(--olive)] mb-3">{ministryName}</p>
		<h1 class="font-display text-4xl font-semibold lg:text-5xl text-balance mb-2">{groupLabel}</h1>
		{groupAges && <p class="text-[var(--ink)]/55 dark:text-white/50 text-sm">{groupAges}</p>}
	</div>

	<main class="max-w-[var(--content-width)] mx-auto px-4 sm:px-6 py-8">
		{lessons.length === 0 ? (
			<p class="text-[var(--ink)]/50 dark:text-white/40 text-sm">No lessons published yet.</p>
		) : (
			<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
				{lessons.map(l => (
					<LessonCard href={`/kids-church/senior/${l.date}`} date={l.date} title={l.title} scripture={l.scripture} />
				))}
			</div>
		)}
	</main>
</Base>
