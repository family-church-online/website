---
export const prerender = false;

// Compute SA time (UTC+2) at request time so the redirect is always current.
// On Workers, this runs in the edge worker — no Pages Function needed.
const saNow   = new Date(Date.now() + 2 * 60 * 60 * 1000);
const dateKey = saNow.toISOString().split('T')[0];

return Astro.redirect(`/devotion/${dateKey}`, 302);
---
