---
import Base from '../layouts/Base.astro';
import { getConfig, getStatementOfFaith } from '../lib/data';

const config    = (await getConfig()).data?.config ?? null;
const siteTitle = config?.seo?.title ?? 'Family Church';

const sofData   = (await getStatementOfFaith()).data?.statementOfFaith;
const articles  = (sofData?.articles ?? []).filter(Boolean) as Array<{
  number: number;
  title: string;
  summary: string;
  statement: string;
  scriptures: string[];
}>;

---

<Base
  title={`Statement of Faith · ${siteTitle}`}
  description="What we believe — twelve articles covering Scripture, God, Creation, Christ, salvation, the Church, and the last things."
>

  {/* ── PAGE HEADER ────────────────────────────────────────────────────────── */}
  <div class="max-w-[var(--content-width)] mx-auto px-4 sm:px-6 pt-10 pb-8 text-center">
    <p class="text-xs font-semibold uppercase tracking-widest text-[var(--olive)] mb-3">Family Church</p>
    <h1 class="font-display text-4xl font-semibold lg:text-5xl text-balance mb-4">Statement of Faith</h1>
    <p class="text-lg text-muted-foreground max-w-xl mx-auto leading-relaxed">
      Twelve articles summarising what we believe. Tap any article to read the full statement and Scripture references.
    </p>
  </div>

  {/* ── ARTICLES ───────────────────────────────────────────────────────────── */}
  <main class="max-w-[var(--content-width)] mx-auto px-4 sm:px-6 py-10 pb-24">
    <ol class="space-y-4 list-none p-0">
      {articles.map((a, i) => (
        <li class="reveal" data-reveal-delay={String((i % 5) * 0.05)}>
          <details class="group space-y-3">

            {/* Summary — its own card */}
            <summary class="flex items-start gap-4 px-6 py-5 bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 hover:shadow-md transition-shadow cursor-pointer select-none list-none marker:hidden [&::-webkit-details-marker]:hidden">
              {/* Number badge */}
              <span class="shrink-0 mt-0.5 w-8 h-8 rounded-full bg-[var(--navy)] group-open:bg-[var(--green)] flex items-center justify-center text-xs font-bold text-white tabular-nums transition-colors">
                {a.number}
              </span>

              {/* Title + summary */}
              <div class="flex-1 min-w-0">
                <h2 class="text-base font-semibold text-[var(--navy)] dark:text-white mb-2 group-open:text-[var(--green)] transition-colors">
                  {a.title}
                </h2>
                <p class="text-sm text-[var(--ink)]/75 dark:text-white/80 leading-relaxed">
                  {a.summary}
                </p>
              </div>

              {/* Chevron */}
              <svg
                class="shrink-0 mt-1.5 w-4 h-4 text-[var(--navy)]/30 dark:text-white/30 transition-transform duration-200 group-open:rotate-180 group-open:text-[var(--green)]"
                viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"
                aria-hidden="true"
              >
                <path d="M5 8l5 5 5-5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>

            {/* Full statement — separate card */}
            <div class="statement-card rounded-2xl px-6 py-5">
              <p class="text-xs font-bold uppercase tracking-widest text-[var(--olive)] mb-3">Full Statement</p>
              <p class="text-sm text-[var(--ink)]/80 dark:text-white/75 leading-relaxed">{a.statement}</p>
            </div>

            {/* Scripture references — separate card */}
            <div class="scripture-card rounded-2xl px-6 py-5">
              <p class="text-xs font-bold uppercase tracking-widest text-[var(--olive)] mb-3">Scripture Sources</p>
              <ol class="space-y-2 list-none p-0">
                {a.scriptures.map((group, i) => (
                  <li class="flex gap-2 text-xs text-[var(--ink)]/60 dark:text-white/55 leading-relaxed">
                    <span class="shrink-0 font-semibold text-[var(--olive)] tabular-nums">{i + 1}.</span>
                    <span>{group}</span>
                  </li>
                ))}
              </ol>
            </div>

          </details>
        </li>
      ))}
    </ol>
  </main>

</Base>

<style>
.statement-card {
  background-color: #e6ecf4;
}
.scripture-card {
  background-color: #edf5d6;
}
:global(.dark) .statement-card {
  background-color: rgba(39, 63, 97, 0.45);
}
:global(.dark) .scripture-card {
  background-color: rgba(146, 196, 35, 0.20);
}
</style>
