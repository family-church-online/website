---
export const prerender = true;

const BUTTONS = ['No Sound', 'Low Volume', 'Sound Quality', 'No Picture', 'Picture Quality'];

// Tabler icons (24×24 viewBox, stroke-based) — SVG inner HTML per button
const ICONS: Record<string, string> = {
	'No Sound':       `<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 8a5 5 0 0 1 1.912 4.934m-1.377 2.602A5 5 0 0 1 15 16m2.7-11a9 9 0 0 1 2.362 11.086m-1.676 2.299A9 9 0 0 1 17.7 19M9.069 5.054L9.5 4.5A.8.8 0 0 1 11 5v2m0 4v8a.8.8 0 0 1-1.5.5L6 15H4a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1h2l1.294-1.664M3 3l18 18"/>`,
	'Low Volume':     `<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 8a5 5 0 0 1 0 8m-9-1H4a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1h2l3.5-4.5A.8.8 0 0 1 11 5v14a.8.8 0 0 1-1.5.5z"/>`,
	'Sound Quality':  `<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12h-2c-.894 0-1.662-.857-1.761-2c-.296-3.45-.749-6-2.749-6s-2.5 3.582-2.5 8s-.5 8-2.5 8s-2.452-2.547-2.749-6c-.1-1.147-.867-2-1.763-2h-2"/>`,
	'No Picture':     `<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m3 3l18 18m-6-10v-1l4.553-2.276A1 1 0 0 1 21 8.618v6.764a1 1 0 0 1-.675.946"/><path d="M10 6h3a2 2 0 0 1 2 2v3m0 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h1"/></g>`,
	'Picture Quality':`<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M15 8h.01M6 13l2.644-2.644a1.21 1.21 0 0 1 1.712 0L14 14"/><path d="m13 13l1.644-1.644a1.21 1.21 0 0 1 1.712 0L18 13M3 7V5a2 2 0 0 1 2-2h2M3 17v2a2 2 0 0 0 2 2h2M17 3h2a2 2 0 0 1 2 2v2m-4 14h2a2 2 0 0 0 2-2v-2"/></g>`,
};
---

<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Stream Monitor · Family Church</title>
	<meta name="robots" content="noindex, nofollow" />
	<link rel="icon" href="/favicon.ico" />
	<style>
		*, *::before, *::after { box-sizing: border-box; }
		body {
			margin: 0;
			font-family: system-ui, sans-serif;
			background: #0f1923;
			color: #fff;
			min-height: 100dvh;
			padding: 1.5rem 1rem 3rem;
		}
		.header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			max-width: 900px;
			margin: 0 auto 2rem;
			gap: 1rem;
			flex-wrap: wrap;
		}
		.header h1 {
			margin: 0;
			font-size: 1.25rem;
			font-weight: 700;
			letter-spacing: -0.01em;
		}
		.header .meta {
			font-size: 0.75rem;
			color: rgba(255,255,255,0.45);
			display: flex;
			align-items: center;
			gap: 0.75rem;
		}
		.ws-dot {
			display: inline-block;
			width: 8px;
			height: 8px;
			border-radius: 50%;
			background: #4ade80;
			flex-shrink: 0;
		}
		.ws-dot.disconnected { background: rgba(255,255,255,0.25); }
		.grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
			gap: 1rem;
			max-width: 900px;
			margin: 0 auto;
		}
		.tile {
			border-radius: 1rem;
			padding: 1.25rem 1rem 1rem;
			background: #1e2d3d;
			transition: background 0.3s;
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
			min-height: 130px;
		}
		.tile.green { background: #1a3a1f; }
		.tile.red   { background: #3a1a1a; }
		.tile-icon {
			width: 1.75rem;
			height: 1.75rem;
			opacity: 0.5;
			flex-shrink: 0;
		}
		.tile .label {
			font-size: 0.7rem;
			font-weight: 700;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: rgba(255,255,255,0.5);
		}
		.tile .count {
			font-size: 3rem;
			font-weight: 800;
			line-height: 1;
			color: #fff;
		}
		.tile .indicator {
			width: 10px;
			height: 10px;
			border-radius: 50%;
			background: rgba(255,255,255,0.15);
			margin-top: auto;
		}
		.tile.green .indicator { background: #4ade80; }
		.tile.red   .indicator { background: #f87171; animation: pulse 1.5s infinite; }
		.tile .last-report {
			font-size: 0.7rem;
			color: rgba(255,255,255,0.35);
			margin-top: -0.25rem;
		}
		@keyframes pulse {
			0%, 100% { opacity: 1; }
			50% { opacity: 0.4; }
		}
	</style>
</head>
<body>
	<div class="header">
		<h1>Stream Monitor</h1>
		<div class="meta">
			<span class="ws-dot disconnected" id="ws-dot"></span>
			<span id="ws-label">Connecting…</span>
			<span>·</span>
			<span id="updated">—</span>
		</div>
	</div>

	<div class="grid" id="grid">
		{BUTTONS.map(label => (
			<div class="tile" id={`tile-${label.replace(/\s+/g, '-')}`}>
				<svg viewBox="0 0 24 24" class="tile-icon" aria-hidden="true" set:html={ICONS[label]}></svg>
				<div class="label">{label}</div>
				<div class="count" id={`count-${label.replace(/\s+/g, '-')}`}>0</div>
				<div class="last-report" id={`last-${label.replace(/\s+/g, '-')}`}></div>
				<div class="indicator"></div>
			</div>
		))}
	</div>

	<script>
		const BUTTONS = ['No Sound', 'Low Volume', 'Sound Quality', 'No Picture', 'Picture Quality'];

		// State: total counts and recent (last 60 min) per button
		const counts: Record<string, number>  = {};
		const recent: Record<string, number>  = {};
		const lastTs: Record<string, number>  = {};

		function slug(s: string) { return s.replace(/\s+/g, '-'); }

		function updateTile(label: string) {
			const tile  = document.getElementById(`tile-${slug(label)}`);
			const count = document.getElementById(`count-${slug(label)}`);
			const last  = document.getElementById(`last-${slug(label)}`);
			if (!tile || !count || !last) return;

			const total   = counts[label] ?? 0;
			const isRed   = (recent[label] ?? 0) > 0;
			count.textContent = String(total);
			tile.className = `tile ${isRed ? 'red' : total > 0 ? 'green' : ''}`;

			if (lastTs[label]) {
				const mins = Math.round((Date.now() - lastTs[label]) / 60_000);
				last.textContent = mins < 1 ? 'just now' : `${mins} min ago`;
			} else {
				last.textContent = '';
			}
		}

		function tick() {
			BUTTONS.forEach(updateTile);
			document.getElementById('updated')!.textContent =
				'Updated ' + new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
		}

		async function loadInitial() {
			try {
				const res  = await fetch('/api/stream-reports');
				const data = await res.json() as { counts: Record<string, number>; recent: Record<string, number> };
				Object.assign(counts, data.counts);
				Object.assign(recent, data.recent);
				tick();
			} catch {
				/* ignore — WS will keep us updated */
			}
		}

		function connectWS() {
			const dot   = document.getElementById('ws-dot')!;
			const label = document.getElementById('ws-label')!;
			const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
			const ws    = new WebSocket(`${proto}//${location.host}/api/stream-ws`);
			let retryMs = 1_000;

			ws.onopen = () => {
				dot.className   = 'ws-dot';
				label.textContent = 'Live';
				retryMs = 1_000;
			};

			ws.onmessage = (ev: MessageEvent) => {
				try {
					const msg = JSON.parse(ev.data as string) as { type: string; button?: string; timestamp?: string };
					if (msg.type === 'report' && msg.button) {
						counts[msg.button] = (counts[msg.button] ?? 0) + 1;
						recent[msg.button] = (recent[msg.button] ?? 0) + 1;
						if (msg.timestamp) lastTs[msg.button] = new Date(msg.timestamp).getTime();
						tick();
					}
				} catch { /* ignore */ }
			};

			ws.onclose = () => {
				dot.className    = 'ws-dot disconnected';
				label.textContent = 'Reconnecting…';
				setTimeout(connectWS, retryMs);
				retryMs = Math.min(retryMs * 2, 30_000);
			};

			ws.onerror = () => ws.close();
		}

		// Refresh "X min ago" labels every 30 s
		setInterval(tick, 30_000);

		loadInitial();
		connectWS();
	</script>
</body>
</html>
