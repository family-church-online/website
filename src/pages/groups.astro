---
export const prerender = true;

import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getConfig } from '../lib/data';

interface GroupFrontmatter {
	name?: string | null;
	day?: string | null;
	time?: string | null;
	type?: string | null;
	area?: string | null;
	frequency?: string | null;
	interval?: string | null;
	gender?: string | null;
	lifeStage?: string | null;
	contact?: string | null;
	open?: boolean | null;
}

const DAY_ORDER = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

const modules = import.meta.glob<{ frontmatter: GroupFrontmatter }>(
	'../content/groups/*.mdx',
	{ eager: true },
);

const groups = Object.values(modules)
	.map(m => m.frontmatter)
	.sort((a, b) => {
		const d = DAY_ORDER.indexOf(a.day ?? '') - DAY_ORDER.indexOf(b.day ?? '');
		return d !== 0 ? d : (a.time ?? '').localeCompare(b.time ?? '');
	});

function timeOfDay(time: string | null | undefined) {
	if (!time) return '';
	if (time < '12:00') return 'Morning';
	if (time < '18:00') return 'Afternoon';
	return 'Evening';
}

const TOD_ORDER  = ['Morning', 'Afternoon', 'Evening'];

const allAreas   = [...new Set(groups.map(g => g.area).filter((a): a is string => !!a))].sort();
const allDays    = DAY_ORDER.filter(d => groups.some(g => g.day === d));
const allTods    = TOD_ORDER.filter(t => groups.some(g => timeOfDay(g.time) === t));

const config    = (await getConfig()).data?.config ?? null;
const siteTitle = config?.seo?.title ?? 'Family Church';
---

<Base
	title={`Groups | ${siteTitle}`}
	description="Small groups meeting across the week for Bible study, prayer, and community."
>
	<div class="max-w-[var(--content-width)] mx-auto px-4 sm:px-6 py-16">

		{/* Header */}
		<div class="text-center mb-10">
			<p class="text-xs font-semibold uppercase tracking-widest text-[var(--olive)] mb-3">Connect</p>
			<h1 class="text-4xl font-semibold lg:text-5xl text-balance mb-4">Find a Group</h1>
			<p class="text-lg text-muted-foreground">Small groups meeting across the week for Bible study, prayer, and community.</p>
		</div>

		{/* Filter bar */}
		<div class="bg-[var(--background)] border-b border-[var(--ink)]/10 sticky top-20 z-20 -mx-4 sm:-mx-6 px-4 sm:px-6 py-3 mb-8">
			<div class="flex flex-wrap gap-2 items-center">

				{/* Day dropdown */}
				<select id="filter-day" class="filter-select text-sm border border-[var(--ink)]/18 dark:border-white/12 rounded-lg px-3 py-1.5 bg-white dark:bg-[var(--card)] cursor-pointer">
					<option value="">All days</option>
					{allDays.map(day => <option value={day}>{day}</option>)}
				</select>

				{/* Time-of-day dropdown */}
				{allTods.length > 1 && (
					<select id="filter-tod" class="filter-select text-sm border border-[var(--ink)]/18 dark:border-white/12 rounded-lg px-3 py-1.5 bg-white dark:bg-[var(--card)] cursor-pointer">
						<option value="">All times</option>
						{allTods.map(t => <option value={t}>{t}</option>)}
					</select>
				)}

				{/* Area dropdown */}
				{allAreas.length > 1 && (
					<select id="filter-area" class="filter-select text-sm border border-[var(--ink)]/18 dark:border-white/12 rounded-lg px-3 py-1.5 bg-white dark:bg-[var(--card)] cursor-pointer">
						<option value="">All areas</option>
						{allAreas.map(a => <option value={a}>{a}</option>)}
					</select>
				)}

				{/* Open only toggle */}
				<label class="flex items-center gap-2 text-sm text-[var(--ink)]/70 dark:text-white/60 cursor-pointer select-none">
					<input type="checkbox" id="filter-open" class="w-4 h-4 accent-[var(--green)]" />
					Open only
				</label>

				{/* Clear filters */}
				<button id="clear-filters" class="hidden text-sm font-semibold text-[var(--navy)] dark:text-[var(--green)] hover:underline ml-auto">
					Clear filters
				</button>

				<span id="result-count" class="text-sm text-[var(--ink)]/45 dark:text-white/45 tabular-nums hidden sm:block"></span>
			</div>
		</div>

		{/* Group grid */}
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="group-grid">
			{groups.map(g => (
				<div
					class="group-card flex flex-col rounded-2xl border border-[var(--ink)]/10 dark:border-white/10 bg-white dark:bg-[var(--card)] p-5 shadow-sm"
					data-day={g.day ?? ''}
					data-tod={timeOfDay(g.time)}
					data-area={g.area ?? ''}
					data-open={g.open ? 'true' : 'false'}
				>
					{/* Open / Full badge */}
					<div class="flex justify-between items-start mb-3">
						<span class={`text-[0.65rem] font-bold tracking-widest uppercase px-2 py-0.5 rounded-full ${
							g.open
								? 'bg-[var(--navy)] text-white'
								: 'bg-gray-100 text-gray-400 dark:bg-white/8 dark:text-white/30'
						}`}>
							{g.open ? 'Open' : 'Full'}
						</span>
						{g.type && (
							<span class="text-[0.65rem] font-semibold uppercase tracking-wide text-[var(--green)]">{g.type}</span>
						)}
					</div>

					{/* Name */}
					<h2 class={`font-display text-xl font-semibold leading-snug mb-1 ${!g.open ? 'opacity-50' : ''}`}>
						{g.name}
					</h2>

					{/* Area */}
					{g.area && (
						<p class={`text-sm font-medium text-[var(--olive)] mb-2 ${!g.open ? 'opacity-50' : ''}`}>
							{g.area}
						</p>
					)}

					{/* Interval + Day / time */}
					{(g.interval || g.day) && (
						<p class={`text-sm font-medium text-[var(--navy)] dark:text-white mb-1 ${!g.open ? 'opacity-50' : ''}`}>
							{[g.interval, g.day && `${g.day} ${timeOfDay(g.time)}${g.time ? ` ${g.time}` : ''}`].filter(Boolean).join(' · ')}
						</p>
					)}

					{/* Frequency */}
					{g.frequency && (
						<p class={`text-sm text-[var(--ink)]/60 dark:text-white/50 mb-3 ${!g.open ? 'opacity-50' : ''}`}>
							{g.frequency}
						</p>
					)}

					{/* Tags — Life Stage then Gender */}
					{(g.lifeStage && g.lifeStage !== 'All Ages' || g.gender && g.gender !== 'Mixed') && (
						<div class={`flex flex-wrap gap-1.5 mb-4 ${!g.open ? 'opacity-40' : ''}`}>
							{g.lifeStage && g.lifeStage !== 'All Ages' && (
								<span class="text-[0.65rem] font-semibold uppercase tracking-wide bg-[var(--navy)]/8 dark:bg-white/8 text-[var(--navy)] dark:text-white/70 px-2 py-0.5 rounded-full">
									{g.lifeStage}
								</span>
							)}
							{g.gender && g.gender !== 'Mixed' && (
								<span class="text-[0.65rem] font-semibold uppercase tracking-wide bg-[var(--navy)]/8 dark:bg-white/8 text-[var(--navy)] dark:text-white/70 px-2 py-0.5 rounded-full">
									{g.gender}
								</span>
							)}
						</div>
					)}

					{/* Contact */}
					{g.contact && (
						<p class={`mt-auto flex items-center gap-1.5 text-sm text-[var(--ink)]/50 dark:text-white/40 ${!g.open ? 'opacity-50' : ''}`}>
							<Icon name="user" class="w-3.5 h-3.5 shrink-0" />
							{g.contact}
						</p>
					)}
				</div>
			))}
		</div>

		<p id="no-results" class="hidden text-center text-gray-400 py-16">No groups match your filters.</p>

	</div>

	<script>
		const cards       = Array.from(document.querySelectorAll<HTMLElement>('.group-card'));
		const daySelect   = document.querySelector<HTMLSelectElement>('#filter-day');
		const todSelect   = document.querySelector<HTMLSelectElement>('#filter-tod');
		const areaSelect  = document.querySelector<HTMLSelectElement>('#filter-area');
		const openToggle  = document.querySelector<HTMLInputElement>('#filter-open');
		const clearBtn    = document.getElementById('clear-filters');
		const countEl     = document.getElementById('result-count');
		const noResults   = document.getElementById('no-results');

		function isFiltered() {
			return (daySelect?.value  || '') !== ''
				|| (todSelect?.value  || '') !== ''
				|| (areaSelect?.value || '') !== ''
				|| openToggle?.checked;
		}

		function applyFilters() {
			const day    = daySelect?.value  ?? '';
			const tod    = todSelect?.value  ?? '';
			const area   = areaSelect?.value ?? '';
			const open   = openToggle?.checked ?? false;
			let visible  = 0;
			cards.forEach(card => {
				const show = (!day  || card.dataset.day  === day)
						  && (!tod  || card.dataset.tod  === tod)
						  && (!area || card.dataset.area === area)
						  && (!open || card.dataset.open === 'true');
				card.hidden = !show;
				if (show) visible++;
			});
			if (countEl) countEl.textContent = `${visible} group${visible !== 1 ? 's' : ''}`;
			if (noResults) noResults.hidden = visible > 0;
			if (clearBtn)  clearBtn.classList.toggle('hidden', !isFiltered());
		}

		function clearFilters() {
			if (daySelect)  daySelect.value  = '';
			if (todSelect)  todSelect.value  = '';
			if (areaSelect) areaSelect.value = '';
			if (openToggle) openToggle.checked = false;
			applyFilters();
		}

		daySelect?.addEventListener('change',  applyFilters);
		todSelect?.addEventListener('change',  applyFilters);
		areaSelect?.addEventListener('change', applyFilters);
		openToggle?.addEventListener('change', applyFilters);
		clearBtn?.addEventListener('click',    clearFilters);

		applyFilters();
	</script>
</Base>
