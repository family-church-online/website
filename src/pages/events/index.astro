---
export const prerender = true;

import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getConfig } from '../../lib/data';

interface EventFrontmatter {
	title?: string;
	date?: string;
	endDate?: string | null;
	location?: string | null;
	image?: string | null;
	description?: string | null;
}

const modules = import.meta.glob<{ frontmatter: EventFrontmatter }>(
	'../../content/events/*.mdx',
	{ eager: true },
);

const config    = (await getConfig()).data?.config ?? null;
const siteTitle = config?.seo?.title ?? 'Family Church';

const today = new Date().toISOString().split('T')[0];

const all = Object.entries(modules).map(([path, mod]) => ({
	slug: path.replace('../../content/events/', '').replace('.mdx', ''),
	...mod.frontmatter,
}));

const upcoming = all
	.filter(e => (e.date ?? '') >= today)
	.sort((a, b) => (a.date ?? '').localeCompare(b.date ?? ''));

const past = all
	.filter(e => (e.date ?? '') < today)
	.sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));

function fmtDate(iso: string) {
	return new Date(iso).toLocaleDateString('en-GB', {
		weekday: 'short', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
	});
}

function fmtTime(iso: string) {
	const t = new Date(iso).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'UTC' });
	return t === '00:00' ? null : t;
}

function locationLabel(raw: string | null | undefined): string | null {
	if (!raw) return null;
	try { JSON.parse(raw); return null; } catch { /* plain string */ }
	return raw;
}

function parsePoint(raw: string | null | undefined): { lat: number; lng: number } | null {
	if (!raw) return null;
	try {
		const geo = JSON.parse(raw);
		if (geo.type === 'Point' && Array.isArray(geo.coordinates) && geo.coordinates.length >= 2) {
			const [lng, lat] = geo.coordinates as [number, number];
			return { lat, lng };
		}
	} catch { /* not GeoJSON */ }
	return null;
}

function dateTimeLabel(event: { date?: string; endDate?: string | null }) {
	if (!event.date) return null;
	const date = new Date(event.date).toLocaleDateString('en-GB', {
		weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
	});
	const time    = fmtTime(event.date);
	const endTime = event.endDate ? fmtTime(event.endDate) : null;
	return time
		? `${date} · ${time}${endTime ? ` – ${endTime}` : ''}`
		: date;
}
---

<Base title={`Events · ${siteTitle}`} description="Upcoming events at Family Church.">
	<div class="reveal max-w-[var(--content-width)] mx-auto px-4 sm:px-6 pt-10 pb-8 text-center">
		<p class="text-xs font-semibold uppercase tracking-widest text-[var(--olive)] mb-3">What's On</p>
		<h1 class="font-display text-4xl font-semibold lg:text-5xl text-balance mb-4">Events</h1>
		<p class="text-lg text-muted-foreground max-w-xl mx-auto leading-relaxed">
			Join us — from courses to celebrations, make friends and enjoy being part of the family.
		</p>
	</div>

	<main class="max-w-[var(--content-width)] mx-auto px-4 sm:px-6 py-10">
		{upcoming.length > 0 ? (
			<section class="mb-16">
				<div class="space-y-4">
				{upcoming.map((event, i) => {
					const label  = dateTimeLabel(event);
					const coords = parsePoint(event.location);
					const locText = locationLabel(event.location);
					return (
						<a
							href={`/events/${event.slug}`}
							class="reveal group flex flex-col bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 overflow-hidden hover:shadow-md transition-shadow"
							data-reveal-delay={String(i * 0.06)}
						>
							{event.image && (
								<div class="aspect-[3/1] overflow-hidden">
									<img
										src={event.image}
										alt={event.title ?? ''}
										class="w-full h-full object-cover scale-110 group-hover:scale-125 transition-transform duration-500"
										loading="lazy"
									/>
								</div>
							)}

							<div class="flex flex-col gap-2 px-6 py-5">
								<div class="flex items-center gap-4">
									<span class="shrink-0 w-10 h-10 rounded-full bg-[var(--navy)] group-hover:bg-[var(--green)] transition-colors flex items-center justify-center">
										<Icon name="calendar" class="w-5 h-5 text-white" />
									</span>
									<h2 class="flex-1 min-w-0 text-lg font-semibold text-[var(--navy)] dark:text-white group-hover:text-[var(--green)] transition-colors leading-snug">
										{event.title}
									</h2>
									<Icon name="caret-right" class="shrink-0 w-5 h-5 text-[var(--navy)]/25 dark:text-white/25 group-hover:text-[var(--green)] transition-colors" />
								</div>

								{label && (
									<p class="text-sm font-semibold text-[var(--navy)] dark:text-white/80">
										{label}
									</p>
								)}

								{locText && (
									<p class="flex items-center gap-1.5 text-sm text-[var(--ink)]/55 dark:text-white/45">
										<Icon name="map-pin" class="w-3.5 h-3.5 shrink-0" />
										{locText}
									</p>
								)}

								{event.description && (
									<p class="text-sm text-[var(--ink)]/65 dark:text-white/55 leading-relaxed">
										{event.description}
									</p>
								)}

							</div>
						</a>
					);
				})}
			</div>
			</section>
		) : (
			<p class="text-[var(--ink)]/55 dark:text-white/45 mb-16">No upcoming events at the moment — check back soon.</p>
		)}

		{past.length > 0 && (
			<section>
				<h2 class="text-sm font-semibold uppercase tracking-widest text-[var(--olive)] mb-4">Past Events</h2>
				<ul class="flex flex-col divide-y divide-[var(--navy)]/8 dark:divide-white/8">
					{past.map((event) => (
						<li>
							<a
								href={`/events/${event.slug}`}
								class="group flex items-center gap-4 py-3.5"
							>
								{event.date && (
									<span class="shrink-0 text-xs text-[var(--ink)]/40 dark:text-white/30 w-36">{fmtDate(event.date)}</span>
								)}
								<span class="font-medium text-[var(--ink)] dark:text-white group-hover:text-[var(--green)] transition-colors">{event.title}</span>
								{locationLabel(event.location) && (
									<span class="ml-auto shrink-0 text-xs text-[var(--ink)]/35 dark:text-white/25 hidden sm:block">{locationLabel(event.location)}</span>
								)}
							</a>
						</li>
					))}
				</ul>
			</section>
		)}
	</main>
</Base>
