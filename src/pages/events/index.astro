---
export const prerender = true;

import Base from '../../layouts/Base.astro';
import { getConfig } from '../../lib/data';

interface EventFrontmatter {
	title?: string;
	date?: string;
	endDate?: string | null;
	location?: string | null;
	image?: string | null;
	description?: string | null;
}

const modules = import.meta.glob<{ frontmatter: EventFrontmatter }>(
	'../../content/events/*.mdx',
	{ eager: true },
);

const config    = (await getConfig()).data?.config ?? null;
const siteTitle = config?.seo?.title ?? 'Family Church';

const today = new Date().toISOString().split('T')[0];

const all = Object.entries(modules).map(([path, mod]) => ({
	slug: path.replace('../../content/events/', '').replace('.mdx', ''),
	...mod.frontmatter,
}));

const upcoming = all
	.filter(e => (e.date ?? '') >= today)
	.sort((a, b) => (a.date ?? '').localeCompare(b.date ?? ''));

const past = all
	.filter(e => (e.date ?? '') < today)
	.sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));

function fmtDate(iso: string) {
	return new Date(iso).toLocaleDateString('en-GB', {
		weekday: 'short', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
	});
}

function dateParts(iso: string) {
	const d = new Date(iso);
	return {
		day:   d.toLocaleDateString('en-GB', { day: 'numeric', timeZone: 'UTC' }),
		month: d.toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' }).toUpperCase(),
	};
}
---

<Base title={`Events · ${siteTitle}`} description="Upcoming events at Family Church.">
	<div class="max-w-[var(--content-width)] mx-auto px-4 sm:px-6 py-16">

		<div class="mb-12">
			<p class="text-xs font-semibold uppercase tracking-widest text-[var(--olive)] mb-2">What's On</p>
			<h1 class="font-display text-4xl font-semibold lg:text-5xl text-[var(--ink)] dark:text-white">Events</h1>
		</div>

		{upcoming.length > 0 ? (
			<section class="mb-16">
				<h2 class="text-sm font-semibold uppercase tracking-widest text-[var(--olive)] mb-6">Upcoming</h2>
				<ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
					{upcoming.map((event) => {
						const parts = event.date ? dateParts(event.date) : null;
						return (
							<li>
								<a
									href={`/events/${event.slug}`}
									class="group flex flex-col h-full bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 overflow-hidden hover:shadow-md transition-shadow"
								>
									{event.image ? (
										<div class="aspect-video overflow-hidden">
											<img
												src={event.image}
												alt={event.title ?? ''}
												class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
												loading="lazy"
											/>
										</div>
									) : (
										<div class="bg-[var(--navy)] px-5 pt-5 pb-4">
											{parts && (
												<div class="flex flex-col items-start">
													<span class="text-[var(--green)] text-xs font-bold uppercase tracking-widest">{parts.month}</span>
													<span class="text-white text-5xl font-bold leading-none">{parts.day}</span>
												</div>
											)}
										</div>
									)}
									<div class="px-5 py-4 flex flex-col gap-1.5 flex-1">
										{event.image && parts && (
											<p class="text-xs font-semibold text-[var(--olive)] uppercase tracking-wide">{parts.month} {parts.day}</p>
										)}
										<h3 class="font-semibold text-[var(--navy)] dark:text-white group-hover:text-[var(--green)] dark:group-hover:text-[var(--green)] transition-colors leading-snug">
											{event.title}
										</h3>
										{event.location && (
											<p class="text-xs text-[var(--ink)]/55 dark:text-white/45">{event.location}</p>
										)}
										{event.description && (
											<p class="text-sm text-[var(--ink)]/65 dark:text-white/55 line-clamp-2 mt-0.5">{event.description}</p>
										)}
										{event.date && (
											<p class="text-xs text-[var(--ink)]/45 dark:text-white/35 mt-auto pt-2">{fmtDate(event.date)}</p>
										)}
									</div>
								</a>
							</li>
						);
					})}
				</ul>
			</section>
		) : (
			<p class="text-[var(--ink)]/55 dark:text-white/45 mb-16">No upcoming events at the moment — check back soon.</p>
		)}

		{past.length > 0 && (
			<section>
				<h2 class="text-sm font-semibold uppercase tracking-widest text-[var(--olive)] mb-6">Past Events</h2>
				<ul class="flex flex-col divide-y divide-[var(--navy)]/8 dark:divide-white/8">
					{past.map((event) => (
						<li>
							<a
								href={`/events/${event.slug}`}
								class="group flex items-center gap-4 py-4 hover:text-[var(--green)] transition-colors"
							>
								{event.date && (
									<span class="shrink-0 text-sm text-[var(--ink)]/45 dark:text-white/35 w-36">{fmtDate(event.date)}</span>
								)}
								<span class="font-medium text-[var(--ink)] dark:text-white group-hover:text-[var(--green)] transition-colors">{event.title}</span>
								{event.location && (
									<span class="ml-auto shrink-0 text-xs text-[var(--ink)]/40 dark:text-white/30 hidden sm:block">{event.location}</span>
								)}
							</a>
						</li>
					))}
				</ul>
			</section>
		)}

	</div>
</Base>
