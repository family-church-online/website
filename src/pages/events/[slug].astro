---
export const prerender = true;

import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getConfig } from '../../lib/data';

interface EventFrontmatter {
	title?: string;
	date?: string;
	endDate?: string | null;
	location?: string | null;
	image?: string | null;
	description?: string | null;
	registrationUrl?: string | null;
}

export function getStaticPaths() {
	const mods = import.meta.glob<{ frontmatter: EventFrontmatter; default: any }>(
		'../../content/events/*.mdx',
		{ eager: true },
	);

	return Object.entries(mods).map(([path, mod]) => ({
		params: { slug: path.replace('../../content/events/', '').replace('.mdx', '') },
		props:  { frontmatter: mod.frontmatter, Content: mod.default },
	}));
}

const { frontmatter: fm, Content } = Astro.props as {
	frontmatter: EventFrontmatter;
	Content: any;
};

const config    = (await getConfig()).data?.config ?? null;
const siteTitle = config?.seo?.title ?? 'Family Church';

const TZ = 'Africa/Johannesburg';

function fmtPart(iso: string, opts: Intl.DateTimeFormatOptions) {
	return new Date(iso).toLocaleDateString('en-GB', { timeZone: TZ, ...opts });
}

function fmtTime(iso: string) {
	const t = new Date(iso).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: TZ });
	return t === '00:00' ? null : t;
}

const calDay   = fm.date ? fmtPart(fm.date, { day: 'numeric' })    : null;
const calMonth = fm.date ? fmtPart(fm.date, { month: 'short' }).toUpperCase() : null;
const calYear  = fm.date ? fmtPart(fm.date, { year: 'numeric' })   : null;
const calWeekday = fm.date ? fmtPart(fm.date, { weekday: 'long' }) : null;

const startTime = fm.date    ? fmtTime(fm.date)    : null;
const endTime   = fm.endDate ? fmtTime(fm.endDate) : null;

function parsePoint(raw: string | null | undefined): { lat: number; lng: number } | null {
	if (!raw) return null;
	try {
		const geo = JSON.parse(raw);
		if (geo.type === 'Point' && Array.isArray(geo.coordinates) && geo.coordinates.length >= 2) {
			const [lng, lat] = geo.coordinates as [number, number];
			return { lat, lng };
		}
	} catch { /* plain string — not GeoJSON */ }
	return null;
}

const mapCoords   = parsePoint(fm.location);
const locationStr = mapCoords ? null : (fm.location || null);

const siteUrl = new URL('/', Astro.site).toString().replace(/\/$/, '');
const eventLd = {
	'@context': 'https://schema.org',
	'@type': 'Event',
	name: fm.title,
	...(fm.date    && { startDate: fm.date }),
	...(fm.endDate && { endDate: fm.endDate }),
	...(fm.description && { description: fm.description }),
	...(fm.image && { image: fm.image.startsWith('http') ? fm.image : `${siteUrl}${fm.image}` }),
	...(fm.location && { location: { '@type': 'Place', name: fm.location } }),
	organizer: {
		'@type': 'Church',
		name: config?.seo?.title ?? 'Family Church',
		url: siteUrl,
	},
	eventStatus: 'https://schema.org/EventScheduled',
	eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
};
---

<Base
	title={`${fm.title ?? 'Event'} · ${siteTitle}`}
	description={fm.description ?? `An event at ${siteTitle}.`}
	image={fm.image ?? undefined}
	ogType="article"
>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(eventLd)} />

	<article>
		<div class="max-w-[var(--content-width)] mx-auto px-4 sm:px-6 pt-10">
			{/* ── BACK LINK ─────────────────────────────────────────────────── */}
			<a
				href="/events"
				class="inline-flex items-center gap-1.5 text-sm text-[var(--ink)]/50 dark:text-white/40 hover:text-[var(--green)] transition-colors mb-8"
			>
				<Icon name="caret-left" class="w-4 h-4" />
				All events
			</a>
		</div>

		{/* ── PAGE HEADER ───────────────────────────────────────────────── */}
		<div class="reveal max-w-[var(--content-width)] mx-auto px-4 sm:px-6 text-center mb-8">
			<p class="text-xs font-semibold uppercase tracking-widest text-[var(--olive)] mb-3">What's On</p>
			<h1 class="font-display text-4xl font-semibold lg:text-5xl text-balance mb-4">{fm.title}</h1>
			{fm.description && (
				<p class="text-lg text-muted-foreground max-w-xl mx-auto leading-relaxed">{fm.description}</p>
			)}
		</div>

		{/* ── IMAGE ─────────────────────────────────────────────────────────── */}
		{fm.image ? (
			<div class="reveal max-w-[var(--content-width)] mx-auto px-4 sm:px-6 mb-8">
				<div class="w-full rounded-2xl overflow-hidden aspect-[3/1]">
					<img
						src={fm.image}
						alt={fm.title ?? ''}
						class="w-full h-full object-cover scale-110"
					/>
				</div>
			</div>
		) : (
			<div class="max-w-[var(--content-width)] mx-auto px-4 sm:px-6 mb-8">
				<div class="bg-[var(--navy)] rounded-2xl flex items-center justify-center aspect-[3/1]">
					<Icon name="calendar" class="w-16 h-16 text-white/15" />
				</div>
			</div>
		)}

		<div class="max-w-[var(--content-width)] mx-auto px-4 sm:px-6 pb-10">

			{/* ── INFO CARD ─────────────────────────────────────────────────── */}
			<div class="reveal bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 overflow-hidden mb-10" data-reveal-delay="0.08">

				{/* Date, time & CTAs */}
				{calDay && (
					<div class={`flex flex-wrap items-start gap-x-5 gap-y-3 px-6 py-5${locationStr ? ' border-b border-[var(--navy)]/8 dark:border-white/8' : ''}`}>
						{/* Calendar badge */}
						<div class="shrink-0 w-14 rounded-xl overflow-hidden ring-1 ring-[var(--red)]/20 dark:ring-white/12 text-center">
							<div class="bg-[var(--red)] py-1">
								<span class="text-white text-[10px] font-bold uppercase tracking-widest">{calMonth}</span>
							</div>
							<div class="bg-white dark:bg-[var(--card)] py-2">
								<span class="text-[var(--navy)] dark:text-white text-2xl font-bold leading-none">{calDay}</span>
							</div>
						</div>
						<div class="flex-1 min-w-0">
							<p class="font-semibold text-[var(--navy)] dark:text-white">
								{calWeekday}, {calDay} {calMonth} {calYear}
							</p>
							{startTime && (
								<p class="text-sm text-[var(--ink)]/60 dark:text-white/50 mt-0.5 flex items-center gap-1.5">
									<Icon name="clock" class="w-3.5 h-3.5 shrink-0" />
									{startTime}{endTime ? ` – ${endTime}` : ''}
								</p>
							)}
						</div>
						{(fm.registrationUrl || mapCoords) && (
							<div class="basis-full sm:basis-auto flex flex-wrap gap-2 justify-end">
								{fm.registrationUrl && (
									<a
										href={fm.registrationUrl}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-2 text-sm font-semibold bg-[var(--navy)] text-white rounded-full px-6 py-2.5 hover:bg-[var(--green)] hover:text-[var(--ink)] transition-colors"
									>
										<Icon name="whatsapp" class="w-4 h-4" />
										Register
									</a>
								)}
								{mapCoords && (
									<a
										href={`https://www.google.com/maps/dir/?api=1&destination=${mapCoords.lat},${mapCoords.lng}`}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-2 text-sm font-semibold bg-[var(--navy)] text-white rounded-full px-6 py-2.5 hover:bg-[var(--green)] hover:text-[var(--ink)] transition-colors"
									>
										<Icon name="map-pin" class="w-4 h-4" />
										Get directions
									</a>
								)}
							</div>
						)}
					</div>
				)}

				{/* Plain text location (no map) */}
				{locationStr && (
					<div class="flex items-center gap-3 px-6 py-4">
						<Icon name="map-pin" class="w-4 h-4 text-[var(--navy)]/50 dark:text-white/40 shrink-0" />
						<p class="text-sm text-[var(--ink)]/70 dark:text-white/60">{locationStr}</p>
					</div>
				)}
			</div>

			{/* ── BODY ──────────────────────────────────────────────────────── */}
			{Content && (
				<div class="reveal bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 px-6 py-6" data-reveal-delay="0.14">
					<div class="prose dark:prose-invert max-w-none">
						<Content />
					</div>
				</div>
			)}

		</div>
	</article>
</Base>
