---
import Base from '../layouts/Base.astro';
import Section from '../components/ui/Section.astro';

interface MinistryFrontmatter {
  title?: string;
  image?: string | null;
  link?: { label?: string; url?: string } | null;
}

const mods = import.meta.glob<{ frontmatter: MinistryFrontmatter; default: any }>(
  '../content/ministries/*.mdx',
  { eager: true }
);

const ministries = Object.entries(mods)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => ({
    slug: path.replace('../content/ministries/', '').replace('.mdx', '').replace(/^\d+-/, ''),
    frontmatter: mod.frontmatter,
    Content: mod.default,
  }));
---

<Base
  title="Ministries — Family Church"
  description="Find your place in our community — Friday Youth, Retirement fellowship, and Sport."
>
  <Section>
    <div class="mx-auto max-w-[var(--content-width)]">

      {/* Header */}
      <div class="text-center mb-14">
        <p class="text-xs font-semibold uppercase tracking-widest text-[var(--olive)] mb-3">Get Involved</p>
        <h1 class="text-4xl font-semibold lg:text-5xl text-balance mb-4">Ministries</h1>
        <p class="text-lg text-muted-foreground">Whatever your age or stage, there is a place for you here.</p>
      </div>

      {/* Ministry list */}
      <ol class="list-none p-0 m-0">
        {ministries.map((m, i) => (
          <li id={m.slug} class="grid gap-x-5 pb-12 last:pb-0" style="grid-template-columns:2rem 1fr">
            <div class="flex flex-col items-center pt-1.5">
              <span class="w-3 h-3 rounded-full shrink-0 bg-[var(--green)] shadow-[0_0_0_3px_rgba(146,196,35,0.18)]"></span>
              {i < ministries.length - 1 && (
                <span class="flex-1 w-px mt-1.5 min-h-8 bg-gradient-to-b from-[var(--green)]/30 to-[var(--green)]/5"></span>
              )}
            </div>
            <div>
              <h2 class="font-display text-2xl font-semibold text-foreground leading-none mb-2">
                {m.frontmatter.title}
              </h2>
              <div class="ministry-body text-sm text-muted-foreground leading-relaxed">
                <m.Content />
              </div>
              {m.frontmatter.link?.url && (
                <div class="mt-3">
                  <a href={m.frontmatter.link.url} target="_blank" rel="noopener noreferrer"
                    class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-[var(--navy)] text-white hover:bg-[var(--navy)]/80 dark:bg-[var(--green)]/10 dark:text-[var(--green)] dark:border dark:border-[var(--green)]/20 dark:hover:bg-[var(--green)]/20 transition-colors no-underline">
                    {m.frontmatter.link.label ?? m.frontmatter.link.url}
                  </a>
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>

    </div>
  </Section>
</Base>

<style>
.ministry-body :global(p) {
  margin-bottom: 0.75rem;
}
.ministry-body :global(p:last-child) {
  margin-bottom: 0;
}
</style>
