---
export const prerender = true;

import Base from '../../layouts/Base.astro';
import LessonCard from '../../components/ministry/LessonCard.astro';
import { getConfig } from '../../lib/data';

interface Frontmatter { title?: string; date?: string; scripture?: string; }

const mods = import.meta.glob<{ frontmatter: Frontmatter }>(
	'../../content/amplify/*.mdx',
	{ eager: true },
);

const lessons = Object.entries(mods)
	.map(([path, mod]) => ({
		date: path.replace('../../content/amplify/', '').replace('.mdx', ''),
		...mod.frontmatter,
	}))
	.sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));

const config    = (await getConfig()).data?.config ?? null;
const siteTitle = config?.seo?.title ?? 'Family Church';
---

<Base title={`Amplify — Teens · ${siteTitle}`} description="Weekly lessons for teens from Family Church.">
	<div class="reveal max-w-[var(--content-width)] mx-auto px-4 sm:px-6 pt-10 pb-4 text-center">
		<p class="text-xs font-semibold uppercase tracking-widest text-[var(--olive)] mb-3">Ministry</p>
		<h1 class="font-display text-4xl font-semibold lg:text-5xl text-balance mb-2">Amplify</h1>
		<p class="text-[var(--ink)]/55 dark:text-white/50 text-sm">Weekly lessons for teens</p>
	</div>

	<main class="max-w-[var(--content-width)] mx-auto px-4 sm:px-6 py-8">
		{lessons.length === 0 ? (
			<p class="text-[var(--ink)]/50 dark:text-white/40 text-sm">No lessons published yet.</p>
		) : (
			<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
				{lessons.map(l => (
					<LessonCard href={`/amplify/${l.date}`} date={l.date} title={l.title} scripture={l.scripture} />
				))}
			</div>
		)}
	</main>
</Base>
