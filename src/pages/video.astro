---
import Base from '../layouts/Base.astro';
import { getConfig, getLiveVideo } from '../lib/data';

const config      = (await getConfig()).data?.config ?? null;
const siteTitle   = config?.seo?.title ?? 'Family Church';

const lv          = (await getLiveVideo()).data?.liveVideo as any;
const pageHeading = lv?.pageHeading  ?? 'Watch & Listen Live';
const video       = lv?.video;
const audio       = lv?.audio;

interface SermonFrontmatter {
  title?: string;
  date?: string;
  series?: string | null;
  image?: string | null;
  review?: boolean;
}

const sermonModules = import.meta.glob<{ frontmatter: SermonFrontmatter }>(
  '../content/sermons/*.mdx',
  { eager: true }
);

const recentSermons = Object.entries(sermonModules)
  .map(([path, mod]) => ({
    slug: path.replace('../content/sermons/', '').replace('.mdx', ''),
    ...mod.frontmatter,
  }))
  .filter(s => !s.review)
  .sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''))
  .slice(0, 5);

function fmtDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('en-ZA', {
    day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
  });
}
---

<Base
  title={`${pageHeading} · ${siteTitle}`}
  description="Watch the live video stream or listen to the live audio broadcast of our Sunday service."
>

  {/* ── PAGE HEADER ── */}
  <div class="max-w-3xl mx-auto px-4 sm:px-6 pt-10 pb-8 text-center reveal">
    <p class="text-xs font-semibold uppercase tracking-widest text-[var(--olive)] mb-3">Family Church</p>
    <h1 class="text-4xl font-semibold lg:text-5xl text-balance mb-4">{pageHeading}</h1>
    <p class="text-lg text-muted-foreground max-w-xl mx-auto leading-relaxed">
      Join us for our live Sunday service — watch the stream or listen in with minimal data.
    </p>
  </div>

  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-6 pb-6 space-y-12">

    {/* ── AUDIO ── */}
    {audio?.streamUrl && (
      <div id="audio" class="scroll-mt-32 reveal" data-reveal-delay="0.05">
        <div class="bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 overflow-hidden">

          <div class="px-6 pt-6 pb-5">
            <audio controls preload="none" class="w-full" style="color-scheme: light dark;">
              <source src={audio.streamUrl} />
              <p class="text-sm text-[var(--ink)] dark:text-white">
                Your browser doesn't support audio.
                <a href={audio.streamUrl} class="text-[var(--green)] underline">Open stream</a>.
              </p>
            </audio>
          </div>

          {/* Stream status */}
          <div class="info-card px-6 py-3 flex items-center gap-2 text-sm text-[var(--ink)]/80 dark:text-white/75">
            <span id="stream-dot" class="shrink-0 w-2 h-2 rounded-full bg-[var(--ink)]/20 dark:bg-white/20"></span>
            <span id="stream-status-text">
              Live Audio Only Broadcast:&nbsp;
              <strong><span class="cc_streaminfo" data-type="source" data-username="familychurchon"></span></strong>
              &nbsp;·&nbsp;
              <span class="cc_streaminfo" data-type="listeners" data-username="familychurchon"></span> listening
            </span>
          </div>

          {audio.description && (
            <div class="px-6 py-4">
              <p class="text-sm text-[var(--ink)]/70 dark:text-white/65 leading-relaxed">
                {audio.description}
              </p>
            </div>
          )}

        </div>
      </div>
    )}

    {/* ── VIDEO ── */}
    {video?.embedUrl && (
      <div id="video" class="scroll-mt-32 reveal" data-reveal-delay="0.1">
        <div class="rounded-2xl overflow-hidden shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 relative w-full" style="padding-top: 56.25%;">
          <iframe
            src={video.embedUrl}
            frameborder="0"
            allow="autoplay; fullscreen; picture-in-picture; encrypted-media; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
            class="absolute inset-0 w-full h-full"
          ></iframe>
        </div>
      </div>
    )}

  </main>

  {/* ── PREVIOUS SERMONS ── */}
  {recentSermons.length > 0 && (
    <section id="sermons" class="scroll-mt-32 bg-[var(--background)] py-12">
      <div class="max-w-3xl mx-auto px-6 mb-5 text-center reveal">
        <p class="text-xs font-semibold uppercase tracking-widest text-[var(--olive)] mb-3">Missed the live service?</p>
        <h2 class="font-display text-2xl font-semibold text-[var(--ink)] dark:text-white inline-block uppercase tracking-wide">Catch Up</h2>
        <p class="text-muted-foreground text-sm mt-2 mb-4">Listen back to some of our previous services.</p>
        <a href="/sermons" class="inline-block px-5 py-2 rounded-full border border-[var(--navy)] dark:border-white/40 text-sm font-medium text-[var(--navy)] dark:text-white hover:bg-[var(--navy)] hover:text-white dark:hover:bg-white/10 transition-colors">All sermons →</a>
      </div>

      <div class="relative max-w-3xl mx-auto">
        <ul
          id="live-sermon-carousel"
          class="flex gap-4 overflow-x-auto px-6 pb-2 scrollbar-hide"
          style="scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;"
        >
          {recentSermons.map((s, i) => (
            <li class="scroll-snap-start shrink-0 w-[70vw] max-w-[220px] sm:w-[28%] reveal" data-reveal-delay={String((i % 5) * 0.07)}>
              <a
                href={`/sermons/${s.slug}`}
                class="group flex flex-col bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 overflow-hidden hover:shadow-md transition-shadow h-full"
              >
                <div class="aspect-video bg-[var(--navy)]/10 dark:bg-white/5 overflow-hidden">
                  {s.image ? (
                    <img
                      src={s.image}
                      alt={s.title ?? ''}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center">
                      <svg class="w-10 h-10 text-[var(--navy)]/25 dark:text-white/20" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z"/>
                      </svg>
                    </div>
                  )}
                </div>
                <div class="px-4 py-3 flex-1 flex flex-col justify-between gap-1">
                  <p class="font-semibold text-[var(--navy)] dark:text-white group-hover:text-[var(--green)] dark:group-hover:text-[var(--green)] transition-colors leading-snug line-clamp-2 text-sm">
                    {s.title}
                  </p>
                  <p class="text-xs text-[var(--ink)]/50 dark:text-white/50">
                    {s.date ? fmtDate(s.date) : ''}
                    {s.series ? ` · ${s.series}` : ''}
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ul>

        <button id="live-sermon-prev" aria-label="Previous" class="carousel-btn left-1">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5">
            <path d="M13 5l-5 5 5 5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button id="live-sermon-next" aria-label="Next" class="carousel-btn right-1">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5">
            <path d="M7 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </section>
  )}

</Base>

<style>
.info-card {
  background-color: #e6ecf4;
}
:global(.dark) .info-card {
  background-color: rgba(39, 63, 97, 0.45);
}

.scrollbar-hide { scrollbar-width: none; }
.scrollbar-hide::-webkit-scrollbar { display: none; }
.scroll-snap-start { scroll-snap-align: start; }

.carousel-btn {
  display: none;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  background: white;
  border: 1px solid rgba(20,32,47,0.12);
  border-radius: 9999px;
  width: 2.25rem;
  height: 2.25rem;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  color: var(--navy);
  cursor: pointer;
  transition: box-shadow 0.15s;
}
.carousel-btn:hover { box-shadow: 0 4px 14px rgba(0,0,0,0.15); }
.carousel-btn:disabled { opacity: 0.35; pointer-events: none; }

@media (hover: hover) {
  .carousel-btn { display: flex; }
}
</style>

<script src="https://janus.shoutca.st:2199/system/streaminfo.js"></script>

<script>
  function updateStreamIndicator() {
    const dot    = document.getElementById('stream-dot');
    const source = document.querySelector<HTMLElement>('.cc_streaminfo[data-type="source"]');
    if (!dot || !source) return;

    const text    = source.textContent?.trim() ?? '';
    const isLive  = text.length > 0 && text.toLowerCase() !== 'stream offline' && text.toLowerCase() !== 'offline';

    dot.classList.toggle('bg-[var(--green)]', isLive);
    dot.classList.toggle('animate-pulse',     isLive);
    dot.classList.toggle('bg-[var(--ink)]/20',  !isLive);
    dot.classList.toggle('dark:bg-white/20',    !isLive);
  }

  // Poll briefly after page load to catch when streaminfo.js populates the spans
  document.addEventListener('astro:page-load', () => {
    let attempts = 0;
    const interval = setInterval(() => {
      updateStreamIndicator();
      if (++attempts >= 10) clearInterval(interval);
    }, 500);
  });
</script>

<script>
document.addEventListener('astro:page-load', () => {
  const track = document.getElementById('live-sermon-carousel');
  const prev  = document.getElementById('live-sermon-prev') as HTMLButtonElement | null;
  const next  = document.getElementById('live-sermon-next') as HTMLButtonElement | null;
  if (!track || !prev || !next) return;

  function cardWidth() {
    const card = track!.querySelector('li');
    return card ? card.offsetWidth + 16 : 300;
  }

  prev.addEventListener('click', () => track.scrollBy({ left: -cardWidth(), behavior: 'smooth' }));
  next.addEventListener('click', () => track.scrollBy({ left:  cardWidth(), behavior: 'smooth' }));

  function updateButtons() {
    prev!.disabled = track!.scrollLeft <= 4;
    next!.disabled = track!.scrollLeft + track!.offsetWidth >= track!.scrollWidth - 4;
  }

  track.addEventListener('scroll', updateButtons, { passive: true });
  updateButtons();
});
</script>
