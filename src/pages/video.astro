---
import Base from '../layouts/Base.astro';
import { getConfig, getLiveVideo } from '../lib/data';

const config      = (await getConfig()).data?.config ?? null;
const siteTitle   = config?.seo?.title ?? 'Family Church';

const lv          = (await getLiveVideo()).data?.liveVideo as any;
const pageHeading = lv?.pageHeading  ?? 'Watch & Listen Live';
const video       = lv?.video;
const audio       = lv?.audio;

interface SermonFrontmatter {
  title?: string;
  date?: string;
  speaker?: string;
  series?: string | null;
  image?: string | null;
  review?: boolean;
}

const sermonModules = import.meta.glob<{ frontmatter: SermonFrontmatter }>(
  '../content/sermons/*.mdx',
  { eager: true }
);

const recentSermons = Object.entries(sermonModules)
  .map(([path, mod]) => ({
    slug: path.replace('../content/sermons/', '').replace('.mdx', ''),
    ...mod.frontmatter,
  }))
  .filter(s => !s.review)
  .sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''))
  .slice(0, 5);

function fmtDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('en-ZA', {
    day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
  });
}
---

<Base
  title={`${pageHeading} · ${siteTitle}`}
  description="Watch the live video stream or listen to the live audio broadcast of our Sunday service."
>

  {/* ── PAGE HEADER ── */}
  <div class="max-w-3xl mx-auto px-4 sm:px-6 pt-10 pb-6 text-center">
    <p class="text-xs font-semibold uppercase tracking-widest text-[var(--olive)] mb-3">Family Church</p>
    <h1 class="text-4xl font-semibold lg:text-5xl text-balance mb-6">{pageHeading}</h1>

    {/* ── ANCHOR NAV ── */}
    <nav class="inline-flex gap-2 bg-[var(--navy)]/6 dark:bg-white/8 rounded-full px-2 py-2" aria-label="Page sections">
      {video?.heading && (
        <a href="#video" class="section-pill">
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M2 6a2 2 0 012-2h6l2 2h4a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"/>
            <path d="M14.5 10.5l-5 3V7.5l5 3z" fill="white"/>
          </svg>
          {video.heading}
        </a>
      )}
      {audio?.heading && (
        <a href="#audio" class="section-pill">
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M9.383 3.076A1 1 0 0110 4v12a1 1 0 01-1.707.707L4.586 13H2a1 1 0 01-1-1V8a1 1 0 011-1h2.586l3.707-3.707a1 1 0 011.09-.217zM14.657 2.929a1 1 0 011.414 0A9.972 9.972 0 0119 10a9.972 9.972 0 01-2.929 7.071 1 1 0 01-1.414-1.414A7.971 7.971 0 0017 10c0-2.21-.894-4.208-2.343-5.657a1 1 0 010-1.414zm-2.829 2.828a1 1 0 011.415 0A5.983 5.983 0 0115 10a5.984 5.984 0 01-1.757 4.243 1 1 0 01-1.415-1.415A3.984 3.984 0 0013 10a3.983 3.983 0 00-1.172-2.828 1 1 0 010-1.415z" clip-rule="evenodd"/>
          </svg>
          {audio.heading}
        </a>
      )}
      {recentSermons.length > 0 && (
        <a href="#sermons" class="section-pill">
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z"/>
          </svg>
          Previous Sermons
        </a>
      )}
    </nav>
  </div>

  <main class="pb-24 space-y-16">

    {/* ── VIDEO SECTION ── */}
    {video?.embedUrl && (
      <section id="video" class="scroll-mt-24 max-w-4xl mx-auto px-4 sm:px-6">
        {video.heading && <h2 class="section-label">{video.heading}</h2>}
        <div class="relative w-full rounded-2xl overflow-hidden shadow-lg ring-1 ring-[var(--navy)]/10" style="padding-top: 56.25%;">
          <iframe
            src={video.embedUrl}
            frameborder="0"
            allow="autoplay; fullscreen; picture-in-picture; encrypted-media; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
            class="absolute inset-0 w-full h-full"
          ></iframe>
        </div>
      </section>
    )}

    {/* ── AUDIO SECTION ── */}
    {audio?.streamUrl && (
      <section id="audio" class="scroll-mt-24 max-w-4xl mx-auto px-4 sm:px-6">
        {audio.heading && <h2 class="section-label">{audio.heading}</h2>}
        <div class="bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 p-6 sm:p-8 space-y-5">

          <audio controls preload="none" class="w-full" style="color-scheme: light dark;">
            <source src={audio.streamUrl} />
            <p>Your browser doesn't support audio.
              <a href={audio.streamUrl} class="text-[var(--green)] underline">Open stream</a>.
            </p>
          </audio>

          {audio.description && (
            <p class="text-sm text-[var(--ink)]/75 dark:text-white/70 leading-relaxed">
              {audio.description}
            </p>
          )}

          <a
            href={audio.streamUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm font-medium text-[var(--green)] hover:underline"
          >
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"/>
              <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"/>
            </svg>
            Open in external player
          </a>
        </div>
      </section>
    )}

    {/* ── PREVIOUS SERMONS ── */}
    {recentSermons.length > 0 && (
      <section id="sermons" class="scroll-mt-24 bg-[var(--background)] py-12">
        <div class="max-w-3xl mx-auto px-6 mb-5 text-center">
          <p class="text-xs font-semibold uppercase tracking-widest text-[var(--olive)] mb-2">Missed the live service?</p>
          <h2 class="font-display text-2xl font-semibold text-[var(--ink)] dark:text-white inline-block uppercase tracking-wide">Catch Up</h2>
          <p class="text-sm text-[var(--ink)]/60 dark:text-white/60 mt-2 mb-3">Listen back to some of our previous services.</p>
          <a href="/sermons" class="inline-block px-5 py-2 rounded-full border border-[var(--navy)] dark:border-white/30 text-sm font-medium text-[var(--navy)] dark:text-white hover:bg-[var(--navy)] hover:text-white dark:hover:bg-white/10 transition-colors">All sermons →</a>
        </div>

        <div class="relative max-w-3xl mx-auto">
          <ul
            id="live-sermon-carousel"
            class="flex gap-4 overflow-x-auto scroll-snap-x-mandatory px-6 pb-2 scrollbar-hide"
            style="scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;"
          >
            {recentSermons.map(s => (
              <li class="scroll-snap-start shrink-0 w-[70vw] max-w-[220px] sm:w-[28%]">
                <a
                  href={`/sermons/${s.slug}`}
                  class="group flex flex-col bg-white rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 overflow-hidden hover:shadow-md transition-shadow h-full"
                >
                  <div class="aspect-video bg-[var(--navy)]/10 overflow-hidden">
                    {s.image ? (
                      <img
                        src={s.image}
                        alt={s.title ?? ''}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                        loading="lazy"
                      />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center">
                        <svg class="w-10 h-10 text-[var(--navy)]/25" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z"/>
                        </svg>
                      </div>
                    )}
                  </div>
                  <div class="px-4 py-3 flex-1 flex flex-col justify-between gap-1">
                    <p class="font-semibold text-[var(--navy)] group-hover:text-[var(--green)] transition-colors leading-snug line-clamp-2 text-sm">
                      {s.title}
                    </p>
                    <p class="text-xs text-[var(--ink)]/50">
                      {s.date ? fmtDate(s.date) : ''}
                      {s.series ? ` · ${s.series}` : ''}
                    </p>
                  </div>
                </a>
              </li>
            ))}
          </ul>

          <button id="live-sermon-prev" aria-label="Previous" class="carousel-btn left-1">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5">
              <path d="M13 5l-5 5 5 5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button id="live-sermon-next" aria-label="Next" class="carousel-btn right-1">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5">
              <path d="M7 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </section>
    )}

  </main>

</Base>

<style>
.section-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.375rem 1rem;
  border-radius: 9999px;
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--navy);
  transition: background-color 0.15s, color 0.15s;
}
.section-pill:hover {
  background-color: white;
  color: var(--green);
}
:global(.dark) .section-pill {
  color: white;
}
:global(.dark) .section-pill:hover {
  background-color: rgba(255,255,255,0.12);
  color: var(--green);
}

.section-label {
  font-size: 0.6875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--olive);
  margin-bottom: 1rem;
}

.scrollbar-hide { scrollbar-width: none; }
.scrollbar-hide::-webkit-scrollbar { display: none; }
.scroll-snap-start { scroll-snap-align: start; }

.carousel-btn {
  display: none;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  background: white;
  border: 1px solid rgba(20,32,47,0.12);
  border-radius: 9999px;
  width: 2.25rem;
  height: 2.25rem;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  color: var(--navy);
  cursor: pointer;
  transition: box-shadow 0.15s;
}
.carousel-btn:hover { box-shadow: 0 4px 14px rgba(0,0,0,0.15); }
.carousel-btn:disabled { opacity: 0.35; pointer-events: none; }

@media (hover: hover) {
  .carousel-btn { display: flex; }
}
</style>

<script>
document.addEventListener('astro:page-load', () => {
  const track = document.getElementById('live-sermon-carousel');
  const prev  = document.getElementById('live-sermon-prev') as HTMLButtonElement | null;
  const next  = document.getElementById('live-sermon-next') as HTMLButtonElement | null;
  if (!track || !prev || !next) return;

  function cardWidth() {
    const card = track!.querySelector('li');
    return card ? card.offsetWidth + 16 : 300;
  }

  prev.addEventListener('click', () => track.scrollBy({ left: -cardWidth(), behavior: 'smooth' }));
  next.addEventListener('click', () => track.scrollBy({ left:  cardWidth(), behavior: 'smooth' }));

  function updateButtons() {
    prev!.disabled = track!.scrollLeft <= 4;
    next!.disabled = track!.scrollLeft + track!.offsetWidth >= track!.scrollWidth - 4;
  }

  track.addEventListener('scroll', updateButtons, { passive: true });
  updateButtons();
});
</script>
