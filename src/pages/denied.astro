---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
---
<Base title="Access Denied" description="You don't have access to this content.">
	<section class="flex min-h-[70vh] items-center justify-center px-6 text-center">
		<div class="flex flex-col items-center">
			<p class="text-sm font-medium tracking-widest text-primary uppercase">Members Only</p>
			<h1 class="mt-2 text-4xl font-semibold tracking-tight lg:text-5xl">Access denied</h1>
			<p class="mx-auto mt-4 max-w-md text-muted-foreground">
				This content is restricted to members of a specific Planning Center list.
				If you believe this is an error, please contact the church office.
			</p>
			<div class="mt-8 flex flex-wrap justify-center gap-3">
				<Button href="/">Back to home</Button>
				<Button href="/auth/logout" variant="outline">Sign out</Button>
			</div>
		</div>
	</section>
</Base>
