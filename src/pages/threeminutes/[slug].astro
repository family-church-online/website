---
export const prerender = true;

import Base from '../../layouts/Base.astro';
import { getConfig } from '../../lib/data';
import Icon from '../../components/Icon.astro';

interface ArticleFrontmatter {
	title?: string;
	date?: string;
	image?: string | null;
	description?: string | null;
}

export function getStaticPaths() {
	const mods = import.meta.glob<{ frontmatter: ArticleFrontmatter; default: any }>(
		'../../content/threeminutes/*.mdx',
		{ eager: true },
	);

	const all = Object.entries(mods)
		.map(([path, mod]) => ({
			slug: path.replace('../../content/threeminutes/', '').replace('.mdx', ''),
			frontmatter: mod.frontmatter,
			Content: mod.default,
		}))
		.sort((a, b) => (b.frontmatter.date ?? '').localeCompare(a.frontmatter.date ?? ''));

	return all.map((article, i) => ({
		params: { slug: article.slug },
		props: {
			frontmatter: article.frontmatter,
			Content: article.Content,
			prev: i < all.length - 1 ? { slug: all[i + 1].slug, title: all[i + 1].frontmatter.title } : null,
			next: i > 0 ? { slug: all[i - 1].slug, title: all[i - 1].frontmatter.title } : null,
		},
	}));
}

const { frontmatter: fm, Content, prev, next } = Astro.props as {
	frontmatter: ArticleFrontmatter;
	Content: any;
	prev: { slug: string; title?: string } | null;
	next: { slug: string; title?: string } | null;
};

const config    = (await getConfig()).data?.config ?? null;
const siteTitle = config?.seo?.title ?? 'Family Church';

function fmtDate(dateStr: string) {
	return new Date(dateStr.split('T')[0] + 'T00:00:00Z').toLocaleDateString('en-ZA', {
		weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
	});
}

const siteUrl = new URL('/', Astro.site).toString().replace(/\/$/, '');
const articleLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: fm.title,
	...(fm.date && { datePublished: fm.date }),
	...(fm.description && { description: fm.description }),
	...(fm.image && { image: fm.image.startsWith('http') ? fm.image : `${siteUrl}${fm.image}` }),
	url: `${siteUrl}/threeminutes/${Astro.params.slug}`,
	author: { '@type': 'Organization', name: siteTitle, url: siteUrl },
	publisher: {
		'@type': 'Organization',
		name: siteTitle,
		url: siteUrl,
		logo: { '@type': 'ImageObject', url: `${siteUrl}/images/logo-stone.png` },
	},
};
---

<Base
	title={`${fm.title ?? 'Article'} · ${siteTitle}`}
	description={fm.description ?? 'A Three Minutes article from Family Church.'}
	image={fm.image ?? undefined}
	ogType="article"
>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(articleLd)} />
	<div class="reveal max-w-[var(--content-width)] mx-auto px-4 sm:px-6 pt-10 pb-8 text-center">
		<p class="text-xs font-semibold uppercase tracking-widest text-[var(--olive)] mb-3">Three Minutes</p>
		<h1 class="font-display text-4xl font-semibold lg:text-5xl text-balance mb-3">{fm.title ?? 'Article'}</h1>
		{fm.date && (
			<time class="text-sm text-muted-foreground" datetime={fm.date}>{fmtDate(fm.date)}</time>
		)}
	</div>

	{fm.image && (
		<div class="reveal max-w-[var(--content-width)] mx-auto px-4 sm:px-6 mb-6">
			<img
				src={fm.image}
				alt={fm.title ?? ''}
				class="w-full rounded-2xl object-cover aspect-[3/1]"
			/>
		</div>
	)}

	<main class="max-w-[var(--content-width)] mx-auto px-4 sm:px-6 py-10">

		<div class="prose-guide">
			<Content />
		</div>

		<div class="reveal mt-12 rounded-2xl bg-[var(--navy)]/5 dark:bg-white/5 ring-1 ring-[var(--navy)]/10 dark:ring-white/10 px-6 py-8 text-center">
			<p class="text-xs font-semibold uppercase tracking-widest text-[var(--olive)] mb-2">Share</p>
			<h2 class="text-lg font-semibold text-[var(--navy)] dark:text-white mb-2">Know someone searching for faith?</h2>
			<p class="text-sm text-[var(--ink)]/65 dark:text-white/55 leading-relaxed mb-5 max-w-sm mx-auto">
				These articles are written to share. Copy the link and send it to a friend in a message or WhatsApp — they can read it in under three minutes.
			</p>
			<div class="flex gap-3 justify-center flex-wrap">
				<button
					id="share-btn"
					class="inline-flex items-center gap-2 rounded-lg bg-[var(--green)] text-white font-semibold text-sm px-5 py-2.5 hover:opacity-90 transition-opacity cursor-pointer"
				>
					<Icon name="copy" class="w-4 h-4 shrink-0" />
					<span id="share-btn-label">Copy link</span>
				</button>
				<a
					id="whatsapp-btn"
					href="#"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 rounded-lg bg-[#25D366] text-white font-semibold text-sm px-5 py-2.5 hover:opacity-90 transition-opacity"
				>
					<Icon name="whatsapp" class="w-4 h-4 shrink-0" />
					WhatsApp
				</a>
			</div>
			<p id="share-hint" class="text-sm text-[var(--green)] font-medium mt-3 opacity-0 transition-opacity duration-300">
				Link copied — open a new message and paste it in!
			</p>
		</div>

		{(prev || next) && (
			<nav class="reveal flex items-stretch gap-3 mt-6 mb-8">
				{prev ? (
					<a href={`/threeminutes/${prev.slug}`} class="group flex-1 flex items-center gap-3 bg-white dark:bg-[var(--card)] rounded-xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 px-5 py-4 hover:shadow-md transition-shadow">
						<Icon name="caret-left" class="shrink-0 w-4 h-4 text-[var(--navy)]/40 group-hover:text-[var(--green)] transition-colors" />
						<div class="min-w-0">
							<p class="text-xs font-bold uppercase tracking-widest text-[var(--ink)]/40 dark:text-white/40 mb-0.5">Prev</p>
							<p class="text-sm font-semibold text-[var(--navy)] dark:text-white group-hover:text-[var(--green)] transition-colors leading-snug line-clamp-1">{prev.title}</p>
						</div>
					</a>
				) : <div class="flex-1" />}

				{next ? (
					<a href={`/threeminutes/${next.slug}`} class="group flex-1 flex items-center justify-end gap-3 bg-white dark:bg-[var(--card)] rounded-xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 px-5 py-4 hover:shadow-md transition-shadow text-right">
						<div class="min-w-0">
							<p class="text-xs font-bold uppercase tracking-widest text-[var(--ink)]/40 dark:text-white/40 mb-0.5">Next</p>
							<p class="text-sm font-semibold text-[var(--navy)] dark:text-white group-hover:text-[var(--green)] transition-colors leading-snug line-clamp-1">{next.title}</p>
						</div>
						<Icon name="caret-right" class="shrink-0 w-4 h-4 text-[var(--navy)]/40 group-hover:text-[var(--green)] transition-colors" />
					</a>
				) : <div class="flex-1" />}
			</nav>
		)}

	</main>
</Base>

<script>
	const url = window.location.href;

	const btn = document.getElementById('share-btn');
	const label = document.getElementById('share-btn-label');
	const hint = document.getElementById('share-hint');
	btn?.addEventListener('click', async () => {
		try {
			await navigator.clipboard.writeText(url);
		} catch {
			const inp = document.createElement('input');
			inp.value = url;
			document.body.appendChild(inp);
			inp.select();
			document.execCommand('copy');
			document.body.removeChild(inp);
		}
		if (label) label.textContent = '✓ Copied!';
		if (hint) hint.style.opacity = '1';
		setTimeout(() => {
			if (label) label.textContent = 'Copy link';
			if (hint) hint.style.opacity = '0';
		}, 3000);
	});

	const waBtn = document.getElementById('whatsapp-btn');
	if (waBtn) {
		waBtn.setAttribute(
			'href',
			`https://wa.me/?text=${encodeURIComponent(`I thought you might enjoy this - ${url}`)}`,
		);
	}
</script>

<style>
	.prose-guide {
		color: var(--ink);
		line-height: 1.75;
	}
	:global(.dark) .prose-guide {
		color: rgba(255, 255, 255, 0.8);
	}
	.prose-guide :global(h2) {
		font-size: 1.05rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--olive);
		margin: 2.25rem 0 0.75rem;
	}
	.prose-guide :global(h3) {
		font-size: 0.875rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--olive);
		margin: 1.75rem 0 0.5rem;
	}
	.prose-guide :global(p) {
		margin: 0 0 1rem;
		color: var(--ink);
		opacity: 0.8;
	}
	:global(.dark) .prose-guide :global(p) {
		color: rgba(255, 255, 255, 0.75);
		opacity: 1;
	}
	.prose-guide :global(ul) {
		margin: 0.5rem 0 1.25rem 1.25rem;
		space-y: 0.5rem;
		list-style: disc;
	}
	.prose-guide :global(ul ul) {
		margin-top: 0.35rem;
		margin-bottom: 0.35rem;
		list-style: circle;
	}
	.prose-guide :global(li) {
		margin-bottom: 0.4rem;
		color: var(--ink);
		opacity: 0.8;
	}
	:global(.dark) .prose-guide :global(li) {
		color: rgba(255, 255, 255, 0.75);
		opacity: 1;
	}
	.prose-guide :global(strong) {
		font-weight: 600;
		color: var(--navy);
	}
	:global(.dark) .prose-guide :global(strong) {
		color: white;
	}
	.prose-guide :global(em) {
		font-style: italic;
	}
	.prose-guide :global(a) {
		color: var(--navy);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	:global(.dark) .prose-guide :global(a) {
		color: rgba(255, 255, 255, 0.8);
	}
	.prose-guide :global(a:hover) {
		color: var(--green);
	}
</style>
