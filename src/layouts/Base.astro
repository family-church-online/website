---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AnnouncementBanner from '../components/AnnouncementBanner.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { getConfig } from '../lib/data';
import { islands } from '../lib/islands';

interface Props {
	title: string;
	description: string;
	image?: string;
	noindex?: boolean;
	ogType?: string;
}

const { title, description, image, noindex, ogType } = Astro.props;
const config  = (await getConfig()).data?.config ?? null;
const banner  = config?.banner;
const bannerActive = !!(banner?.enabled && banner.text);
const siteUrl = new URL('/', Astro.site).toString().replace(/\/$/, '');

const orgLd = {
	'@context': 'https://schema.org',
	'@type': 'Church',
	name: config?.seo?.title ?? 'Family Church',
	url: siteUrl,
	...(config?.seo?.description && { description: config.seo.description }),
	logo: `${siteUrl}/images/logo-stone.png`,
	sameAs: (config?.contactLinks ?? [])
		.filter((l): l is NonNullable<typeof l> => !!l?.link)
		.map(l => l.link),
};
---

<!doctype html>
<html lang="en" style={bannerActive ? '--banner-h:2.25rem' : undefined}>
	<head>
		<BaseHead title={title} description={description} image={image} noindex={noindex} ogType={ogType} />
		<script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
		<slot name="head" />
	</head>
	<body>
		{bannerActive && <AnnouncementBanner text={banner!.text!} link={banner!.link} />}
		<TinaIsland name="global" wrapper={islands.global.wrapper}>
			<Header config={config} />
		</TinaIsland>
		<slot />
		<TinaIsland name="global-footer" wrapper={islands['global-footer'].wrapper}>
			<Footer config={config} />
		</TinaIsland>
		<script>
			// Nav: transparent at top, frosted when scrolled.
			// Re-query header after each View Transition swap so the reference stays fresh.
			let header = document.querySelector('header');
			document.addEventListener('astro:after-swap', () => { header = document.querySelector('header'); });
			const onScroll = () => header?.classList.toggle('nav-scrolled', window.scrollY > 60);
			window.addEventListener('scroll', onScroll, { passive: true });
			onScroll();

			// Scroll-reveal — re-init after each View Transition so new .reveal elements are observed.
			// Double-rAF before observing: ensures the browser has finished layout after the
			// View Transition swap before the IntersectionObserver starts measuring positions.
			// Without this, mobile browsers report already-visible elements as non-intersecting.
			let revealObserver: IntersectionObserver | null = null;
			function initReveal() {
				revealObserver?.disconnect();
				revealObserver = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						if (!entry.isIntersecting) return;
						const el = entry.target as HTMLElement;
						const delay = parseFloat(el.dataset.revealDelay ?? '0');
						setTimeout(() => el.classList.add('is-visible'), delay * 1000);
						revealObserver!.unobserve(el);
					});
				}, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
				requestAnimationFrame(() => requestAnimationFrame(() => {
					document.querySelectorAll('.reveal').forEach(el => revealObserver!.observe(el));
				}));
			}

			initReveal();
			document.addEventListener('astro:page-load', initReveal);
		</script>
	</body>
</html>
