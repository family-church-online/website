---
// ESV Cross-Reference Tool
// Scans page text for scripture references and makes them clickable popups.
// Drop <EsvCrossref /> into any page template to enable.
// Add class="esv-crossref-ignore" to any container to exclude it from scanning.
// Script is self-hosted at /js/esv-crossref.min.js — update by re-downloading:
//   curl https://static.esvmedia.org/crossref/crossref.min.js -o public/js/esv-crossref.min.js
---
<script is:inline>
(function () {
  var LIGHT = {
    border_color:            '273f61',
    border_radius:           10,
    header_font_color:       'ffffff',
    header_background_color: '273f61',
    body_font_color:         '14202f',
    body_background_color:   'ffffff',
    footer_font_color:       '8f926b',
    footer_background_color: 'f0f4f8',
  };
  var DARK = {
    border_color:            '3d5a7a',
    border_radius:           10,
    header_font_color:       'ffffff',
    header_background_color: '1e3a5f',
    body_font_color:         'dce4f0',
    body_background_color:   '1a2840',
    footer_font_color:       '8f926b',
    footer_background_color: '0f1a28',
  };
  function isDark() { return document.documentElement.classList.contains('dark'); }

  // Always refresh theme options — runs on every navigation so the options
  // stay in sync if the user toggled dark mode on a previous page.
  window.ESV_CROSSREF_OPTIONS = isDark() ? DARK : LIGHT;

  // Everything below only needs to run once across the whole session.
  // window._ESV_INIT survives View Transition navigations; the closure does not.
  if (window._ESV_INIT) return;
  window._ESV_INIT = true;

  // Reset cached iframes and link fetch state when theme changes.
  new MutationObserver(function () {
    window.ESV_CROSSREF_OPTIONS = isDark() ? DARK : LIGHT;
    document.querySelectorAll('iframe.esv-crossref').forEach(function (iframe) {
      iframe.src = 'about:blank';
    });
    document.querySelectorAll('a.esv-crossref-link').forEach(function (el) {
      el.ESV_FETCHED = false;
    });
  }).observe(document.documentElement, { attributeFilter: ['class'] });

  function triggerLinkify() {
    window.dispatchEvent(new Event('esv-crossref.trigger-linkify'));
  }

  // loaded tracks whether the external script has been appended.
  var loaded = false;
  function load() {
    if (loaded) return;
    loaded = true;
    ['scroll', 'mousemove', 'touchstart', 'keydown'].forEach(function (e) {
      document.removeEventListener(e, load);
    });
    var s = document.createElement('script');
    s.src = '/js/esv-crossref.min.js';
    s.onload = function () {
      // If window.load already fired (mobile/cached pages), the script's own
      // load listener won't fire — trigger linkify manually.
      if (document.readyState === 'complete') triggerLinkify();
    };
    document.body.appendChild(s);
  }

  // After each View Transition the page content is new but the script is
  // already loaded — just re-run linkify over the fresh DOM.
  document.addEventListener('astro:page-load', function () {
    if (loaded) triggerLinkify();
  });

  // Initial load: on idle (or 2 s timeout), or on first user interaction.
  if ('requestIdleCallback' in window) {
    requestIdleCallback(load, { timeout: 2000 });
  } else {
    setTimeout(load, 2000);
  }
  ['scroll', 'mousemove', 'touchstart', 'keydown'].forEach(function (e) {
    document.addEventListener(e, load, { passive: true });
  });
})();
</script>
