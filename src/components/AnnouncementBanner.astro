---
import Icon from './Icon.astro';
interface Props {
	text: string;
	link?: string | null;
}
const { text, link } = Astro.props;
---
<div class="announcement-banner">
	<Icon name="calendar" class="banner-icon" width="13" height="13" />
	{link
		? <a href={link} class="banner-inner">{text}</a>
		: <span class="banner-inner">{text}</span>
	}
</div>

<style>
	.announcement-banner {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 30;
		height: var(--banner-h);
		background: rgba(200, 64, 41, 0.75);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(0, 0, 0, 0.15);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.banner-inner {
		font-size: 0.78rem;
		font-weight: 600;
		color: #fff;
		text-decoration: none;
		letter-spacing: 0.02em;
		text-align: center;
		padding: 0 1rem;
	}
	a.banner-inner:hover { color: rgba(255, 255, 255, 0.8); text-decoration: underline; }
	.banner-icon {
		color: rgba(255, 255, 255, 0.8);
		flex-shrink: 0;
		margin-right: 0.5rem;
	}
</style>
