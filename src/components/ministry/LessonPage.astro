---
import Carousel from './Carousel.astro';
import Icon from '../Icon.astro';

interface LessonFrontmatter {
	title?: string;
	date?: string;
	scripture?: string;
	image?: string;
	mainScriptureText?: string;
	additionalScriptures?: string[];
	summary?: string;
	about?: string;
	takeaway?: string[];
	forYou?: string[];
	keyScripture?: string;
	bigIdea?: string;
	mainPoints?: Array<{ heading?: string; text?: string }>;
	keyIllustration?: string;
	meansForUs?: string[];
	remember?: string;
	images?: Array<{ image?: string; description?: string }>;
	videos?: Array<{ url?: string; description?: string }>;
	pdfs?: Array<{ file?: string; label?: string }>;
}

interface Props {
	label: string;
	baseRoute: string;
	date: string;
	frontmatter: LessonFrontmatter;
	prev: { slug: string; title?: string } | null;
	next: { slug: string; title?: string } | null;
}

const { label, baseRoute, date, frontmatter: fm, prev, next } = Astro.props;

function fmtDate(d: string) {
	return new Date(d + 'T00:00:00Z').toLocaleDateString('en-ZA', {
		weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
	});
}

const additionalScriptures = (fm.additionalScriptures ?? []).filter(Boolean);
const mainPoints  = (fm.mainPoints ?? []).filter(p => p?.heading || p?.text);
const takeaway    = (fm.takeaway ?? []).filter(Boolean);
const forYou      = (fm.forYou ?? []).filter(Boolean);
const meansForUs  = (fm.meansForUs ?? []).filter(Boolean);
const images      = (fm.images ?? []).filter(img => img?.image).map(img => ({ image: img.image, description: img.description }));
const videos      = (fm.videos ?? []).filter(v => v?.url).map(v => ({ url: v.url, description: v.description }));
const pdfs        = (fm.pdfs ?? []).filter(p => p?.file).map(p => ({ file: p.file!, label: p.label || 'Download PDF' }));
---

<!-- Page header -->
<div class="reveal max-w-[var(--content-width)] mx-auto px-4 sm:px-6 pt-10 pb-8 text-center esv-crossref-ignore">
	<p class="text-xs font-semibold uppercase tracking-widest text-[var(--olive)] mb-3">{label}</p>
	<h1 class="font-display text-4xl font-semibold lg:text-5xl text-balance mb-4">{fm.title ?? 'Lesson'}</h1>
	<div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-sm text-muted-foreground">
		{fm.scripture && <span class="font-medium text-foreground">{fm.scripture}</span>}
		{fm.scripture && <span class="opacity-30">·</span>}
		<time>{fmtDate(date)}</time>
	</div>
</div>

<main class="relative max-w-[var(--content-width)] mx-auto px-4 sm:px-6 pb-20">

	<!-- Hero image -->
	{fm.image && (
		<div class="reveal rounded-2xl overflow-hidden mb-6 h-56 sm:h-72 shadow-md esv-crossref-ignore" data-reveal-delay="0.05">
			<img
				src={fm.image}
				alt={fm.title ?? 'Lesson image'}
				class="w-full h-full object-cover scale-[1.20]"
			/>
		</div>
	)}

	<!-- Tab card -->
	<div class="lesson-card reveal bg-white dark:bg-[oklch(0.21_0.025_285)] rounded-2xl shadow-xl overflow-hidden mb-8 text-[var(--ink)]" data-reveal-delay="0.1">

		<!-- Tab bar -->
		<div class="flex border-b border-[var(--ink)]/10" role="tablist">
			<button role="tab" data-tab="about" aria-selected="true"  class="tab-btn flex-1 py-4 text-sm font-semibold tracking-wide transition-colors">About</button>
			<button role="tab" data-tab="notes" aria-selected="false" class="tab-btn flex-1 py-4 text-sm font-semibold tracking-wide transition-colors">Notes</button>
		</div>

		<!-- About panel -->
		<div data-panel="about" class="tab-panel">

			{/* Main scripture text */}
			{fm.mainScriptureText && (
				<div class="px-6 py-5 bg-[var(--ink)]/[0.02] border-b border-[var(--ink)]/8 esv-crossref-ignore">
					{fm.scripture && (
						<p class="text-xs font-bold uppercase tracking-widest text-[var(--olive)] mb-3">{fm.scripture}</p>
					)}
					<blockquote class="border-l-4 border-[var(--green)] pl-5">
						<p class="text-[var(--ink)]/80 text-sm leading-relaxed italic">{fm.mainScriptureText}</p>
					</blockquote>
				</div>
			)}

			{/* Summary */}
			{fm.summary && (
				<div class="px-6 py-5 border-b border-[var(--ink)]/8 esv-crossref-ignore">
					<p class="text-xs font-bold uppercase tracking-widest text-[var(--olive)] mb-3">Summary</p>
					<p class="text-sm text-[var(--ink)]/80 leading-relaxed">{fm.summary}</p>
				</div>
			)}

			{/* About */}
			{fm.about && (
				<div class="px-6 py-5 border-b border-[var(--ink)]/8 esv-crossref-ignore">
					<p class="text-xs font-bold uppercase tracking-widest text-[var(--olive)] mb-3">About</p>
					<p class="text-sm text-[var(--ink)]/80 leading-relaxed">{fm.about}</p>
				</div>
			)}

			{/* Takeaway + For You */}
			{(takeaway.length > 0 || forYou.length > 0) && (
				<div class={`grid border-b border-[var(--ink)]/8 esv-crossref-ignore ${takeaway.length > 0 && forYou.length > 0 ? 'md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-[var(--ink)]/8' : ''}`}>
					{takeaway.length > 0 && (
						<div class="px-6 py-5">
							<p class="text-xs font-bold uppercase tracking-widest text-[var(--olive)] mb-3">Takeaway</p>
							<ul class="space-y-2">
								{takeaway.map(t => (
									<li class="flex gap-2 text-sm text-[var(--ink)]/75 leading-snug">
										<span class="text-[var(--green)] mt-0.5 shrink-0">›</span>
										{t}
									</li>
								))}
							</ul>
						</div>
					)}
					{forYou.length > 0 && (
						<div class="px-6 py-5">
							<p class="text-xs font-bold uppercase tracking-widest text-[var(--olive)] mb-3">For You</p>
							<ul class="space-y-2">
								{forYou.map(t => (
									<li class="flex gap-2 text-sm text-[var(--ink)]/75 leading-snug">
										<span class="text-[var(--green)] mt-0.5 shrink-0">›</span>
										{t}
									</li>
								))}
							</ul>
						</div>
					)}
				</div>
			)}

			{/* Additional scriptures */}
			{additionalScriptures.length > 0 && (
				<div class="px-6 py-5">
					<p class="text-xs font-bold uppercase tracking-widest text-[var(--olive)] mb-3">Additional Scriptures</p>
					<ul class="space-y-3">
						{additionalScriptures.map(s => (
							<li class="text-sm text-[var(--ink)]/75 leading-relaxed italic border-l-2 border-[var(--ink)]/15 pl-4">{s}</li>
						))}
					</ul>
				</div>
			)}

		</div>
		<!-- end About panel -->

		<!-- Notes panel -->
		<div data-panel="notes" class="tab-panel hidden">

			{/* Big idea */}
			{fm.bigIdea && (
				<div class="big-idea px-6 py-5 bg-[var(--navy)] text-white esv-crossref-ignore">
					<p class="text-xs font-bold uppercase tracking-widest text-white/50 mb-2">The Big Idea</p>
					<p class="font-display text-lg font-semibold leading-snug">{fm.bigIdea}</p>
				</div>
			)}

			{/* Key scripture */}
			{fm.keyScripture && (
				<div class="px-6 py-5 bg-[var(--ink)]/[0.03] border-b border-[var(--ink)]/8">
					<p class="text-xs font-bold uppercase tracking-widest text-[var(--olive)] mb-3">Key Scripture</p>
					<blockquote class="border-l-4 border-[var(--green)] pl-5">
						<p class="text-[var(--ink)]/80 text-sm leading-relaxed italic">{fm.keyScripture}</p>
					</blockquote>
				</div>
			)}

			{/* Main points */}
			{mainPoints.length > 0 && (
				<div class="px-6 py-5 border-b border-[var(--ink)]/8 esv-crossref-ignore">
					<p class="text-xs font-bold uppercase tracking-widest text-[var(--olive)] mb-4">Main Points</p>
					<ol class="space-y-4">
						{mainPoints.map((pt, i) => (
							<li class="flex gap-4">
								<span class="shrink-0 w-6 h-6 rounded-full bg-[var(--navy)] text-white text-xs font-bold flex items-center justify-center mt-0.5">
									{i + 1}
								</span>
								<div>
									{pt.heading && <p class="font-semibold text-[var(--navy)] text-sm mb-1">{pt.heading}</p>}
									{pt.text && <p class="text-sm text-[var(--ink)]/70 leading-relaxed">{pt.text}</p>}
								</div>
							</li>
						))}
					</ol>
				</div>
			)}

			{/* Key illustration */}
			{fm.keyIllustration && (
				<div class="px-6 py-5 bg-[var(--ink)]/[0.03] border-b border-[var(--ink)]/8 esv-crossref-ignore">
					<p class="text-xs font-bold uppercase tracking-widest text-[var(--olive)] mb-3">Key Illustration</p>
					<p class="text-sm text-[var(--ink)]/75 leading-relaxed">{fm.keyIllustration}</p>
				</div>
			)}

			{/* Means for us */}
			{meansForUs.length > 0 && (
				<div class="px-6 py-5 border-b border-[var(--ink)]/8 esv-crossref-ignore">
					<p class="text-xs font-bold uppercase tracking-widest text-[var(--olive)] mb-3">What This Means for Us</p>
					<ul class="space-y-3">
						{meansForUs.map(a => (
							<li class="flex gap-3 text-sm text-[var(--ink)]/75 leading-relaxed">
								<span class="text-[var(--green)] font-bold shrink-0 mt-0.5">→</span>
								{a}
							</li>
						))}
					</ul>
				</div>
			)}

			{/* Remember */}
			{fm.remember && (
				<div class="px-6 py-5 bg-[var(--green)]/8 border-b border-[var(--ink)]/8 esv-crossref-ignore">
					<p class="text-xs font-bold uppercase tracking-widest text-[var(--olive)] mb-2">Remember</p>
					<p class="font-display text-lg font-semibold text-[var(--navy)] leading-snug">{fm.remember}</p>
				</div>
			)}

		</div>
		<!-- end Notes panel -->

	</div>
	<!-- end tab card -->

	<!-- Images carousel -->
	{images.length > 0 && (
		<div class="reveal mb-6 esv-crossref-ignore" data-reveal-delay="0.18">
			<Carousel slides={images} heading="Images" />
		</div>
	)}

	<!-- Videos carousel -->
	{videos.length > 0 && (
		<div class="reveal mb-6 esv-crossref-ignore" data-reveal-delay="0.22">
			<Carousel slides={videos} heading="Videos" />
		</div>
	)}

	<!-- PDFs -->
	{pdfs.length > 0 && (
		<div class="reveal mb-8 esv-crossref-ignore" data-reveal-delay="0.26">
			<p class="text-xs font-bold uppercase tracking-widest text-[var(--olive)] mb-3">Downloads</p>
			<div class="flex flex-wrap gap-3">
				{pdfs.map(p => (
					<a
						href={p.file}
						download
						class="inline-flex items-center gap-2 rounded-lg bg-white dark:bg-[var(--card)] ring-1 ring-[var(--navy)]/10 dark:ring-white/10 px-4 py-3 text-sm font-semibold text-[var(--navy)] dark:text-white hover:ring-[var(--green)]/50 hover:text-[var(--green)] transition-all no-underline shadow-sm"
					>
						<Icon name="download" class="w-4 h-4 shrink-0" />
						{p.label}
					</a>
				))}
			</div>
		</div>
	)}

	<!-- Prev / Next navigation -->
	{(prev || next) && (
		<nav class="reveal flex items-stretch gap-3 mt-2 mb-8 esv-crossref-ignore">
			{prev ? (
				<a href={`${baseRoute}/${prev.slug}`} class="group flex-1 flex items-center gap-3 bg-white dark:bg-[var(--card)] rounded-xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/10 px-5 py-4 hover:shadow-md transition-shadow no-underline">
					<Icon name="caret-left" class="shrink-0 w-4 h-4 text-[var(--navy)]/40 dark:text-white/40 group-hover:text-[var(--green)] transition-colors" />
					<div class="min-w-0">
						<p class="text-xs font-bold uppercase tracking-widest text-[var(--ink)]/40 dark:text-white/35 mb-0.5">Previous</p>
						<p class="text-sm font-semibold text-[var(--navy)] dark:text-[#8bbcde] group-hover:text-[var(--green)] transition-colors leading-snug line-clamp-1">{prev.title}</p>
					</div>
				</a>
			) : <div class="flex-1" />}

			{next ? (
				<a href={`${baseRoute}/${next.slug}`} class="group flex-1 flex items-center justify-end gap-3 bg-white dark:bg-[var(--card)] rounded-xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/10 px-5 py-4 hover:shadow-md transition-shadow text-right no-underline">
					<div class="min-w-0">
						<p class="text-xs font-bold uppercase tracking-widest text-[var(--ink)]/40 dark:text-white/35 mb-0.5">Next</p>
						<p class="text-sm font-semibold text-[var(--navy)] dark:text-[#8bbcde] group-hover:text-[var(--green)] transition-colors leading-snug line-clamp-1">{next.title}</p>
					</div>
					<Icon name="caret-right" class="shrink-0 w-4 h-4 text-[var(--navy)]/40 dark:text-white/40 group-hover:text-[var(--green)] transition-colors" />
				</a>
			) : <div class="flex-1" />}
		</nav>
	)}

</main>

<style>
.tab-btn[aria-selected="true"] {
  color: var(--navy);
  border-bottom: 2px solid var(--green);
}
.tab-btn[aria-selected="false"] {
  color: color-mix(in srgb, var(--ink) 55%, transparent);
}
.tab-btn[aria-selected="false"]:hover {
  color: var(--navy);
}

:global(.dark) .lesson-card {
  --ink: #dce4f0;
  --navy: #8bbcde;
}
:global(.dark) .big-idea {
  --navy: #273f61;
}
</style>

<script>
let _lessonAbort: AbortController | null = null;

function initLessonPage() {
  _lessonAbort?.abort();
  _lessonAbort = new AbortController();
  const { signal } = _lessonAbort;

  const tabBtns   = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const tabPanels = document.querySelectorAll<HTMLElement>('.tab-panel');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab!;
      tabBtns.forEach(b => b.setAttribute('aria-selected', b === btn ? 'true' : 'false'));
      tabPanels.forEach(p => {
        const show = p.dataset.panel === target;
        p.hidden = !show;
        p.classList.toggle('hidden', !show);
      });
    }, { signal });
  });
}

initLessonPage();
document.addEventListener('astro:page-load', initLessonPage);
</script>
