---
interface Props {
	href: string;
	date: string;
	title?: string;
	scripture?: string;
}

const { href, date, title, scripture } = Astro.props;

function fmtDate(d: string) {
	return new Date(d + 'T00:00:00Z').toLocaleDateString('en-ZA', {
		day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
	});
}
---

<a
	{href}
	class="group flex flex-col gap-1.5 bg-white dark:bg-[var(--card)] rounded-xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 px-5 py-4 hover:shadow-md hover:ring-[var(--green)]/40 transition-all no-underline"
>
	<time class="text-xs font-semibold text-[var(--olive)] uppercase tracking-widest" datetime={date}>
		{fmtDate(date)}
	</time>
	<p class="font-semibold text-[var(--navy)] dark:text-white group-hover:text-[var(--green)] transition-colors leading-snug">
		{title ?? 'Lesson'}
	</p>
	{scripture && (
		<p class="text-xs text-[var(--ink)]/50 dark:text-white/45 italic">{scripture}</p>
	)}
</a>
