---
import Icon from '../Icon.astro';

interface Slide {
	image?: string | null;
	url?: string | null;
	description?: string | null;
}

interface Props {
	slides: Slide[];
	heading?: string;
}

const { slides, heading } = Astro.props;

const processed = slides
	.filter(s => s.image || s.url)
	.map(s => ({
		...s,
		ytId:     s.url?.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([^&\n?#]+)/)?.[1] ?? null,
		vimeoId:  s.url?.match(/(?:vimeo\.com\/(?:video\/)?|player\.vimeo\.com\/video\/)(\d+)/)?.[1] ?? null,
	}));
---

{processed.length > 0 && (
	<div>
		{heading && (
			<h3 class="text-xs font-semibold uppercase tracking-widest text-[var(--olive)] mb-3">{heading}</h3>
		)}

		<div class="relative" data-carousel>
			<!-- Track wrapper: clips adjacent slides -->
			<div class="overflow-hidden rounded-xl shadow-md">
				<div class="flex" style="transition: transform .3s ease" data-carousel-track>
					{processed.map((slide) => (
						<div class="min-w-full flex-shrink-0 bg-white dark:bg-[var(--card)]">
							{slide.image && (
								<img
									src={slide.image}
									alt={slide.description ?? ''}
									class="w-full object-cover max-h-80"
									loading="lazy"
								/>
							)}
							{slide.ytId ? (
								<div class="aspect-video">
									<iframe
										src={`https://www.youtube.com/embed/${slide.ytId}`}
										title={slide.description ?? 'Video'}
										allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
										allowfullscreen
										class="w-full h-full"
									/>
								</div>
							) : slide.vimeoId ? (
								<div class="aspect-video">
									<iframe
										src={`https://player.vimeo.com/video/${slide.vimeoId}`}
										title={slide.description ?? 'Video'}
										allow="autoplay; fullscreen; picture-in-picture"
										allowfullscreen
										class="w-full h-full"
									/>
								</div>
							) : slide.url && !slide.image ? (
								<div class="flex items-center justify-center h-48 bg-[var(--navy)]/5 dark:bg-white/5">
									<a
										href={slide.url}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-[var(--green)] text-white font-semibold text-sm hover:opacity-90 transition-opacity"
									>
										Watch video
										<Icon name="arrow-right" class="w-3.5 h-3.5" />
									</a>
								</div>
							) : null}
							{slide.description && (
								<p class="px-4 py-3 text-sm text-[var(--ink)]/70 dark:text-white/60 border-t border-[var(--navy)]/8 dark:border-white/8">
									{slide.description}
								</p>
							)}
						</div>
					))}
				</div>
			</div>

			<!-- Prev / Next — outside overflow:hidden so they're never clipped -->
			{processed.length > 1 && (
				<>
					<button
						data-carousel-prev
						aria-label="Previous"
						class="absolute left-2 top-1/2 -translate-y-1/2 z-10 size-8 flex items-center justify-center rounded-full bg-white/90 dark:bg-black/60 shadow text-[var(--navy)] dark:text-white hover:bg-[var(--green)] hover:text-white transition-colors"
					>
						<Icon name="caret-left" class="w-3.5 h-3.5" />
					</button>
					<button
						data-carousel-next
						aria-label="Next"
						class="absolute right-2 top-1/2 -translate-y-1/2 z-10 size-8 flex items-center justify-center rounded-full bg-white/90 dark:bg-black/60 shadow text-[var(--navy)] dark:text-white hover:bg-[var(--green)] hover:text-white transition-colors"
					>
						<Icon name="caret-right" class="w-3.5 h-3.5" />
					</button>
				</>
			)}
		</div>

		<!-- Dots — below the carousel, outside overflow -->
		{processed.length > 1 && (
			<div class="flex justify-center gap-2 mt-3" data-carousel-dots>
				{processed.map((_, i) => (
					<button
						data-dot={i}
						aria-label={`Slide ${i + 1}`}
						class="size-2 rounded-full transition-colors"
						style={i === 0 ? 'background:var(--green)' : 'background:color-mix(in srgb,var(--navy) 20%,transparent)'}
					/>
				))}
			</div>
		)}
	</div>
)}

<script>
	for (const el of document.querySelectorAll('[data-carousel]')) {
		const track = el.querySelector<HTMLElement>('[data-carousel-track]')!;
		const dots  = el.querySelectorAll<HTMLButtonElement>('[data-dot]');
		const total = track.children.length;
		let cur = 0;

		const go = (n: number) => {
			cur = ((n % total) + total) % total;
			track.style.transform = `translateX(-${cur * 100}%)`;
			dots.forEach((d, i) => {
				d.style.background = i === cur
					? 'var(--green)'
					: 'color-mix(in srgb, var(--navy) 20%, transparent)';
			});
		};

		el.querySelector('[data-carousel-prev]')?.addEventListener('click', () => go(cur - 1));
		el.querySelector('[data-carousel-next]')?.addEventListener('click', () => go(cur + 1));
		dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
	}
</script>
