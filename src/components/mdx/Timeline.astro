---
interface Step { time?: string; label?: string; content?: string; }
interface Props { steps?: Step[]; }
const { steps } = Astro.props;
---
<div class="my-6 relative pl-2">
	<div class="absolute left-[1.1rem] top-2 bottom-2 w-0.5 bg-[var(--navy)]/12 dark:bg-white/12" />

	{steps ? (
		steps.map((s) => {
			const heading = [s.time, s.label].filter(Boolean).join(' — ');
			return (
				<div class="relative pl-9 pb-6 last:pb-0">
					<div class="absolute left-[0.6rem] top-[0.35rem] w-3 h-3 rounded-full bg-[var(--green)] ring-2 ring-white dark:ring-[var(--ink)]" />
					{heading && (
						<p class="text-xs font-bold uppercase tracking-widest text-[var(--olive)] mb-1">{heading}</p>
					)}
					{s.content && (
						<p class="text-[var(--ink)]/75 dark:text-white/70 text-sm leading-relaxed">{s.content}</p>
					)}
				</div>
			);
		})
	) : (
		<slot />
	)}
</div>
