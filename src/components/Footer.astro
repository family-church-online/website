---
import { tinaField } from "@tinacms/astro/tina-field";
import { Icon } from 'astro-icon/components';
import type { CmsConfig, CmsConfigContactLink } from '../lib/data';

interface Props {
	config?: CmsConfig | null;
}

const { config } = Astro.props;
const seo = config?.seo ?? null;
const nav = (config?.nav ?? []).filter(item => item !== null);
const contactLinks = (config?.contactLinks ?? []).filter(
	(item): item is CmsConfigContactLink => item !== null,
);
const year = new Date().getFullYear();
---

<footer>
	<div class="footer-inner">
		<div class="footer-grid">

			<!-- Left: Contact -->
			<div class="footer-col footer-col--left">
				<p class="footer-section-label">Contact</p>
				<div class="footer-social">
					{contactLinks.map((link) => (
						<a
							href={link.link}
							title={link.title}
							data-tina-field={tinaField(link, 'link')}
							target="_blank"
							rel="noopener noreferrer"
						>
							{link.icon && (
								link.icon.includes(':')
									? <Icon name={link.icon} />
									: <span aria-hidden="true">{link.icon}</span>
							)}
							<span class="sr-only">{link.title}</span>
						</a>
					))}
				</div>
			</div>

			<!-- Centre: Logo + Nav -->
			<div class="footer-col footer-col--center">
				<img
					src="/images/logo-stone.png"
					alt={seo?.title ?? 'Family Church'}
					class="footer-logo-stone"
				/>
				{nav.length > 0 && (
					<nav class="footer-links" aria-label="Footer navigation">
						{nav.map((item) => (
							<a href={item.link} data-tina-field={tinaField(item, 'title')}>{item.title}</a>
						))}
					</nav>
				)}
			</div>

			<!-- Right: Banking -->
			<div class="footer-col footer-col--right">
				<p class="footer-section-label">Banking Details</p>
				<div class="footer-banking">
					<p>Standard Bank</p>
					<p>Fourways Crossing Branch</p>
					<p>Account: 10130327822</p>
				</div>
			</div>

		</div>

		<p class="footer-copy">
			&copy; {year}
			<span data-tina-field={seo ? tinaField(seo, 'siteOwner') : undefined}>{seo?.siteOwner ?? seo?.title}</span>.
			All rights reserved.
		</p>
	</div>
</footer>

<style>
	footer {
		background: var(--ink);
		padding: 3.5rem 1.5rem;
	}

	.footer-inner {
		max-width: 64rem;
		margin: 0 auto;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		gap: 2rem;
		align-items: start;
		margin-bottom: 2.5rem;
	}

	.footer-col {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.footer-col--left {
		align-items: flex-start;
	}

	.footer-col--center {
		align-items: center;
		text-align: center;
	}

	.footer-col--right {
		align-items: flex-end;
		text-align: right;
	}

	.footer-section-label {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 10px;
		font-weight: 600;
		color: rgba(255, 255, 255, 0.2);
		margin: 0;
	}

	.footer-logo-stone {
		height: 3.25rem;
		width: auto;
		object-fit: contain;
		filter: brightness(1.4) opacity(0.9);
	}

	.footer-links {
		display: flex;
		gap: 1.5rem;
		flex-wrap: wrap;
		justify-content: center;
	}
	.footer-links a {
		color: rgba(255, 255, 255, 0.5);
		text-decoration: none;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 1px;
		text-transform: uppercase;
		transition: color 0.2s;
	}
	.footer-links a:hover { color: var(--green); }

	.footer-social {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}
	.footer-social a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.15);
		color: rgba(255, 255, 255, 0.5);
		text-decoration: none;
		transition: color 0.2s, border-color 0.2s;
	}
	.footer-social a:hover {
		color: var(--green);
		border-color: var(--green);
	}
	.footer-social svg {
		width: 1.1rem;
		height: 1.1rem;
	}

	.footer-banking {
		color: rgba(255, 255, 255, 0.35);
		font-size: 0.78rem;
		line-height: 1.7;
	}
	.footer-banking p { margin: 0; }

	.footer-copy {
		color: rgba(255, 255, 255, 0.2);
		font-size: 11px;
		margin: 0;
		text-align: center;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		padding-top: 1.5rem;
	}

	.sr-only {
		position: absolute;
		width: 1px; height: 1px;
		padding: 0; margin: -1px;
		overflow: hidden;
		clip: rect(0,0,0,0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 640px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
		.footer-col--left,
		.footer-col--right {
			align-items: center;
			text-align: center;
		}
	}
</style>
