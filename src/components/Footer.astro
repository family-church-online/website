---
import { tinaField } from "@tinacms/astro/tina-field";
import { Icon } from 'astro-icon/components';
import type { CmsConfig, CmsConfigContactLink } from '../lib/data';

interface Props {
	config?: CmsConfig | null;
}

const { config } = Astro.props;
const seo = config?.seo ?? null;
const nav = (config?.nav ?? []).filter(item => item !== null);
const contactLinks = (config?.contactLinks ?? []).filter(
	(item): item is CmsConfigContactLink => item !== null,
);
const year = new Date().getFullYear();
---

<footer>
	<div class="footer-inner">
		<img
		src="/images/logo-stone.png"
		alt={seo?.title ?? 'Family Church'}
		class="footer-logo-stone"
	/>

		{seo?.description && (
			<p class="footer-tagline" data-tina-field={tinaField(seo, 'description')}>
				{seo.description}
			</p>
		)}

		{nav.length > 0 && (
			<nav class="footer-links" aria-label="Footer navigation">
				{nav.map((item) => (
					<a href={item.link} data-tina-field={tinaField(item, 'title')}>{item.title}</a>
				))}
			</nav>
		)}

		{contactLinks.length > 0 && (
			<div class="footer-social">
				{contactLinks.map((link) => (
					<a
						href={link.link}
						title={link.title}
						data-tina-field={tinaField(link, 'link')}
						target="_blank"
						rel="noopener noreferrer"
					>
						{link.icon && <Icon name={link.icon} />}
						<span class="sr-only">{link.title}</span>
					</a>
				))}
			</div>
		)}

		<p class="footer-copy">
			&copy; {year}
			<span data-tina-field={seo ? tinaField(seo, 'siteOwner') : undefined}>{seo?.siteOwner ?? seo?.title}</span>.
			All rights reserved.
		</p>
	</div>
</footer>

<style>
	footer {
		background: var(--ink);
		padding: 3.5rem 1.5rem;
		text-align: center;
	}

	.footer-inner {
		max-width: 48rem;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
	}

	.footer-logo {
		height: 3.25rem;
		width: auto;
		object-fit: contain;
		filter: brightness(0) invert(1) opacity(0.85);
	}

	.footer-logo-stone {
		height: 3.25rem;
		width: auto;
		object-fit: contain;
		filter: brightness(1.4) opacity(0.9);
	}

	.footer-name {
		color: rgba(255, 255, 255, 0.9);
		font-size: 1.1rem;
		font-weight: 700;
		margin: 0;
	}

	.footer-tagline {
		color: rgba(255, 255, 255, 0.45);
		font-size: 0.82rem;
		line-height: 1.6;
		margin: 0;
		max-width: 32rem;
	}

	.footer-links {
		display: flex;
		gap: 1.75rem;
		flex-wrap: wrap;
		justify-content: center;
		margin: 0.25rem 0;
	}
	.footer-links a {
		color: rgba(255, 255, 255, 0.5);
		text-decoration: none;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 1px;
		text-transform: uppercase;
		transition: color 0.2s;
	}
	.footer-links a:hover { color: var(--green); }

	.footer-social {
		display: flex;
		gap: 1rem;
		justify-content: center;
	}
	.footer-social a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.15);
		color: rgba(255, 255, 255, 0.5);
		text-decoration: none;
		transition: color 0.2s, border-color 0.2s;
	}
	.footer-social a:hover {
		color: var(--green);
		border-color: var(--green);
	}
	.footer-social svg {
		width: 1.1rem;
		height: 1.1rem;
	}

	.footer-copy {
		color: rgba(255, 255, 255, 0.2);
		font-size: 11px;
		margin: 0.25rem 0 0;
	}

	.sr-only {
		position: absolute;
		width: 1px; height: 1px;
		padding: 0; margin: -1px;
		overflow: hidden;
		clip: rect(0,0,0,0);
		white-space: nowrap;
		border: 0;
	}
</style>
