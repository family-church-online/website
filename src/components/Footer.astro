---
import { tinaField } from "@tinacms/astro/tina-field";
import { Icon } from 'astro-icon/components';
import type { CmsConfig, CmsConfigContactLink } from '../lib/data';

interface Props {
	config?: CmsConfig | null;
}

const { config } = Astro.props;
const seo = config?.seo ?? null;
const nav = (config?.nav ?? []).filter(item => item !== null && item.title !== 'Home');
const contactLinks = (config?.contactLinks ?? []).filter(
	(item): item is CmsConfigContactLink => item !== null,
);
const year = new Date().getFullYear();
---

<footer>
	<div class="footer-inner">
		<div class="footer-grid">

			<!-- Left: Contact -->
			<div class="footer-contact">
				<p class="footer-label">Get in touch</p>
				<div class="footer-social">
					{contactLinks.map((link) => (
						<a
							href={link.link}
							title={link.title}
							data-tina-field={tinaField(link, 'link')}
							target="_blank"
							rel="noopener noreferrer"
						>
							{link.icon && (
								link.icon.includes(':')
									? <Icon name={link.icon} />
									: <span aria-hidden="true">{link.icon}</span>
							)}
							<span class="sr-only">{link.title}</span>
						</a>
					))}
				</div>
				<div class="footer-banking">
					<p class="footer-label" style="margin-bottom:0.5rem">Banking</p>
					<p>Standard Bank</p>
					<p>Fourways Crossing Branch</p>
					<p>Account: 10130327822</p>
				</div>
			</div>

			<!-- Right: Nav table — one column per top-level item -->
			{nav.length > 0 && (
				<nav class="footer-nav" aria-label="Footer navigation">
					{nav.map((item) => {
						const children = ((item as any).children ?? []).filter(Boolean);
						return (
							<div class="footer-nav-col">
								<p class="footer-label">
									{item.link
										? <a href={item.link} data-tina-field={tinaField(item, 'title')}>{item.title}</a>
										: <span data-tina-field={tinaField(item, 'title')}>{item.title}</span>
									}
								</p>
								{children.length > 0 && (
									<ul>
										{children.map((child: any) => (
											<li>
												<a href={child.link} data-tina-field={tinaField(child, 'title')}>{child.title}</a>
											</li>
										))}
									</ul>
								)}
							</div>
						);
					})}
				</nav>
			)}

		</div>

		<p class="footer-copy">
			&copy; {year}
			<span data-tina-field={seo ? tinaField(seo, 'siteOwner') : undefined}>{seo?.siteOwner ?? seo?.title}</span>.
			All rights reserved.
		</p>
	</div>
</footer>

<style>
	footer {
		background: var(--ink);
		padding: 3.5rem 1.5rem 1.5rem;
	}

	.footer-inner {
		max-width: var(--content-width);
		margin: 0 auto;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 14rem 1fr;
		gap: 0;
		align-items: start;
		margin-bottom: 1rem;
	}

	/* Left column */
	.footer-contact {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding-right: 2rem;
		border-right: 1px solid rgba(255, 255, 255, 0.1);
	}

	.footer-label {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 10px;
		font-weight: 600;
		color: var(--olive);
		margin: 0 0 0.5rem;
	}

	.footer-social {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}
	.footer-social a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.15);
		color: rgba(255, 255, 255, 0.5);
		text-decoration: none;
		transition: color 0.2s, border-color 0.2s;
	}
	.footer-social a:hover { color: var(--green); border-color: var(--green); }
	.footer-social svg { width: 1.1rem; height: 1.1rem; }

	.footer-banking {
		color: rgba(255, 255, 255, 0.35);
		font-size: 0.78rem;
		line-height: 1.8;
	}
	.footer-banking p { margin: 0; }

	/* Nav table */
	.footer-nav {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(6rem, 1fr));
		gap: 0.25rem;
		align-items: start;
		padding-left: 2rem;
		text-align: right;
	}

	.footer-nav-col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.footer-nav-col .footer-label a,
	.footer-nav-col .footer-label span {
		color: var(--olive);
		text-decoration: none;
		transition: color 0.2s;
	}
	.footer-nav-col .footer-label a:hover { color: var(--green); }

	.footer-nav-col ul a {
		color: rgba(255, 255, 255, 0.45);
		text-decoration: none;
		font-size: 0.75rem;
		font-weight: 500;
		transition: color 0.2s;
		display: block;
	}
	.footer-nav-col ul a:hover { color: rgba(255, 255, 255, 0.85); }

	/* Copyright */
	.footer-copy {
		color: rgba(255, 255, 255, 0.2);
		font-size: 11px;
		margin: 0;
		text-align: center;
		padding-top: 1.5rem;
	}

	.sr-only {
		position: absolute;
		width: 1px; height: 1px;
		padding: 0; margin: -1px;
		overflow: hidden;
		clip: rect(0,0,0,0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 768px) {
		.footer-grid {
			grid-template-columns: 1fr;
			gap: 0;
		}
		.footer-contact {
			border-right: none;
			border-bottom: 1px solid rgba(255, 255, 255, 0.1);
			padding-right: 0;
			padding-bottom: 2rem;
			margin-bottom: 2rem;
		}
		.footer-nav {
			padding-left: 0;
			text-align: left;
			grid-template-columns: repeat(2, 1fr);
			row-gap: 1.5rem;
		}
	}

	@media (max-width: 480px) {
		.footer-nav {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
