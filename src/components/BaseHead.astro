---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	description: string;
	image?: string;
	imageWidth?: number;
	imageHeight?: number;
	noindex?: boolean;
	ogType?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title, description,
	image = '/images/hero.jpg',
	imageWidth, imageHeight,
	noindex = false, ogType = 'website',
} = Astro.props;

// Known dimensions for the default hero fallback
const resolvedWidth  = imageWidth  ?? (image === '/images/hero.jpg' ? 1000 : undefined);
const resolvedHeight = imageHeight ?? (image === '/images/hero.jpg' ? 667  : undefined);
---

<script is:inline>
	(function () {
		function isDark() {
			try {
				const stored = localStorage.getItem('theme');
				return stored !== 'light';
			} catch (e) {
				return false;
			}
		}
		function apply() {
			document.documentElement.classList.toggle('dark', isDark());
		}
		apply();
		// ClientRouter swaps in the SSR'd <html> (no .dark) on navigation,
		// so re-apply the persisted theme after each swap, before paint.
		document.addEventListener('astro:after-swap', apply);
	})();
</script>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32 16x16" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="generator" content={Astro.generator} />

<!-- Fraunces display font -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap" rel="stylesheet" />

<!-- Tina Cloud rewrites media URLs to assets.tina.io in production; warm the connection. -->
<link rel="preconnect" href="https://assets.tina.io" crossorigin />
<link rel="dns-prefetch" href="https://assets.tina.io" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- RSS autodiscovery -->
<link rel="alternate" type="application/rss+xml" title="Family Church Sermons" href="/sermons/feed.xml" />
<link rel="alternate" type="application/rss+xml" title="Family Church Daily Devotions" href="/devotion/feed.xml" />
{noindex && <meta name="robots" content="noindex,follow" />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Family Church" />
<meta property="og:locale" content="en_ZA" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
{resolvedWidth  && <meta property="og:image:width"  content={String(resolvedWidth)} />}
{resolvedHeight && <meta property="og:image:height" content={String(resolvedHeight)} />}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- TinaCMS visual editing is wired by the tina() integration in astro.config.mjs; its middleware only touches edit-mode responses, so there's nothing to add here. -->

<ClientRouter />
