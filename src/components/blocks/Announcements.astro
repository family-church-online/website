---
import { tinaField } from '@tinacms/astro/tina-field';
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { listAnnouncements } from '../../lib/data';

interface Props {
	data: {
		heading?: string | null;
	};
}

const { data } = Astro.props;

const today = new Date().toISOString().split('T')[0];
const all = await listAnnouncements();
const active = all.filter(
	(a) => !a.expiryDate || a.expiryDate.slice(0, 10) >= today,
);
---

{active.length > 0 && (
	<section class="bg-[var(--background)] pt-4 pb-12">
		<div class="max-w-[var(--content-width)] mx-auto px-6 text-center">
			{data.heading && (
				<h2
					data-tina-field={tinaField(data, 'heading')}
					class="font-display text-4xl font-semibold text-[var(--ink)] dark:text-white tracking-tight mb-6"
				>{data.heading}</h2>
			)}
			<ul class="flex flex-col gap-4">
				{active.map((item) => (
					<li class="reveal flex flex-col gap-2 bg-white dark:bg-[var(--card)] rounded-xl px-5 py-4 ring-1 ring-[var(--navy)]/8 dark:ring-white/8 border-l-4 border-[var(--green)]">
						<p class="font-semibold text-[var(--ink)] dark:text-white">{item.title}</p>
						{item.body && (
							<div class="text-sm text-[var(--ink)]/65 dark:text-white/55 leading-relaxed prose prose-sm max-w-none">
								<TinaMarkdown content={item.body} />
							</div>
						)}
						{item.link && (
							<a
								href={item.link}
								class="self-center text-sm font-semibold text-[var(--navy)] dark:text-white hover:text-[var(--green)] dark:hover:text-[var(--green)] transition-colors"
							>
								{item.linkLabel ?? 'Learn more'} →
							</a>
						)}
					</li>
				))}
			</ul>
		</div>
	</section>
)}
