---
import { tinaField } from '@tinacms/astro/tina-field';
import Icon from '../Icon.astro';

interface SermonFrontmatter {
	title?: string;
	date?: string;
	series?: string | null;
	image?: string | null;
	review?: boolean;
}

interface Props {
	data: {
		heading?: string | null;
		count?: number | null;
	};
}

const { data } = Astro.props;
const heading = data.heading ?? 'Recent Sermons';
const count   = data.count   ?? 5;

const sermonModules = import.meta.glob<{ frontmatter: SermonFrontmatter }>(
	'../../content/sermons/*.mdx',
	{ eager: true },
);

const recentSermons = Object.entries(sermonModules)
	.map(([path, mod]) => ({
		slug: path.replace('../../content/sermons/', '').replace('.mdx', ''),
		...mod.frontmatter,
	}))
	.filter(s => !s.review)
	.sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''))
	.slice(0, count);

function fmtDate(dateStr: string) {
	return new Date(dateStr).toLocaleDateString('en-ZA', {
		day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
	});
}
---

{recentSermons.length > 0 && (
	<section id="catchup" class="bg-[var(--background)] py-12">
		<div class="max-w-[var(--content-width)] mx-auto px-6 mb-5 text-center reveal">
			<h2
				data-tina-field={tinaField(data, 'heading')}
				class="font-display text-4xl font-semibold text-[var(--ink)] dark:text-white tracking-tight mb-3"
			>{heading}</h2>
			<a
				href="/sermons"
				class="inline-block px-5 py-2 rounded-full border border-[var(--navy)] dark:border-white/40 text-sm font-medium text-[var(--navy)] dark:text-white hover:bg-[var(--navy)] hover:text-white dark:hover:bg-white/10 transition-colors"
			>All sermons →</a>
		</div>

		<div class="relative max-w-[var(--content-width)] mx-auto px-6">
			<ul
				id="recent-sermon-carousel"
				class="flex gap-4 overflow-x-auto pb-2 scrollbar-hide"
				style="scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;"
			>
				{recentSermons.map((s, i) => (
					<li class="sermon-card scroll-snap-start shrink-0 w-[52vw] max-w-[180px] sm:w-[22%]">
						<a
							href={`/sermons/${s.slug}`}
							class="group flex flex-col bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 overflow-hidden hover:shadow-md transition-shadow h-full"
						>
							<div class="aspect-video bg-[var(--navy)]/10 dark:bg-white/5 overflow-hidden">
								{s.image ? (
									<img
										src={s.image}
										alt={s.title ?? ''}
										class="w-full h-full object-cover scale-[1.70] group-hover:scale-[1.80] transition-transform duration-300"
										loading="lazy"
									/>
								) : (
									<div class="w-full h-full flex items-center justify-center">
										<Icon name="music-note" class="w-10 h-10 text-[var(--navy)]/25 dark:text-white/20" />
									</div>
								)}
							</div>
							<div class="px-4 py-3 flex-1 flex flex-col justify-between gap-1 text-center">
								<p class="font-semibold text-[var(--navy)] dark:text-white group-hover:text-[var(--green)] dark:group-hover:text-[var(--green)] transition-colors leading-snug line-clamp-2 text-sm">
									{s.title}
								</p>
								<p class="text-xs text-[var(--ink)]/50 dark:text-white/50">
									{s.date ? fmtDate(s.date) : ''}
									{s.series ? ` · ${s.series}` : ''}
								</p>
							</div>
						</a>
					</li>
				))}
			</ul>

			<button id="recent-sermon-prev" aria-label="Previous" class="carousel-btn left-1">
				<Icon name="caret-left" class="w-5 h-5" />
			</button>
			<button id="recent-sermon-next" aria-label="Next" class="carousel-btn right-1">
				<Icon name="caret-right" class="w-5 h-5" />
			</button>
		</div>

	</section>
)}

<style>
.scrollbar-hide { scrollbar-width: none; }
.scrollbar-hide::-webkit-scrollbar { display: none; }
.scroll-snap-start { scroll-snap-align: start; }

/* Cards start invisible; GSAP animates them in */
.sermon-card { opacity: 0; transform: translateX(32px); }
@media (prefers-reduced-motion: reduce) {
	.sermon-card { opacity: 1; transform: none; }
}

.carousel-btn {
	display: none;
	position: absolute;
	top: 50%;
	transform: translateY(-50%);
	z-index: 10;
	background: white;
	border: 1px solid rgba(20,32,47,0.12);
	border-radius: 9999px;
	width: 2.25rem;
	height: 2.25rem;
	align-items: center;
	justify-content: center;
	box-shadow: 0 2px 8px rgba(0,0,0,0.1);
	color: var(--navy);
	cursor: pointer;
	transition: box-shadow 0.15s;
}
.carousel-btn:hover { box-shadow: 0 4px 14px rgba(0,0,0,0.15); }
.carousel-btn:disabled { opacity: 0.35; pointer-events: none; }

@media (hover: hover) {
	.carousel-btn { display: flex; }
}
</style>

<script>
import gsap from 'gsap';
import ScrollTrigger from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);

document.addEventListener('astro:page-load', () => {
	// ── Carousel controls ─────────────────────────────────────────────────────
	const track = document.getElementById('recent-sermon-carousel');
	const prev  = document.getElementById('recent-sermon-prev') as HTMLButtonElement | null;
	const next  = document.getElementById('recent-sermon-next') as HTMLButtonElement | null;
	if (!track || !prev || !next) return;

	function cardWidth() {
		const card = track!.querySelector('li');
		return card ? card.offsetWidth + 16 : 300;
	}

	prev.addEventListener('click', () => track.scrollBy({ left: -cardWidth(), behavior: 'smooth' }));
	next.addEventListener('click', () => track.scrollBy({ left:  cardWidth(), behavior: 'smooth' }));

	function updateButtons() {
		prev!.disabled = track!.scrollLeft <= 4;
		next!.disabled = track!.scrollLeft + track!.offsetWidth >= track!.scrollWidth - 4;
	}

	track.addEventListener('scroll', updateButtons, { passive: true });
	updateButtons();

	// ── Card entrance animation ───────────────────────────────────────────────
	const cards = track.querySelectorAll<HTMLElement>('.sermon-card');
	if (!cards.length || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

	gsap.to(cards, {
		opacity: 1,
		x: 0,
		duration: 0.55,
		ease: 'power3.out',
		stagger: 0.08,
		scrollTrigger: {
			trigger: track,
			start: 'top 85%',
			once: true,
		},
	});
});
</script>
