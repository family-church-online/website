---
import Icon from '../Icon.astro';

interface Props { revealDelay?: string }
const { revealDelay = '0.1' } = Astro.props;

interface NotesFrontmatter { title?: string; date?: string; speaker?: string; series?: string; scripture?: string; image?: string; }
interface SermonFrontmatter { date?: string; review?: boolean; }

const notesMods  = import.meta.glob<NotesFrontmatter>('../../content/sermon-notes/current.mdx', { eager: true, import: 'frontmatter' });
const sermonMods = import.meta.glob<SermonFrontmatter>('../../content/sermons/*.mdx', { eager: true, import: 'frontmatter' });
const notesFm = Object.values(notesMods)[0] ?? {};

const nowSA    = new Date(new Date().toLocaleString('en-US', { timeZone: 'Africa/Johannesburg' }));
const isSunday = nowSA.getDay() === 0;
const todayStr = nowSA.toLocaleDateString('en-CA', { timeZone: 'Africa/Johannesburg' });

// TinaCMS datetime fields are auto-parsed to Date objects by Astro's YAML parser.
// Pass directly to new Date() and format in SA timezone — never call .slice() on the value.
const notesDateYMD     = notesFm.date
	? new Date(notesFm.date as string).toLocaleDateString('en-CA', { timeZone: 'Africa/Johannesburg' })
	: '';
const notesAreForToday = notesDateYMD === todayStr;
const hasTodaySermon   = Object.values(sermonMods).some(m => {
	const d = m.date;
	if (!d) return false;
	// js-yaml parses unquoted YYYY-MM-DD as a UTC midnight Date object
	const ymd = d instanceof Date ? d.toISOString().slice(0, 10) : String(d);
	return ymd === todayStr;
});
const showNotesCard = !!notesFm.title && !hasTodaySermon && (import.meta.env.DEV || (isSunday && notesAreForToday));
---

{showNotesCard && (
	<>
		<div class="py-4 reveal" data-reveal-delay={revealDelay}>
			<div class="bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 overflow-hidden">
				<div class="px-6 pt-5 pb-4 flex items-start gap-4">
					{notesFm.image && (
						<div class="w-16 h-16 rounded-xl overflow-hidden shrink-0">
							<img src={notesFm.image} alt={notesFm.title ?? ''} class="w-full h-full object-cover scale-[1.35]" />
						</div>
					)}
					<div class="flex-1 min-w-0">
						{notesFm.series && (
							<p class="text-[10px] font-bold uppercase tracking-widest text-[var(--olive)] mb-1">{notesFm.series}</p>
						)}
						<p class="font-semibold text-[var(--navy)] dark:text-white leading-snug">{notesFm.title ?? 'Sermon Notes'}{notesFm.scripture ? `: ${notesFm.scripture}` : ''}</p>
						{notesFm.speaker && (
							<p class="text-sm text-[var(--ink)]/55 dark:text-white/45 mt-0.5">{notesFm.speaker}</p>
						)}
					</div>
				</div>
				<div class="px-6 pb-5">
					<button id="notes-card-btn" class="w-full flex items-center justify-center gap-2 bg-[var(--navy)] hover:bg-[var(--green)] text-white font-semibold text-sm py-3 rounded-xl transition-colors">
						<Icon name="note" class="w-4 h-4 shrink-0" />
						Open Sermon Notes
					</button>
				</div>
			</div>
		</div>

		{/* Sermon Notes drawer — fixed+overflow-hidden wrapper clips the off-screen drawer so it
		    doesn't create horizontal overflow on mobile (translate-x-full on fixed bypasses overflow-x:hidden) */}
		<div class="fixed inset-0 z-50 pointer-events-none overflow-hidden">
			<div id="notes-overlay" class="hidden absolute inset-0 bg-black/50 cursor-pointer pointer-events-auto"></div>
			<div id="notes-drawer" class="absolute inset-y-0 right-0 w-full sm:w-[520px] bg-white dark:bg-[var(--card)] shadow-2xl flex flex-col translate-x-full transition-transform duration-300 pointer-events-auto">
				<div class="flex items-center justify-between px-5 py-4 border-b border-[var(--navy)]/10 dark:border-white/10 shrink-0">
					<span class="font-semibold text-sm text-[var(--navy)] dark:text-white">Sermon Notes</span>
					<button id="notes-close" class="text-[var(--ink)]/50 dark:text-white/50 hover:text-[var(--ink)] dark:hover:text-white transition-colors">
						<Icon name="x" class="w-5 h-5" />
					</button>
				</div>
				<iframe id="notes-frame" class="flex-1 border-0 w-full" title="Sermon Notes"></iframe>
			</div>
		</div>
	</>
)}

<script>
function initSermonNotes() {
	const cardBtn = document.getElementById('notes-card-btn');
	if (!cardBtn) return;

	const overlay = document.getElementById('notes-overlay');
	const drawer  = document.getElementById('notes-drawer');
	const frame   = document.getElementById('notes-frame') as HTMLIFrameElement | null;
	const close   = document.getElementById('notes-close');
	if (!overlay || !drawer || !frame) return;

	function openDrawer() {
		if (!frame.src.includes('sermon-notes')) frame.src = new URLSearchParams(location.search).has('preview') ? '/sermon-notes?preview' : '/sermon-notes';
		overlay.classList.remove('hidden');
		drawer.classList.remove('translate-x-full');
	}
	function closeDrawer() {
		drawer.classList.add('translate-x-full');
		overlay.classList.add('hidden');
	}

	cardBtn.addEventListener('click', openDrawer);
	overlay.addEventListener('click', closeDrawer);
	close?.addEventListener('click', closeDrawer);
}

document.addEventListener('astro:page-load', initSermonNotes);
document.addEventListener('DOMContentLoaded', initSermonNotes);
</script>
