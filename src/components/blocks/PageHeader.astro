---
import { tinaField } from '@tinacms/astro/tina-field';
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import Section from '../ui/Section.astro';

interface Props {
	data: {
		label?: string | null;
		heading?: string | null;
		subtitle?: string | null;
		// eslint-disable-next-line @typescript-eslint/no-explicit-any
		body?: any;
	};
}

const { data } = Astro.props;
---
<Section>
	<div class="mx-auto max-w-[var(--content-width)]">
		{data.label && (
			<p data-tina-field={tinaField(data, 'label')}
				class="mb-4 text-center text-xs font-semibold uppercase tracking-widest text-[var(--olive)]">
				{data.label}
			</p>
		)}
		{data.heading && (
			<h1 data-tina-field={tinaField(data, 'heading')}
				class="text-balance text-center text-4xl font-semibold lg:text-5xl">
				{data.heading}
			</h1>
		)}
		{data.subtitle && (
			<p data-tina-field={tinaField(data, 'subtitle')}
				class="mx-auto mt-4 max-w-xl text-center text-lg leading-relaxed text-muted-foreground">
				{data.subtitle}
			</p>
		)}
		{data.body && (
			<div data-tina-field={tinaField(data, 'body')}
				class="prose prose-lg mt-12 max-w-none text-muted-foreground">
				<TinaMarkdown content={data.body} />
			</div>
		)}
	</div>
</Section>
