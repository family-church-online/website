---
import { tinaField } from '@tinacms/astro/tina-field';
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import Section from '../ui/Section.astro';
import { mdxComponents } from '../mdx/components';

interface Props {
	data: {
		label?: string | null;
		heading?: string | null;
		subtitle?: string | null;
		// eslint-disable-next-line @typescript-eslint/no-explicit-any
		body?: any;
	};
}

const { data } = Astro.props;
---
<Section>
	<div class="mx-auto max-w-[var(--content-width)]">

		<div class="text-center mb-10">
			{data.label && (
				<p data-tina-field={tinaField(data, 'label')}
					class="text-xs font-semibold uppercase tracking-widest text-[var(--olive)] mb-3">
					{data.label}
				</p>
			)}
			{data.heading && (
				<h1 data-tina-field={tinaField(data, 'heading')}
					class="font-display text-4xl font-semibold lg:text-5xl text-balance mb-4">
					{data.heading}
				</h1>
			)}
			{data.subtitle && (
				<p data-tina-field={tinaField(data, 'subtitle')}
					class="mx-auto max-w-xl text-lg leading-relaxed text-[var(--ink)]/70 dark:text-white/60">
					{data.subtitle}
				</p>
			)}
		</div>

		{data.body && (
			<div data-tina-field={tinaField(data, 'body')} class="body-prose">
				<TinaMarkdown content={data.body} components={mdxComponents} />
			</div>
		)}

	</div>
</Section>

<style>
.body-prose :global(p) {
	color: rgba(20, 32, 47, 0.80);
	line-height: 1.75;
	margin-bottom: 1.25rem;
}
:global(.dark) .body-prose :global(p) {
	color: rgba(255, 255, 255, 0.75);
}
.body-prose :global(h2) {
	font-family: var(--font-body);
	font-size: 0.75rem;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.08em;
	color: var(--olive);
	margin-top: 2.5rem;
	margin-bottom: 0.75rem;
}
.body-prose :global(blockquote) {
	border-left: 4px solid var(--green);
	padding-left: 1.25rem;
	margin: 1.5rem 0;
	font-style: italic;
	color: rgba(20, 32, 47, 0.75);
	line-height: 1.75;
}
:global(.dark) .body-prose :global(blockquote) {
	color: rgba(255, 255, 255, 0.70);
}
.body-prose :global(blockquote p) {
	margin-bottom: 0;
}
</style>
