---
import { tinaField } from '@tinacms/astro/tina-field';
import type { HeroBlock } from '../../lib/data';

interface Props { data: HeroBlock }

const { data } = Astro.props;
const actions = (data.actions ?? []).filter(a => a !== null);
---
<section
	id="hero"
	style={{
		position: 'relative',
		minHeight: 'calc(100vh + 5rem)',
		marginTop: '-5rem',
		display: 'flex',
		alignItems: 'center',
		justifyContent: 'center',
		overflow: 'hidden',
		background: 'var(--navy)',
	}}
>
	<div
		data-tina-field={tinaField(data, 'backgroundImage')}
		style={{
			position: 'absolute',
			inset: '0',
			backgroundImage: data.backgroundImage ? `url('${data.backgroundImage}')` : undefined,
			backgroundSize: 'cover',
			backgroundPosition: 'center 35%',
			backgroundRepeat: 'no-repeat',
		}}
	></div>

	<div style={{
		position: 'absolute',
		inset: '0',
		background: 'linear-gradient(180deg, rgba(20,32,47,0.6) 0%, rgba(20,32,47,0.45) 40%, rgba(20,32,47,0.88) 100%)',
	}}></div>

	<div class="hero-content" style={{ position: 'relative', zIndex: '2', textAlign: 'center', maxWidth: '640px', padding: '2rem 1.5rem', width: '100%', marginTop: '5rem' }}>
		{data.logo?.src && (
			<img
				src={data.logo.src}
				alt={data.logo.alt ?? 'Family Church'}
				data-tina-field={tinaField(data, 'logo')}
				class="hero-logo"
			/>
		)}

		{data.tagline && (
			<p
				data-tina-field={tinaField(data, 'tagline')}
				class="hero-sub"
			>
				{data.tagline}
			</p>
		)}

		{actions.length > 0 && (
			<div class="hero-cta" data-tina-field={tinaField(data, 'actions')}>
				{actions.map((action) => (
					<a
						href={action.link ?? '#'}
						data-tina-field={tinaField(action)}
						class={`btn ${action.style === 'ghost' ? 'btn-ghost' : 'btn-primary'}`}
					>
						{action.label}
					</a>
				))}
			</div>
		)}
	</div>

	<div class="service-strip" aria-label="Service times">
		<div class="service-strip-inner">
			<span class="service-item">
				<svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
					<circle cx="10" cy="10" r="8"/><path d="M10 6v4l2.5 2.5" stroke-linecap="round"/>
				</svg>
				<span><strong>Sundays</strong> · 09:30</span>
			</span>
			<span class="strip-dot" aria-hidden="true">·</span>
			<span class="service-item">
				<svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
					<path d="M10 2a6 6 0 0 1 6 6c0 4-6 10-6 10S4 12 4 8a6 6 0 0 1 6-6z"/><circle cx="10" cy="8" r="2"/>
				</svg>
				<span>Dainfern College, Johannesburg</span>
			</span>
		</div>
	</div>
</section>

<style>
	.hero-logo {
		width: min(420px, 78vw);
		height: auto;
		margin: 0 auto 1.75rem;
		filter: drop-shadow(0 6px 28px rgba(0, 0, 0, 0.4));
	}

	.hero-sub {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: clamp(1.05rem, 2.4vw, 1.4rem);
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.92);
		margin: 0 0 2.25rem;
		text-wrap: balance;
	}

	.hero-cta {
		display: flex;
		gap: 0.9rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.btn {
		display: inline-block;
		padding: 0.85rem 1.9rem;
		border-radius: 999px;
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 0.92rem;
		letter-spacing: 0.2px;
		text-decoration: none;
		transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
	}

	.btn-primary {
		background: var(--green);
		color: var(--ink);
	}
	.btn-primary:hover {
		transform: translateY(-2px);
		background: #a3d63a;
	}

	.btn-ghost {
		color: var(--white);
		border: 1.5px solid rgba(255, 255, 255, 0.55);
	}
	.btn-ghost:hover {
		transform: translateY(-2px);
		border-color: var(--white);
		background: rgba(255, 255, 255, 0.08);
	}

	.service-strip {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		z-index: 3;
		background: rgba(20, 32, 47, 0.65);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}
	.service-strip-inner {
		max-width: 640px;
		margin: 0 auto;
		padding: 0.8rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.25rem;
		color: rgba(255, 255, 255, 0.82);
		font-size: 0.875rem;
		letter-spacing: 0.01em;
	}
	.service-item {
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}
	.service-item strong {
		color: rgba(255, 255, 255, 0.95);
		font-weight: 600;
	}
	.strip-dot {
		opacity: 0.35;
		font-size: 1.1rem;
	}

	@media (max-width: 480px) {
		.hero-cta { flex-direction: column; align-items: center; }
		.btn { width: 100%; max-width: 260px; text-align: center; }
		.service-strip-inner { flex-direction: column; gap: 0.5rem; padding: 0.75rem 1.5rem; }
		.strip-dot { display: none; }
	}
</style>

<script>
	import gsap from 'gsap';
	gsap.timeline({ delay: 0.15 })
		.from('#hero .hero-logo',  { opacity: 0, y: 20, duration: 0.7, ease: 'power3.out' })
		.from('#hero .hero-sub',   { opacity: 0, y: 20, duration: 0.6, ease: 'power2.out' }, '-=0.3')
		.from('#hero .hero-cta',   { opacity: 0, y: 20, duration: 0.5, ease: 'power2.out' }, '-=0.25')
		.from('#hero .service-strip', { opacity: 0, duration: 0.5, ease: 'power1.out' }, '-=0.1');
</script>
