---
import { tinaField } from '@tinacms/astro/tina-field';
import type { HeroBlock } from '../../lib/data';

interface Props { data: HeroBlock }

const { data } = Astro.props;
const actions = (data.actions ?? []).filter(a => a !== null);
---
<section
	id="hero"
	class="hero-section"
	style={{
		position: 'relative',
		minHeight: 'calc(70vh + 5rem)',
		marginTop: '-5rem',
		overflow: 'hidden',
		background: 'var(--navy)',
	}}
>
	<div
		class="hero-bg"
		data-tina-field={tinaField(data, 'backgroundImage')}
		style={{
			backgroundImage: data.backgroundImage ? `url('${data.backgroundImage}')` : undefined,
		}}
	></div>

	<div class="hero-overlay"></div>

	<div class="hero-content" style={{ position: 'relative', zIndex: '2', marginTop: '5rem' }}>

		{data.tagline && (
			<p
				data-tina-field={tinaField(data, 'tagline')}
				class="hero-tagline"
			>
				{data.tagline}
			</p>
		)}

		{(data.serviceInfo ?? 'Sundays 09:30 · Dainfern College, Johannesburg') && (
			<p class="hero-service" data-tina-field={tinaField(data, 'serviceInfo')}>
				<span class="service-dot" aria-hidden="true"></span>
				<span>{data.serviceInfo ?? 'Sundays 09:30 · Dainfern College, Johannesburg'}</span>
			</p>
		)}

		{(data.eyebrow ?? 'love, worship, honour & obey') && (
			<p class="hero-eyebrow" aria-label="Our mission" data-tina-field={tinaField(data, 'eyebrow')}>
				<span class="eyebrow-dot" aria-hidden="true"></span>
				{data.eyebrow ?? 'love, worship, honour & obey'}
			</p>
		)}

		{actions.length > 0 && (
			<div class="hero-cta" data-tina-field={tinaField(data, 'actions')}>
				{actions.map((action) => (
					<a
						href={action.link ?? '#'}
						data-tina-field={tinaField(action)}
						class={`btn ${action.style === 'ghost' ? 'btn-ghost' : 'btn-primary'}`}
					>
						{action.label}
					</a>
				))}
			</div>
		)}
	</div>
</section>

<style>
	.hero-bg {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-repeat: no-repeat;
		background-position: center 35%;
	}

	/* Navy overlay — mobile: vertical vignette */
	.hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(20,32,47,0.70) 0%,
			rgba(20,32,47,0.50) 45%,
			rgba(20,32,47,0.80) 100%
		);
	}

	.hero-section {
		display: flex;
		align-items: center;
		justify-content: flex-start;
	}

	.hero-content {
		width: 100%;
		max-width: 640px;
		padding: 2rem 1.5rem 4rem;
		text-align: left;
	}

	/* Eyebrow */
	.hero-eyebrow {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		font-family: var(--font-body);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: none;
		color: rgba(255,255,255,0.75);
		text-shadow: 0 1px 6px rgba(0,0,0,0.4);
		margin: 0 0 1.5rem;
	}

	.hero-tagline {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: clamp(2rem, 7.5vw, 3.5rem);
		line-height: 1.15;
		color: rgba(255,255,255,0.92);
		text-shadow: 0 2px 12px rgba(0,0,0,0.35);
		margin: 0 0 1.25rem;
		text-wrap: balance;
	}

	/* Service info */
	.hero-service {
		display: flex;
		align-items: flex-start;
		justify-content: flex-start;
		gap: 0.5rem;
		font-size: 0.85rem;
		color: rgba(255,255,255,0.80);
		text-shadow: 0 1px 8px rgba(0,0,0,0.4);
		margin: 0 0 0.35rem;
	}
	.service-dot {
		display: inline-block;
		width: 7px; height: 7px;
		border-radius: 50%;
		background: var(--green);
		flex-shrink: 0;
		margin-top: calc(0.5lh - 3.5px);
	}
	.eyebrow-dot {
		display: inline-block;
		width: 7px; height: 7px;
		border-radius: 50%;
		background: var(--red);
		flex-shrink: 0;
		margin-top: calc(0.5lh - 3.5px);
	}
	.hero-service strong {
		color: rgba(255,255,255,0.95);
		font-weight: 600;
	}

	.hero-cta {
		display: flex;
		gap: 0.85rem;
		justify-content: flex-start;
		flex-wrap: wrap;
	}

	.btn {
		display: inline-block;
		padding: 0.8rem 1.8rem;
		border-radius: 999px;
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 0.92rem;
		letter-spacing: 0.2px;
		text-decoration: none;
		transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
	}
	.btn-primary { background: var(--green); color: var(--ink); }
	.btn-primary:hover { transform: translateY(-2px); background: #a3d63a; }
	.btn-ghost { color: #fff; border: 1.5px solid rgba(255,255,255,0.6); }
	.btn-ghost:hover { transform: translateY(-2px); border-color: #fff; background: rgba(255,255,255,0.08); }

	/* ══════════════════════════════
	   DESKTOP — left-aligned layout
	   ══════════════════════════════ */
	@media (min-width: 768px) {
		.hero-overlay {
			background:
				linear-gradient(to right,
					rgba(20,32,47,0.92) 0%,
					rgba(20,32,47,0.72) 50%,
					rgba(20,32,47,0.35) 78%,
					rgba(20,32,47,0.20) 100%
				);
		}

		.hero-section { justify-content: flex-start; }

		.hero-content {
			text-align: left;
			max-width: 54vw;
			padding: 3rem 4vw 3rem max(1.5rem, calc((100vw - var(--content-width)) / 2 + 1.5rem));
		}

		/* Eyebrow */
		.hero-eyebrow {
			display: flex;
			align-items: flex-start;
			gap: 0.5rem;
			font-family: var(--font-body);
			font-size: 0.78rem;
			font-weight: 700;
			letter-spacing: 0.06em;
			text-transform: none;
			color: rgba(255,255,255,0.85);
			text-shadow: 0 1px 6px rgba(0,0,0,0.4);
			margin: 0 0 1.25rem;
		}
		/* Fraunces display font, larger */
		.hero-tagline {
			font-size: clamp(3.5rem, 5vw, 5.5rem);
			font-weight: 400;
			line-height: 1.1;
			letter-spacing: -0.01em;
			margin: 0 0 1.25rem;
		}

		.hero-service {
			justify-content: flex-start;
			font-size: 0.9rem;
			margin: 0 0 0.4rem;
		}

		.hero-eyebrow {
			margin: 0 0 2rem;
		}

		.hero-cta { justify-content: flex-start; }
	}

	/* Narrow mobile */
	@media (max-width: 480px) {
		.hero-content { padding-bottom: 3rem; }
		.hero-cta { flex-direction: column; align-items: flex-start; }
		.btn { width: 100%; max-width: 260px; text-align: center; }
	}
</style>

<script>
	import gsap from 'gsap';

	// Split tagline into per-word spans for staggered entrance.
	// We do this in JS so the data-tina-field attribute on the <p> is untouched.
	const tagline = document.querySelector<HTMLElement>('#hero .hero-tagline');
	if (tagline) {
		const words = tagline.textContent?.trim().split(/\s+/) ?? [];
		tagline.innerHTML = words
			.map(w => `<span class="hw" style="display:inline-block">${w}</span>`)
			.join(' ');
	}

	const tl = gsap.timeline({ delay: 0.05 });

	// Background: ease down from a slight zoom as the page loads
	tl.from('#hero .hero-bg', {
		scale: 1.08,
		duration: 2.0,
		ease: 'power2.out',
	}, 0);

	// Tagline words: stagger up and fade in
	if (tagline) {
		tl.from('#hero .hw', {
			opacity: 0,
			y: 20,
			stagger: 0.08,
			duration: 0.65,
			ease: 'power3.out',
		}, 0.1);
	}

	// Remaining elements follow after the words settle
	tl.from('#hero .hero-service', { opacity: 0, y: 10, duration: 0.5, ease: 'power2.out' }, '-=0.35')
	  .from('#hero .hero-eyebrow', { opacity: 0, y: 10, duration: 0.5, ease: 'power2.out' }, '-=0.25')
	  .from('#hero .hero-cta',     { opacity: 0, y: 12, duration: 0.5, ease: 'power2.out' }, '-=0.2');
</script>
