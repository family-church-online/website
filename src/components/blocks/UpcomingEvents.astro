---
import { tinaField } from '@tinacms/astro/tina-field';
import Icon from '../Icon.astro';

interface EventFrontmatter {
	title?: string;
	date?: string;
	endDate?: string | null;
	location?: string | null;
	image?: string | null;
	description?: string | null;
}

interface Props {
	data: {
		heading?: string | null;
		count?: number | null;
		showViewAll?: boolean | null;
	};
}

const { data } = Astro.props;
const heading     = data.heading    ?? 'Upcoming Events';
const count       = data.count      ?? 3;
const showViewAll = data.showViewAll ?? true;

const eventModules = import.meta.glob<{ frontmatter: EventFrontmatter }>(
	'../../content/events/*.mdx',
	{ eager: true },
);

const TZ = 'Africa/Johannesburg';

const today = new Date().toISOString().split('T')[0];

const upcoming = Object.entries(eventModules)
	.map(([path, mod]) => ({
		slug: path.replace('../../content/events/', '').replace('.mdx', ''),
		...mod.frontmatter,
	}))
	.filter(e => (e.date ?? '') >= today)
	.sort((a, b) => (a.date ?? '').localeCompare(b.date ?? ''))
	.slice(0, count);

function locationLabel(raw: string | null | undefined): string | null {
	if (!raw) return null;
	try { JSON.parse(raw); return null; } catch { /* plain string */ }
	return raw;
}

function parsePoint(raw: string | null | undefined): { lat: number; lng: number } | null {
	if (!raw) return null;
	try {
		const geo = JSON.parse(raw);
		if (geo.type === 'Point' && Array.isArray(geo.coordinates) && geo.coordinates.length >= 2) {
			const [lng, lat] = geo.coordinates as [number, number];
			return { lat, lng };
		}
	} catch { /* not GeoJSON */ }
	return null;
}

function fmtTime(iso: string) {
	const t = new Date(iso).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: TZ });
	return t === '00:00' ? null : t;
}

function dateLabel(iso: string) {
	return new Date(iso).toLocaleDateString('en-GB', {
		weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: TZ,
	});
}

function calParts(iso: string) {
	return {
		day:   new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', timeZone: TZ }),
		month: new Date(iso).toLocaleDateString('en-GB', { month: 'short', timeZone: TZ }).toUpperCase(),
	};
}
---

{upcoming.length > 0 && (
	<section class="bg-[var(--background)] py-8">
		<div class="max-w-[var(--content-width)] mx-auto px-4 sm:px-6">
			<div class="flex items-end justify-between mb-8 gap-4">
				<h2
					data-tina-field={tinaField(data, 'heading')}
					class="font-display text-2xl font-semibold text-[var(--ink)] dark:text-white uppercase tracking-wide"
				>{heading}</h2>
				{showViewAll && (
					<a
						href="/events"
						class="shrink-0 text-sm font-medium text-[var(--navy)] dark:text-white/70 hover:text-[var(--green)] dark:hover:text-[var(--green)] transition-colors"
					>All events →</a>
				)}
			</div>

			<ul class="space-y-4">
				{upcoming.map((event, i) => {
					const dateStr    = event.date ? dateLabel(event.date) : null;
					const timeStr    = event.date ? fmtTime(event.date) : null;
					const endTimeStr = event.endDate ? fmtTime(event.endDate) : null;
					const coords  = parsePoint(event.location);
					const locText = locationLabel(event.location);
					return (
						<li class="reveal" data-reveal-delay={String(i * 0.07)}>
							<a
								href={`/events/${event.slug}`}
								class="group flex flex-col sm:flex-row bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 overflow-hidden hover:shadow-md transition-shadow"
							>
								<div class="flex items-start gap-4 px-6 py-5 flex-1 min-w-0">
									{event.date && (() => { const p = calParts(event.date!); return (
										<div class="shrink-0 w-14 rounded-xl overflow-hidden ring-1 ring-[var(--red)]/20 dark:ring-white/12 text-center">
											<div class="bg-[var(--red)] py-1">
												<span class="text-white text-[10px] font-bold uppercase tracking-widest">{p.month}</span>
											</div>
											<div class="bg-white dark:bg-[var(--card)] py-2">
												<span class="text-[var(--navy)] dark:text-white text-2xl font-bold leading-none">{p.day}</span>
											</div>
										</div>
									); })()}
									<div class="flex flex-col gap-1.5 flex-1 min-w-0">
										<div class="flex items-start gap-3">
											<h3 class="flex-1 min-w-0 text-lg font-semibold text-[var(--navy)] dark:text-white group-hover:text-[var(--green)] transition-colors leading-snug">
												{event.title}
											</h3>
											<Icon name="caret-right" class="shrink-0 w-5 h-5 mt-0.5 text-[var(--navy)]/25 dark:text-white/25 group-hover:text-[var(--green)] transition-colors" />
										</div>

										{dateStr && (
											<p class="text-sm font-semibold text-[var(--navy)] dark:text-white/80">
												{dateStr}
											</p>
										)}

										{timeStr && (
											<p class="flex items-center gap-1.5 text-sm text-[var(--ink)]/60 dark:text-white/50">
												<Icon name="clock" class="w-3.5 h-3.5 shrink-0" />
												{timeStr}{endTimeStr ? ` – ${endTimeStr}` : ''}
											</p>
										)}

										{locText && (
											<p class="flex items-center gap-1.5 text-sm text-[var(--ink)]/55 dark:text-white/45">
												<Icon name="map-pin" class="w-3.5 h-3.5 shrink-0" />
												{locText}
											</p>
										)}

										{event.description && (
											<p class="text-sm text-[var(--ink)]/65 dark:text-white/55 leading-relaxed">
												{event.description}
											</p>
										)}
									</div>
								</div>
							</a>
						</li>
					);
				})}
			</ul>
		</div>
	</section>
)}
