---
import { tinaField } from '@tinacms/astro/tina-field';
import Icon from '../Icon.astro';

interface EventFrontmatter {
	title?: string;
	date?: string;
	endDate?: string | null;
	location?: string | null;
	image?: string | null;
	description?: string | null;
	images?: Array<{ image?: string; description?: string }>;
}

interface Props {
	data: {
		heading?: string | null;
		count?: number | null;
		showViewAll?: boolean | null;
	};
}

const { data } = Astro.props;
const count       = data.count      ?? 3;
const showViewAll = data.showViewAll ?? true;

const eventModules = import.meta.glob<{ frontmatter: EventFrontmatter }>(
	'../../content/events/*.mdx',
	{ eager: true },
);

const TZ = 'Africa/Johannesburg';

const today = new Date().toISOString().split('T')[0];

const allEvents = Object.entries(eventModules).map(([path, mod]) => ({
	slug: path.replace('../../content/events/', '').replace('.mdx', ''),
	...mod.frontmatter,
}));

const upcoming = allEvents
	.filter(e => (e.date ?? '') >= today)
	.sort((a, b) => (a.date ?? '').localeCompare(b.date ?? ''))
	.slice(0, count);

interface PastImage {
	src: string;
	description: string;
	eventTitle: string;
	eventDateLabel: string;
	eventSlug: string;
}

const pastImages: PastImage[] = allEvents
	.filter(e => (e.date ?? '') < today && (e.images ?? []).some(i => i?.image))
	.sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''))
	.slice(0, count)
	.flatMap(e =>
		(e.images ?? [])
			.filter(i => i?.image)
			.map(i => ({
				src: i.image!,
				description: i.description ?? '',
				eventTitle: e.title ?? 'Event',
				eventDateLabel: new Date(e.date!).toLocaleDateString('en-GB', {
					day: 'numeric', month: 'short', year: 'numeric', timeZone: TZ,
				}),
				eventSlug: e.slug,
			}))
	);

function locationLabel(raw: string | null | undefined): string | null {
	if (!raw) return null;
	try { JSON.parse(raw); return null; } catch { /* plain string */ }
	return raw;
}

function parsePoint(raw: string | null | undefined): { lat: number; lng: number } | null {
	if (!raw) return null;
	try {
		const geo = JSON.parse(raw);
		if (geo.type === 'Point' && Array.isArray(geo.coordinates) && geo.coordinates.length >= 2) {
			const [lng, lat] = geo.coordinates as [number, number];
			return { lat, lng };
		}
	} catch { /* not GeoJSON */ }
	return null;
}

function fmtTime(iso: string) {
	const t = new Date(iso).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: TZ });
	return t === '00:00' ? null : t;
}

function dateLabel(iso: string) {
	return new Date(iso).toLocaleDateString('en-GB', {
		weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: TZ,
	});
}

function calParts(iso: string) {
	return {
		day:   new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', timeZone: TZ }),
		month: new Date(iso).toLocaleDateString('en-GB', { month: 'short', timeZone: TZ }).toUpperCase(),
	};
}
---

{(upcoming.length > 0 || pastImages.length > 0) && (
	<section class="bg-[var(--background)] py-6" data-event-section>
		<div class="max-w-[var(--content-width)] mx-auto px-4 sm:px-6">

			{/* ── SECTION HEADER ──────────────────────────────────────────── */}
			{(data.heading || showViewAll) && (
				<div class="text-center mb-8">
					{data.heading && (
						<h2
							data-tina-field={tinaField(data, 'heading')}
							class="font-display text-4xl font-semibold text-[var(--ink)] dark:text-white tracking-tight mb-3"
						>{data.heading}</h2>
					)}
					{showViewAll && (
						<a
							href="/events"
							class="text-sm font-medium text-[var(--navy)] dark:text-white/70 hover:text-[var(--green)] dark:hover:text-[var(--green)] transition-colors"
						>All events →</a>
					)}
				</div>
			)}

			{/* ── UPCOMING LIST ────────────────────────────────────────────── */}
			{upcoming.length > 0 && (
				<ul class="space-y-4">
					{upcoming.map((event, i) => {
						const dateStr    = event.date ? dateLabel(event.date) : null;
						const timeStr    = event.date ? fmtTime(event.date) : null;
						const endTimeStr = event.endDate ? fmtTime(event.endDate) : null;
						const coords  = parsePoint(event.location);
						const locText = locationLabel(event.location);
						return (
							<li class="reveal" data-reveal-delay={String(i * 0.07)}>
								<a
									href={`/events/${event.slug}`}
									class="group flex flex-col sm:flex-row bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 overflow-hidden hover:shadow-md transition-shadow"
								>
									<div class="flex items-start gap-4 px-6 py-5 flex-1 min-w-0">
										{event.date && (() => { const p = calParts(event.date!); return (
											<div class="shrink-0 w-14 rounded-xl overflow-hidden ring-1 ring-[var(--red)]/20 dark:ring-white/12 text-center">
												<div class="bg-[var(--red)] py-1">
													<span class="text-white text-[10px] font-bold uppercase tracking-widest">{p.month}</span>
												</div>
												<div class="bg-white dark:bg-[var(--card)] py-2">
													<span class="text-[var(--navy)] dark:text-white text-2xl font-bold leading-none">{p.day}</span>
												</div>
											</div>
										); })()}
										<div class="flex flex-col gap-1.5 flex-1 min-w-0">
											<div class="flex items-start gap-3">
												<h3 class="flex-1 min-w-0 text-lg font-semibold text-[var(--navy)] dark:text-white group-hover:text-[var(--green)] transition-colors leading-snug">
													{event.title}
												</h3>
												<Icon name="caret-right" class="shrink-0 w-5 h-5 mt-0.5 text-[var(--navy)]/25 dark:text-white/25 group-hover:text-[var(--green)] transition-colors" />
											</div>

											{dateStr && (
												<p class="text-sm font-semibold text-[var(--navy)] dark:text-white/80">
													{dateStr}
												</p>
											)}

											{timeStr && (
												<p class="flex items-center gap-1.5 text-sm text-[var(--ink)]/60 dark:text-white/50">
													<Icon name="clock" class="w-3.5 h-3.5 shrink-0" />
													{timeStr}{endTimeStr ? ` – ${endTimeStr}` : ''}
												</p>
											)}

											{locText && (
												<p class="flex items-center gap-1.5 text-sm text-[var(--ink)]/55 dark:text-white/45">
													<Icon name="map-pin" class="w-3.5 h-3.5 shrink-0" />
													{locText}
												</p>
											)}

											{event.description && (
												<p class="text-sm text-[var(--ink)]/65 dark:text-white/55 leading-relaxed">
													{event.description}
												</p>
											)}
										</div>
									</div>
								</a>
							</li>
						);
					})}
				</ul>
			)}

			{/* ── PAST EVENT PHOTO GALLERY ─────────────────────────────────── */}
			{pastImages.length > 0 && (
				<div class={upcoming.length > 0 ? 'mt-10' : ''}>
					<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
						{pastImages.map((img, i) => (
							<button
								data-lb-open
								data-lb-src={img.src}
								data-lb-title={img.eventTitle}
								data-lb-date={img.eventDateLabel}
								class="reveal group text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--green)] rounded-xl"
								data-reveal-delay={String(i * 0.05)}
							>
								<div class="aspect-square overflow-hidden rounded-xl bg-[var(--navy)]/5 dark:bg-white/5">
									<img
										src={img.src}
										alt={img.description || img.eventTitle}
										class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
										loading="lazy"
									/>
								</div>
								<p class="mt-3 text-xs text-[var(--ink)]/50 dark:text-white/40 text-center">{img.eventDateLabel}</p>
								<p class="mt-0.5 text-sm font-semibold text-[var(--navy)] dark:text-white leading-snug line-clamp-1 group-hover:text-[var(--green)] transition-colors text-center">
									{img.eventTitle}
								</p>
							</button>
						))}
					</div>
				</div>
			)}

		</div>

		{/* ── LIGHTBOX ─────────────────────────────────────────────────────── */}
		{pastImages.length > 0 && (
			<div
				data-event-lightbox
				class="fixed inset-0 z-50 flex items-center justify-center p-4"
				style="display:none"
			>
				<div data-lb-backdrop class="absolute inset-0 bg-black/85 cursor-pointer" />
				<div data-lb-content class="relative z-10 flex flex-col items-center w-full max-w-3xl">
					<button
						data-lb-close
						aria-label="Close"
						class="absolute -top-10 right-0 text-white/70 hover:text-white transition-colors p-1"
					>
						<svg viewBox="0 0 256 256" class="w-6 h-6 fill-current" aria-hidden="true">
							<path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"/>
						</svg>
					</button>
					<img
						data-lb-img
						src=""
						alt=""
						class="max-h-[75vh] max-w-full object-contain rounded-xl shadow-2xl"
					/>
					<div class="mt-3 text-center">
						<p data-lb-title class="text-white font-semibold text-lg leading-snug"></p>
						<p data-lb-date class="text-white/55 text-sm mt-0.5"></p>
					</div>
				</div>
			</div>
		)}
	</section>
)}

<script>
	import { gsap } from 'gsap';

	function initEventGallery() {
		const section  = document.querySelector<HTMLElement>('[data-event-section]');
		const lightbox = document.querySelector<HTMLElement>('[data-event-lightbox]');
		if (!section || !lightbox) return;

		const lbImg     = lightbox.querySelector<HTMLImageElement>('[data-lb-img]')!;
		const lbContent = lightbox.querySelector<HTMLElement>('[data-lb-content]')!;
		const lbTitle   = lightbox.querySelector<HTMLElement>('[data-lb-title]')!;
		const lbDate    = lightbox.querySelector<HTMLElement>('[data-lb-date]')!;

		let isOpen = false;

		function open(src: string, title: string, date: string) {
			lbImg.src       = src;
			lbImg.alt       = title;
			lbTitle.textContent = title;
			lbDate.textContent  = date;
			isOpen = true;
			document.body.style.overflow = 'hidden';
			gsap.set(lightbox, { display: 'flex' });
			gsap.fromTo(lightbox, { opacity: 0 }, { opacity: 1, duration: 0.22, ease: 'power2.out' });
			gsap.fromTo(lbContent, { scale: 0.88, y: 10 }, { scale: 1, y: 0, duration: 0.28, ease: 'back.out(1.4)' });
		}

		function close() {
			if (!isOpen) return;
			isOpen = false;
			gsap.to(lightbox, {
				opacity: 0, duration: 0.18, ease: 'power2.in',
				onComplete: () => {
					gsap.set(lightbox, { display: 'none' });
					lbImg.src = '';
					document.body.style.overflow = '';
				},
			});
		}

		for (const btn of section.querySelectorAll<HTMLButtonElement>('[data-lb-open]')) {
			btn.addEventListener('click', () => {
				open(btn.dataset.lbSrc!, btn.dataset.lbTitle!, btn.dataset.lbDate!);
			});
		}

		lightbox.querySelector('[data-lb-close]')?.addEventListener('click', close);
		lightbox.querySelector('[data-lb-backdrop]')?.addEventListener('click', close);

		document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
	}

	document.addEventListener('astro:page-load', initEventGallery);
</script>
