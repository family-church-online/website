---
import { tinaField } from '@tinacms/astro/tina-field';
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import Section from '../ui/Section.astro';

interface Member {
	photo?: string | null;
	name?: string | null;
	role?: string | null;
	bio?: string | null;
}

interface Props {
	data: {
		title?: string | null;
		// eslint-disable-next-line @typescript-eslint/no-explicit-any
		body?: any;
		members?: (Member | null)[] | null;
	};
}

const { data } = Astro.props;
const members = (data.members ?? []).filter(m => m !== null);
---
<Section id="our-people">
	<div class="mx-auto max-w-[var(--content-width)]">

		{(data.title || data.body) && (
			<div class="mb-10">
				{data.title && (
					<h2 data-tina-field={tinaField(data, 'title')}
						class="font-display text-balance text-center text-4xl font-semibold lg:text-5xl mb-4">
						{data.title}
					</h2>
				)}
				{data.body && (
					<div data-tina-field={tinaField(data, 'body')}
						class="prose prose-lg mt-6 max-w-none text-[var(--ink)]/70 dark:text-white/60">
						<TinaMarkdown content={data.body} />
					</div>
				)}
			</div>
		)}

		{members.length === 1 && (() => {
			const member = members[0];
			return (
				<div data-tina-field={tinaField(data, 'members')}>
					<div data-tina-field={tinaField(member)} class="flex flex-col overflow-hidden rounded-xl bg-white dark:bg-[var(--card)] shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8">
						{member.photo && (
							<div data-tina-field={tinaField(member, 'photo')} class="aspect-[16/9] overflow-hidden">
								<img src={member.photo} alt={member.name ?? ''} class="w-full h-full object-cover" />
							</div>
						)}
						{(member.name || member.role || member.bio) && (
							<div class="flex flex-col gap-1 p-6 text-center">
								{member.name && (
									<h3 data-tina-field={tinaField(member, 'name')} class="text-lg font-semibold text-[var(--navy)] dark:text-white">{member.name}</h3>
								)}
								{member.role && (
									<p data-tina-field={tinaField(member, 'role')} class="text-sm font-medium text-[var(--olive)]">{member.role}</p>
								)}
								{member.bio && (
									<p data-tina-field={tinaField(member, 'bio')} class="mt-2 text-sm leading-relaxed text-[var(--ink)]/70 dark:text-white/65">{member.bio}</p>
								)}
							</div>
						)}
					</div>
				</div>
			);
		})()}

		{members.length > 1 && (
			<ul data-tina-field={tinaField(data, 'members')}
				class="grid gap-6"
				style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr))">
				{members.map((member) => (
					<li data-tina-field={tinaField(member)}
						class="flex flex-col overflow-hidden rounded-xl bg-white dark:bg-[var(--card)] shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8">
						{member.photo && (
							<div data-tina-field={tinaField(member, 'photo')} class="aspect-[4/3] overflow-hidden">
								<img src={member.photo} alt={member.name ?? ''} class="w-full h-full object-cover" />
							</div>
						)}
						<div class="flex flex-col gap-1 p-5">
							{member.name && (
								<h3 data-tina-field={tinaField(member, 'name')} class="text-lg font-semibold text-[var(--navy)] dark:text-white">{member.name}</h3>
							)}
							{member.role && (
								<p data-tina-field={tinaField(member, 'role')} class="text-sm font-medium text-[var(--olive)]">{member.role}</p>
							)}
							{member.bio && (
								<p data-tina-field={tinaField(member, 'bio')} class="mt-2 text-sm leading-relaxed text-[var(--ink)]/70 dark:text-white/65">{member.bio}</p>
							)}
						</div>
					</li>
				))}
			</ul>
		)}

	</div>
</Section>
