---
import { tinaField } from '@tinacms/astro/tina-field';
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import Section from '../ui/Section.astro';

interface Member {
	photo?: string | null;
	name?: string | null;
	role?: string | null;
	bio?: string | null;
}

interface Props {
	data: {
		title?: string | null;
		// eslint-disable-next-line @typescript-eslint/no-explicit-any
		body?: any;
		members?: (Member | null)[] | null;
	};
}

const { data } = Astro.props;
const members = (data.members ?? []).filter((m): m is Member => m !== null);
const uid = `team-${Math.random().toString(36).slice(2, 8)}`;
const multi = members.length > 1;
---

<Section id="our-people">
	<div class="mx-auto max-w-[var(--content-width)]">

		{(data.title || data.body) && (
			<div class="mb-10">
				{data.title && (
					<h2 data-tina-field={tinaField(data, 'title')}
						class="font-display text-balance text-center text-4xl font-semibold lg:text-5xl mb-4">
						{data.title}
					</h2>
				)}
				{data.body && (
					<div data-tina-field={tinaField(data, 'body')}
						class="prose prose-lg mt-6 max-w-none text-[var(--ink)]/70 dark:text-white/60">
						<TinaMarkdown content={data.body} />
					</div>
				)}
			</div>
		)}

		{members.length > 0 && (
			<div class="relative" data-tina-field={tinaField(data, 'members')}>

				{/* Track */}
				<div
					id={uid}
					class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth rounded-xl [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
				>
					{members.map((member) => (
						<div class="flex-none w-full snap-start" data-tina-field={tinaField(member)}>
							<div class="overflow-hidden rounded-xl bg-white dark:bg-[var(--card)] shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8">
								{member.photo && (
									<div data-tina-field={tinaField(member, 'photo')} class="aspect-[16/9] overflow-hidden">
										<img src={member.photo} alt={member.name ?? ''} class="w-full h-full object-cover" />
									</div>
								)}
								{(member.name || member.role || member.bio) && (
									<div class="px-6 py-5 text-center">
										{member.name && (
											<h3 data-tina-field={tinaField(member, 'name')}
												class="text-lg font-semibold text-[var(--navy)] dark:text-white">{member.name}</h3>
										)}
										{member.role && (
											<p data-tina-field={tinaField(member, 'role')}
												class="text-sm font-medium text-[var(--olive)] mt-0.5">{member.role}</p>
										)}
										{member.bio && (
											<p data-tina-field={tinaField(member, 'bio')}
												class="mt-3 text-sm leading-relaxed text-[var(--ink)]/70 dark:text-white/65">{member.bio}</p>
										)}
									</div>
								)}
							</div>
						</div>
					))}
				</div>

				{/* Prev / Next */}
				{multi && (
					<>
						<button
							id={`${uid}-prev`}
							aria-label="Previous"
							class="absolute left-3 top-[calc(50%-2.5rem)] -translate-y-1/2 z-10 flex h-9 w-9 items-center justify-center rounded-full bg-white/90 dark:bg-[var(--card)]/90 shadow ring-1 ring-[var(--navy)]/10 dark:ring-white/10 hover:bg-white dark:hover:bg-[var(--card)] transition-colors"
						>
							<svg viewBox="0 0 256 256" class="w-4 h-4 fill-current text-[var(--navy)] dark:text-white" aria-hidden="true">
								<path d="M165.66 202.34a8 8 0 0 1-11.32 11.32l-80-80a8 8 0 0 1 0-11.32l80-80a8 8 0 0 1 11.32 11.32L91.31 128Z"/>
							</svg>
						</button>
						<button
							id={`${uid}-next`}
							aria-label="Next"
							class="absolute right-3 top-[calc(50%-2.5rem)] -translate-y-1/2 z-10 flex h-9 w-9 items-center justify-center rounded-full bg-white/90 dark:bg-[var(--card)]/90 shadow ring-1 ring-[var(--navy)]/10 dark:ring-white/10 hover:bg-white dark:hover:bg-[var(--card)] transition-colors"
						>
							<svg viewBox="0 0 256 256" class="w-4 h-4 fill-current text-[var(--navy)] dark:text-white" aria-hidden="true">
								<path d="M181.66 133.66l-80 80a8 8 0 0 1-11.32-11.32L164.69 128 90.34 53.66a8 8 0 0 1 11.32-11.32l80 80a8 8 0 0 1 0 11.32Z"/>
							</svg>
						</button>
					</>
				)}

				{/* Dots */}
				{multi && (
					<div id={`${uid}-dots`} class="flex justify-center gap-2 mt-4">
						{members.map((_, i) => (
							<button
								data-index={i}
								aria-label={`Slide ${i + 1}`}
								class={`w-2 h-2 rounded-full transition-colors ${i === 0 ? 'bg-[var(--navy)] dark:bg-white' : 'bg-[var(--navy)]/20 dark:bg-white/20'}`}
							/>
						))}
					</div>
				)}

			</div>
		)}

	</div>
</Section>

{multi && (
	<script define:vars={{ uid }}>
		const track = document.getElementById(uid);
		const dots  = Array.from(document.querySelectorAll(`#${uid}-dots [data-index]`));
		const total = track.children.length;
		let current = 0;

		function goTo(i) {
			current = (i + total) % total;
			track.scrollTo({ left: current * track.clientWidth, behavior: 'smooth' });
			dots.forEach((d, j) => {
				d.classList.toggle('bg-[var(--navy)]', j === current);
				d.classList.toggle('dark:bg-white', j === current);
				d.classList.toggle('bg-[var(--navy)]/20', j !== current);
				d.classList.toggle('dark:bg-white/20', j !== current);
			});
		}

		document.getElementById(`${uid}-prev`).addEventListener('click', () => goTo(current - 1));
		document.getElementById(`${uid}-next`).addEventListener('click', () => goTo(current + 1));
		dots.forEach((d) => d.addEventListener('click', () => goTo(Number(d.dataset.index))));

		let scrollTimer;
		track.addEventListener('scroll', () => {
			clearTimeout(scrollTimer);
			scrollTimer = setTimeout(() => {
				const i = Math.round(track.scrollLeft / track.clientWidth);
				if (i !== current) goTo(i);
			}, 100);
		});
	</script>
)}
