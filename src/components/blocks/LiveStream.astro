---
import { tinaField } from '@tinacms/astro/tina-field';
import Icon from '../Icon.astro';

interface Props {
	data: {
		heading?: string | null;
		subheading?: string | null;
		streamUrl?: string | null;
		description?: string | null;
		reportDescription?: string | null;
	};
}

const { data } = Astro.props;

const REPORT_BUTTONS: { label: string; icon: Parameters<typeof Icon>[0]['name'] }[] = [
	{ label: 'No Sound',       icon: 'speaker-x'    },
	{ label: 'Low Volume',     icon: 'speaker-low'  },
	{ label: 'Sound Quality',  icon: 'speaker-high' },
	{ label: 'No Picture',     icon: 'video-slash'  },
	{ label: 'Picture Quality',icon: 'monitor'      },
];
---

{data.streamUrl && (
	<div id="audio" class="max-w-[var(--content-width)] mx-auto px-4 sm:px-6">

		{(data.heading || data.subheading) && (
			<div class="pt-10 pb-8 text-center reveal">
				{data.heading && (
					<>
						<p class="text-xs font-semibold uppercase tracking-widest text-[var(--olive)] mb-3">Family Church</p>
						<h1
							data-tina-field={tinaField(data, 'heading')}
							class="text-4xl font-semibold lg:text-5xl text-balance mb-4"
						>{data.heading}</h1>
					</>
				)}
				{data.subheading && (
					<p
						data-tina-field={tinaField(data, 'subheading')}
						class="text-lg text-muted-foreground max-w-xl mx-auto leading-relaxed"
					>{data.subheading}</p>
				)}
			</div>
		)}

		<div class="py-6 reveal" data-reveal-delay="0.05">
			<div class="bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 overflow-hidden">

				<div class="px-6 pt-6 pb-5">
					<audio
						controls
						preload="none"
						class="w-full"
						style="color-scheme: light dark;"
						data-tina-field={tinaField(data, 'streamUrl')}
					>
						<source src={data.streamUrl} />
						<p class="text-sm text-[var(--ink)] dark:text-white">
							Your browser doesn't support audio.
							<a href={data.streamUrl} class="text-[var(--green)] underline">Open stream</a>.
						</p>
					</audio>
				</div>

				<div class="info-card px-6 py-3 flex items-center gap-2 text-sm text-[var(--ink)]/80 dark:text-white/75">
					<span id="stream-dot" class="shrink-0 w-2 h-2 rounded-full bg-[var(--ink)]/20 dark:bg-white/20"></span>
					<span id="stream-label">Checking stream…</span>
				</div>

				{data.description && (
					<div class="px-6 py-4">
						<p
							data-tina-field={tinaField(data, 'description')}
							class="text-sm text-[var(--ink)]/70 dark:text-white/65 leading-relaxed"
						>{data.description}</p>
					</div>
				)}

			</div>
		</div>

		{/* Report a Problem — only visible while stream is live */}
		<div id="report-widget" class="hidden py-4 reveal" data-reveal-delay="0.1">
			<div class="bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 px-6 py-5">
				<p class="text-sm font-semibold text-[var(--ink)] dark:text-white mb-0.5">Report a Problem</p>
				<p class="text-sm text-[var(--ink)]/55 dark:text-white/45 mb-4">{data.reportDescription ?? "Let us know if you're experiencing technical issues. Clicking on the icons below will report it live to our technicians."}</p>
				<div id="report-buttons" class="flex justify-around items-start gap-1">
					{REPORT_BUTTONS.map(({ label, icon }) => (
						<button
							type="button"
							data-report={label}
							class="report-btn flex flex-col items-center gap-1.5 flex-1 py-1 rounded-xl text-[var(--ink)]/55 dark:text-white/45 hover:text-[var(--red)] dark:hover:text-[var(--red)] transition-colors"
						>
							<Icon name={icon} class="w-7 h-7 shrink-0" />
							<span class="text-[10px] font-semibold leading-tight text-center">{label}</span>
						</button>
					))}
				</div>
				<p id="report-thanks" class="hidden text-sm text-[var(--green)] font-semibold">
					Thank you — our technicians will investigate immediately.
				</p>
			</div>
		</div>

	</div>
)}

<style>
.info-card {
	background-color: #e6ecf4;
}
:global(.dark) .info-card {
	background-color: rgba(39, 63, 97, 0.45);
}
</style>

<script>
async function checkStream() {
	const dot    = document.getElementById('stream-dot');
	const label  = document.getElementById('stream-label');
	const widget = document.getElementById('report-widget');
	if (!dot || !label) return;

	try {
		const res  = await fetch('/api/stream-status');
		const data = await res.json() as { live: boolean };

		dot.classList.toggle('bg-[var(--red)]',    data.live);
		dot.classList.toggle('animate-pulse',       data.live);
		dot.classList.toggle('bg-[var(--ink)]/20', !data.live);
		dot.classList.toggle('dark:bg-white/20',   !data.live);
		label.textContent = data.live ? 'Live Audio Broadcast — on air now' : 'Live Audio Broadcast — off air';

		if (widget) {
			widget.classList.toggle('hidden', !data.live);
			// Reset if stream went off then back on
			if (data.live) resetReportWidget();
		}
	} catch {
		label.textContent = 'Live Audio Broadcast';
	}
}

function resetReportWidget() {
	const buttons = document.getElementById('report-buttons');
	const thanks  = document.getElementById('report-thanks');
	if (buttons && thanks && thanks.classList.contains('hidden') === false) {
		// Only reset if already dismissed — allow re-reporting next service
		buttons.classList.remove('hidden');
		thanks.classList.add('hidden');
	}
}

function initReportButtons() {
	document.querySelectorAll<HTMLButtonElement>('.report-btn').forEach(btn => {
		btn.addEventListener('click', async () => {
			const label   = btn.dataset.report;
			const buttons = document.getElementById('report-buttons');
			const thanks  = document.getElementById('report-thanks');
			if (!label || !buttons || !thanks) return;

			buttons.classList.add('hidden');
			thanks.classList.remove('hidden');

			fetch('/api/stream-report', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ button: label }),
			}).catch(() => {/* fire-and-forget */});
		});
	});
}

function init() {
	checkStream();
	initReportButtons();
	setInterval(checkStream, 60_000);
}

document.addEventListener('astro:page-load', init);
document.addEventListener('DOMContentLoaded', init);
</script>
