---
import { tinaField } from '@tinacms/astro/tina-field';
import Icon from '../Icon.astro';

interface Props {
	data: {
		heading?: string | null;
		subheading?: string | null;
		streamUrl?: string | null;
		description?: string | null;
		reportDescription?: string | null;
		vimeoEventId?: string | null;
	};
}

const { data } = Astro.props;

const REPORT_BUTTONS: { label: string; icon: Parameters<typeof Icon>[0]['name'] }[] = [
	{ label: 'No Sound',       icon: 'speaker-x'    },
	{ label: 'Low Volume',     icon: 'speaker-low'  },
	{ label: 'Sound Quality',  icon: 'speaker-high' },
	{ label: 'No Picture',     icon: 'video-slash'  },
	{ label: 'Picture Quality',icon: 'monitor'      },
];

interface NotesFrontmatter { title?: string; date?: string; speaker?: string; series?: string; scripture?: string; image?: string; }
const notesMods = import.meta.glob<{ frontmatter: NotesFrontmatter }>(
	'../../content/sermon-notes/current.mdx',
	{ eager: true }
);
const notesFm = Object.values(notesMods)[0]?.frontmatter ?? {};

const nowSA = new Date(new Date().toLocaleString('en-US', { timeZone: 'Africa/Johannesburg' }));
const isSunday = nowSA.getDay() === 0;
const todayStr = `${nowSA.getFullYear()}-${String(nowSA.getMonth() + 1).padStart(2, '0')}-${String(nowSA.getDate()).padStart(2, '0')}`;
const showNotesCard = !!notesFm.title && (import.meta.env.DEV || (isSunday && notesFm.date === todayStr));
---

{data.streamUrl && (
	<div id="audio" class="max-w-[var(--content-width)] mx-auto px-6">

		{(data.heading || data.subheading) && (
			<div class="pt-10 pb-8 text-center reveal">
				{data.heading && (
					<>
						<p class="text-xs font-semibold uppercase tracking-widest text-[var(--olive)] mb-3">Family Church</p>
						<h1
							data-tina-field={tinaField(data, 'heading')}
							class="text-4xl font-semibold lg:text-5xl text-balance mb-4"
						>{data.heading}</h1>
					</>
				)}
				{data.subheading && (
					<p
						data-tina-field={tinaField(data, 'subheading')}
						class="text-lg text-muted-foreground max-w-xl mx-auto leading-relaxed"
					>{data.subheading}</p>
				)}
			</div>
		)}

		<div class="py-6 reveal" data-reveal-delay="0.05" data-vimeo-event-id={data.vimeoEventId ?? ''}>
			<div class="bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 overflow-hidden">

				<div class="px-6 pt-6 pb-5">
					<audio
						controls
						preload="none"
						class="w-full"
						style="color-scheme: light dark;"
						data-tina-field={tinaField(data, 'streamUrl')}
					>
						<source src={data.streamUrl} />
						<p class="text-sm text-[var(--ink)] dark:text-white">
							Your browser doesn't support audio.
							<a href={data.streamUrl} class="text-[var(--green)] underline">Open stream</a>.
						</p>
					</audio>
				</div>

				<div class="info-card px-6 py-3 flex items-center gap-2 text-sm text-[var(--ink)]/80 dark:text-white/75">
					<span id="stream-dot" class="shrink-0 w-2 h-2 rounded-full bg-[var(--ink)]/20 dark:bg-white/20"></span>
					<span id="stream-label">Checking stream…</span>
				</div>

				{data.description && (
					<div class="px-6 py-4">
						<p
							data-tina-field={tinaField(data, 'description')}
							class="text-sm text-center sm:text-left text-[var(--ink)]/70 dark:text-white/65 leading-relaxed"
						>{data.description}</p>
					</div>
				)}

			</div>
		</div>

		{/* Sunday Sermon Notes card — baked at build time */}
		{showNotesCard && (
			<div class="py-4 reveal" data-reveal-delay="0.1">
				<div class="bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 overflow-hidden">
					<div class="px-6 pt-5 pb-4 flex items-start gap-4">
						{notesFm.image && (
							<div class="w-16 h-16 rounded-xl overflow-hidden shrink-0">
								<img src={notesFm.image} alt={notesFm.title ?? ''} class="w-full h-full object-cover scale-[1.35]" />
							</div>
						)}
						<div class="flex-1 min-w-0">
							{notesFm.series && (
								<p class="text-[10px] font-bold uppercase tracking-widest text-[var(--olive)] mb-1">{notesFm.series}</p>
							)}
							<p class="font-semibold text-[var(--navy)] dark:text-white leading-snug">{notesFm.title ?? 'Sermon Notes'}{notesFm.scripture ? `: ${notesFm.scripture}` : ''}</p>
							{notesFm.speaker && (
								<p class="text-sm text-[var(--ink)]/55 dark:text-white/45 mt-0.5">{notesFm.speaker}</p>
							)}
						</div>
					</div>
					<div class="px-6 pb-5">
						<button id="notes-card-btn" class="w-full flex items-center justify-center gap-2 bg-[var(--navy)] hover:bg-[var(--green)] text-white font-semibold text-sm py-3 rounded-xl transition-colors">
							<Icon name="note" class="w-4 h-4 shrink-0" />
							Open Sermon Notes
						</button>
					</div>
				</div>
			</div>
		)}

		{/* Report a Problem — only visible while stream is live */}
		<div id="report-widget" class="hidden py-4 reveal" data-reveal-delay="0.15">
			<div class="bg-white dark:bg-[var(--card)] rounded-2xl shadow-sm ring-1 ring-[var(--navy)]/8 dark:ring-white/8 px-6 py-5">
				<p class="text-sm font-semibold text-center sm:text-left text-[var(--ink)] dark:text-white mb-0.5">Report a Problem</p>
				<p class="text-sm text-center sm:text-left text-[var(--ink)]/55 dark:text-white/45 mb-4">{data.reportDescription ?? "Let us know if you're experiencing technical issues. Clicking on the relevant icon below will alert our technicians immediately."}</p>
				<div id="report-buttons" class="flex justify-around items-start gap-1">
					{REPORT_BUTTONS.map(({ label, icon }) => (
						<button
							type="button"
							data-report={label}
							class="report-btn flex flex-col items-center gap-1.5 flex-1 py-1 rounded-xl text-[var(--ink)]/55 dark:text-white/45 hover:text-[var(--red)] dark:hover:text-[var(--red)] transition-colors"
						>
							<Icon name={icon} class="w-7 h-7 shrink-0" />
							<span class="text-[10px] font-semibold leading-tight text-center">{label}</span>
						</button>
					))}
				</div>
				<p id="report-thanks" class="hidden text-sm text-[var(--green)] font-semibold">
					Thank you — our technicians will investigate immediately.
				</p>
			</div>
		</div>

	{/* Sermon Notes drawer — fixed+overflow-hidden wrapper clips the off-screen drawer so it
	    doesn't create horizontal overflow on mobile (translate-x-full on fixed bypasses overflow-x:hidden) */}
	<div class="fixed inset-0 z-50 pointer-events-none overflow-hidden">
	<div id="notes-overlay" class="hidden absolute inset-0 bg-black/50 cursor-pointer pointer-events-auto"></div>
	<div id="notes-drawer" class="absolute inset-y-0 right-0 w-full sm:w-[520px] bg-white dark:bg-[var(--card)] shadow-2xl flex flex-col translate-x-full transition-transform duration-300 pointer-events-auto">
		<div class="flex items-center justify-between px-5 py-4 border-b border-[var(--navy)]/10 dark:border-white/10 shrink-0">
			<span class="font-semibold text-sm text-[var(--navy)] dark:text-white">Sermon Notes</span>
			<button id="notes-close" class="text-[var(--ink)]/50 dark:text-white/50 hover:text-[var(--ink)] dark:hover:text-white transition-colors">
				<Icon name="x" class="w-5 h-5" />
			</button>
		</div>
		<iframe id="notes-frame" class="flex-1 border-0 w-full" title="Sermon Notes"></iframe>
	</div>
	</div>{/* end notes container */}

</div>
)}

<style>
.info-card {
	background-color: #e6ecf4;
}
:global(.dark) .info-card {
	background-color: rgba(39, 63, 97, 0.45);
}
</style>

<script>
async function checkStream() {
	const dot    = document.getElementById('stream-dot');
	const label  = document.getElementById('stream-label');
	const widget = document.getElementById('report-widget');
	if (!dot || !label) return;

	const eventId = document.querySelector<HTMLElement>('[data-vimeo-event-id]')?.dataset.vimeoEventId;
	const url = eventId ? `/api/stream-status?vimeoEventId=${eventId}` : '/api/stream-status';

	try {
		const res  = await fetch(url);
		const data = await res.json() as { live: boolean };

		dot.classList.toggle('bg-[var(--red)]',    data.live);
		dot.classList.toggle('animate-pulse',       data.live);
		dot.classList.toggle('bg-[var(--ink)]/20', !data.live);
		dot.classList.toggle('dark:bg-white/20',   !data.live);
		label.textContent = data.live ? 'Live Audio Broadcast — on air now' : 'Live Audio Broadcast — off air';

		if (widget) {
			widget.classList.toggle('hidden', !data.live);
			if (data.live) resetReportWidget();
		}
	} catch {
		label.textContent = 'Live Audio Broadcast';
	}
}

function resetReportWidget() {
	const buttons = document.getElementById('report-buttons');
	const thanks  = document.getElementById('report-thanks');
	if (buttons && thanks && thanks.classList.contains('hidden') === false) {
		buttons.classList.remove('hidden');
		thanks.classList.add('hidden');
	}
}

function initReportButtons() {
	document.querySelectorAll<HTMLButtonElement>('.report-btn').forEach(btn => {
		btn.addEventListener('click', async () => {
			const label   = btn.dataset.report;
			const buttons = document.getElementById('report-buttons');
			const thanks  = document.getElementById('report-thanks');
			if (!label || !buttons || !thanks) return;

			buttons.classList.add('hidden');
			thanks.classList.remove('hidden');

			fetch('/api/stream-report', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ button: label }),
			}).catch(() => {/* fire-and-forget */});
		});
	});
}

function initSermonNotes() {
	const cardBtn = document.getElementById('notes-card-btn');
	if (!cardBtn) return;

	const overlay = document.getElementById('notes-overlay');
	const drawer  = document.getElementById('notes-drawer');
	const frame   = document.getElementById('notes-frame') as HTMLIFrameElement | null;
	const close   = document.getElementById('notes-close');
	if (!overlay || !drawer || !frame) return;

	function openDrawer() {
		if (!frame.src.includes('sermon-notes')) frame.src = new URLSearchParams(location.search).has('preview') ? '/sermon-notes?preview' : '/sermon-notes';
		overlay.classList.remove('hidden');
		drawer.classList.remove('translate-x-full');
	}
	function closeDrawer() {
		drawer.classList.add('translate-x-full');
		overlay.classList.add('hidden');
	}

	cardBtn.addEventListener('click', openDrawer);
	overlay.addEventListener('click', closeDrawer);
	close?.addEventListener('click', closeDrawer);
}

function init() {
	checkStream();
	initReportButtons();
	initSermonNotes();
	setInterval(checkStream, 60_000);
}

document.addEventListener('astro:page-load', init);
document.addEventListener('DOMContentLoaded', init);
</script>
