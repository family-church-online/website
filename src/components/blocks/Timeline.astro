---
import { tinaField } from '@tinacms/astro/tina-field';
import Section from '../ui/Section.astro';
import Icon from '../Icon.astro';

interface TimelineItem {
	time?: string | null;
	heading?: string | null;
	body?: string | null;
}
interface Props {
	data: {
		label?: string | null;
		heading?: string | null;
		intro?: string | null;
		items?: (TimelineItem | null)[] | null;
		locationName?: string | null;
		locationNote?: string | null;
		ctaText?: string | null;
		ctaEmail?: string | null;
	};
}

const { data } = Astro.props;
const items = (data.items ?? []).filter((i): i is TimelineItem => i !== null);
---

<Section>
	<div class="mx-auto max-w-[var(--content-width)]">

		{/* Header */}
		<div class="text-center mb-14">
			{data.label && (
				<p class="text-xs font-semibold uppercase tracking-widest text-[var(--olive)] mb-3"
					data-tina-field={tinaField(data, 'label')}>{data.label}</p>
			)}
			{data.heading && (
				<h1 class="text-4xl font-semibold lg:text-5xl text-balance mb-4"
					data-tina-field={tinaField(data, 'heading')}>{data.heading}</h1>
			)}
			{data.intro && (
				<p class="text-lg text-muted-foreground"
					data-tina-field={tinaField(data, 'intro')}>{data.intro}</p>
			)}
		</div>

		{/* Timeline */}
		<ol class="list-none p-0 m-0 mb-12" data-tina-field={tinaField(data, 'items')}>
			{items.map((item, i) => (
				<li class="grid gap-x-5 pb-12 last:pb-0" style="grid-template-columns:2rem 1fr" data-tina-field={tinaField(item)}>
					<div class="flex flex-col items-center pt-1.5">
						<span class="w-3 h-3 rounded-full shrink-0 bg-[var(--green)] shadow-[0_0_0_3px_rgba(146,196,35,0.18)]"></span>
						{i < items.length - 1 && (
							<span class="flex-1 w-px mt-1.5 min-h-8 bg-gradient-to-b from-[var(--green)]/30 to-[var(--green)]/5"></span>
						)}
					</div>
					<div>
						<p class="font-display text-2xl font-semibold text-foreground leading-none mb-1"
							data-tina-field={tinaField(item, 'time')}>{item.time}</p>
						<h2 class="text-base font-semibold text-foreground mb-2"
							data-tina-field={tinaField(item, 'heading')}>{item.heading}</h2>
						<p class="text-sm text-muted-foreground leading-relaxed"
							data-tina-field={tinaField(item, 'body')}>{item.body}</p>
					</div>
				</li>
			))}
		</ol>

		{/* Location */}
		{(data.locationName || data.locationNote) && (
			<div class="flex gap-4 items-start bg-card border border-border rounded-2xl px-6 py-5 mb-10">
				<Icon name="map-pin" class="w-[18px] h-[18px] text-[var(--olive)] shrink-0 mt-0.5" />
				<div>
					{data.locationName && (
						<p class="font-semibold text-sm text-foreground mb-1"
							data-tina-field={tinaField(data, 'locationName')}>{data.locationName}</p>
					)}
					{data.locationNote && (
						<p class="text-sm text-muted-foreground leading-relaxed"
							data-tina-field={tinaField(data, 'locationNote')}>{data.locationNote}</p>
					)}
				</div>
			</div>
		)}

		{/* CTA */}
		{data.ctaText && data.ctaEmail && (
			<div class="text-center">
				<p class="text-sm text-muted-foreground mb-2"
					data-tina-field={tinaField(data, 'ctaText')}>{data.ctaText}</p>
				<a href={`mailto:${data.ctaEmail}`}
					class="text-sm font-semibold text-foreground underline underline-offset-4 decoration-border hover:text-[var(--green)] hover:decoration-[var(--green)] transition-colors"
					data-tina-field={tinaField(data, 'ctaEmail')}>
					Send us a message →
				</a>
			</div>
		)}

	</div>
</Section>
