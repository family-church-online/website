# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Kids/lesson pipeline — downloaded raw data, not committed
scripts/lessons/

# Sermon pipeline — transient data (audio/, output/, session/ covered by sermon-pipeline/.gitignore)
sermon-pipeline/node_modules/

# Sermon pipeline cache and credentials
scripts/drive/comp-tax/
scripts/drive/enriched/
scripts/drive/sermon-blocks/
scripts/audio/
scripts/audio-encoded/
scripts/.google-credentials.json
scripts/.google-token.json

# Tooling / agent output
.playwright-mcp
.impeccable
.prototools

# TinaCMS generated output (also covered by tina/.gitignore)
tina/__generated__

# Sveltia CMS — generated at build time by scripts/generate-sveltia-config.mjs
# index.html and the auth setup notes in config.yml are tracked; these are not
public/edit/sveltia-cms.js
public/edit/config.yml

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/

# Output of 'npm pack'
*.tgz

# dotenv environment variable files
.env
.env.vars
.env.development.local
.env.test.local
.env.production.local
.env.local

# Yarn Integrity file
.yarn-integrity

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Astro
.astro

# Package manager lock files — pnpm-lock.yaml is intentionally committed
# (this project uses pnpm); ignore the others in case anyone runs a
# different package manager locally.
package-lock.json
yarn.lock
bun.lockb
deno.lock

# builds
.vercel
.netlify
.wrangler
dist
